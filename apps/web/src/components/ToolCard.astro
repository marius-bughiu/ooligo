---
/**
 * ToolCard — index list / catalog grid cell.
 *
 * Whole card is the link target so screen readers and pointer users
 * both get a single hit area. Composes ToolMonogram + ScorePill +
 * CapabilityChip + PricingLabel.
 *
 * Surface ladder lifts on hover (border accent, subtle bg shift) —
 * monochrome elevation per DESIGN.md.
 */

import type { CollectionEntry } from "astro:content";
import ToolMonogram from "./ToolMonogram.astro";
import ScorePill from "./ScorePill.astro";
import CapabilityChip from "./CapabilityChip.astro";
import PricingLabel from "./PricingLabel.astro";
import type { LocaleCode } from "~/lib/config";

interface Props {
  tool: CollectionEntry<"tools">["data"];
  locale: LocaleCode;
  class?: string;
}

const { tool, locale, class: className = "" } = Astro.props;
---

<a
  href={`/${locale}/tools/${tool.slug}/`}
  class:list={["tool-card", className]}
>
  <div class="tool-card-head">
    <ToolMonogram name={tool.name} size={36} />
    <div class="tool-card-id">
      <h3 class="tool-card-name">{tool.name}</h3>
      <div class="tool-card-category">{tool.category}</div>
    </div>
    {tool.ooligo_score != null && (
      <ScorePill score={tool.ooligo_score} size="sm" class="tool-card-score" />
    )}
  </div>

  <div class="tool-card-meta">
    <PricingLabel
      model={tool.pricing_model}
      startsAt={tool.pricing_starts_at}
    />
  </div>

  <div class="tool-card-chips">
    {tool.ai_native && <CapabilityChip label="AI-NATIVE" variant="accent" />}
    {tool.mcp_available && <CapabilityChip label="MCP" />}
    {tool.api_available && <CapabilityChip label="API" />}
  </div>
</a>

<style>
  .tool-card {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding: 1rem;
    background-color: var(--color-bg-surface-1);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    color: var(--color-text-primary);
    transition: border-color 150ms var(--ease-out-soft),
      background-color 150ms var(--ease-out-soft);
  }
  .tool-card:hover {
    border-color: var(--color-border);
    background-color: var(--color-bg-surface-2);
  }

  .tool-card-head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.75rem;
  }

  .tool-card-id {
    min-width: 0;
  }

  .tool-card-name {
    margin: 0;
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tool-card-category {
    margin-top: 0.125rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .tool-card-meta {
    margin-top: -0.125rem;
  }

  .tool-card-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
</style>
