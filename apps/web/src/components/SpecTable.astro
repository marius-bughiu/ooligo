---
/**
 * SpecTable — dense data display for tool detail spec cards.
 *
 * Replaces the raw <dl><dt><dd> rendering currently in tools/[slug].
 * Two-column key/value grid, mono-anchored, with optional `mono` flag
 * per row to flip the value to monospace (slugs, prices, scores).
 *
 * Rows accept `value` as a string OR a slot via the `slotName` field:
 * the page template passes simple text rows in `rows` and complex
 * rows (capability chips, pricing labels, links) via named slots.
 */

interface Row {
  label: string;
  value?: string | number | null;
  /** When set, replaces value with the named slot's content. */
  slotName?: string;
  /** Renders value in mono (numerics, slugs, scores). */
  mono?: boolean;
}

interface Props {
  rows: Row[];
  class?: string;
}

const { rows, class: className = "" } = Astro.props;
---

<dl class:list={["spec-table", className]}>
  {rows.map((row) => (
    <div class="spec-row">
      <dt class="spec-label">{row.label}</dt>
      <dd class:list={["spec-value", row.mono && "spec-value-mono"]}>
        {row.slotName ? (
          <slot name={row.slotName} />
        ) : (
          row.value ?? <span class="spec-empty">—</span>
        )}
      </dd>
    </div>
  ))}
</dl>

<style>
  .spec-table {
    display: grid;
    grid-template-columns: minmax(7rem, auto) 1fr;
    column-gap: 1.25rem;
    margin: 0;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    background-color: var(--color-bg-surface-1);
    overflow: hidden;
  }

  .spec-row {
    display: contents;
  }

  .spec-label,
  .spec-value {
    padding: 0.625rem 1rem;
    border-top: 1px solid var(--color-border-subtle);
    font-size: var(--text-sm);
    line-height: 1.4;
    margin: 0;
  }
  .spec-row:first-child .spec-label,
  .spec-row:first-child .spec-value {
    border-top: 0;
  }

  .spec-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-tertiary);
    background-color: var(--color-bg-surface-2);
    align-self: stretch;
    display: flex;
    align-items: center;
  }

  .spec-value {
    color: var(--color-text-primary);
    word-break: break-word;
  }

  .spec-value-mono {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .spec-empty {
    color: var(--color-text-tertiary);
  }
</style>
