{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ooligo/verticals.schema.json",
  "title": "Verticals configuration",
  "type": "object",
  "required": ["verticals"],
  "properties": {
    "verticals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "slug", "names", "tagline", "icp", "starter_tools", "newsletter_id", "launch_phase", "is_flagship"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "names": {
            "type": "object",
            "patternProperties": {
              "^[a-z]{2}(-[A-Z]{2})?$": { "type": "string" }
            },
            "additionalProperties": false
          },
          "tagline": {
            "type": "object",
            "patternProperties": {
              "^[a-z]{2}(-[A-Z]{2})?$": { "type": "string" }
            },
            "additionalProperties": false
          },
          "icp": { "type": "string" },
          "starter_tools": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
            "minItems": 5
          },
          "newsletter_id": { "type": "string" },
          "launch_phase": { "type": "integer", "minimum": 1 },
          "is_flagship": { "type": "boolean" }
        }
      }
    }
  }
}
