---
import type { LocaleCode } from "~/lib/config";
import { getEnrichmentExample } from "~/lib/enrichmentExampleData";
import { enrichmentExampleCopy } from "~/lib/enrichmentExampleCopy";

interface Props {
  locale: LocaleCode;
  compact?: boolean;
}

const { locale, compact = false } = Astro.props;
const t = enrichmentExampleCopy(locale);
const { cases } = getEnrichmentExample();
const [ready, missing, invalid] = cases;
---

<figure class:list={["example", compact && "example-compact"]}>
  <figcaption>
    <span class="example-label">{t.sample}</span>
    <strong class="example-title">{t.title}</strong>
  </figcaption>

  <div class="example-input">
    <div class="example-stage">{t.input}</div>
    <code class="example-domain">{ready.result.domain}</code>
    <dl class="example-facts">
      <div><dt>{t.industry}</dt><dd>{ready.extraction.industry}</dd></div>
      <div><dt>{t.headcount}</dt><dd>{ready.extraction.headcount}</dd></div>
      <div><dt>{t.region}</dt><dd>{ready.extraction.region}</dd></div>
    </dl>
  </div>

  <div class="example-output">
    <div>
      <div class="example-stage">{t.output}</div>
      <strong class="example-status">{t.ready}</strong>
    </div>
    <div class="example-score">
      <span>{t.score}</span>
      <strong>{ready.result.icp_fit_score}<small>/10</small></strong>
    </div>
  </div>

  {!compact && (
    <>
      <p class="example-rubric">{t.rubric}</p>
      <details class="example-source">
        <summary>{t.evidence}</summary>
        <blockquote lang="en">{ready.sourceText}</blockquote>
      </details>
      <details class="example-failures">
        <summary>{t.failures}</summary>
        <div class="example-failure">
          <code>{missing.result.domain}</code>
          <div class="example-failure-result"><strong>{t.review}</strong><span>{t.noScore}</span></div>
          <p>{t.missingReason}</p>
        </div>
        <div class="example-failure">
          <code>{invalid.result.domain}</code>
          <div class="example-failure-result"><strong>{t.invalid}</strong><span>{t.noScore}</span></div>
          <p>{t.invalidReason}</p>
        </div>
      </details>
    </>
  )}
  <p class="example-boundary">{t.boundary}</p>
</figure>

<style>
  .example {
    margin: 0;
    min-width: 0;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-surface-1);
  }
  figcaption { display: grid; gap: 0.625rem; margin-bottom: 1.25rem; }
  .example-label, .example-stage {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }
  .example-label { color: var(--color-accent); }
  .example-title { font-size: var(--text-lg); line-height: 1.3; letter-spacing: -0.02em; }
  .example-input { padding: 1rem; background: var(--color-bg-surface-2); border-radius: var(--radius-xs); }
  .example-domain { display: block; margin: 0.5rem 0 1rem; overflow-wrap: anywhere; }
  .example-facts { display: grid; grid-template-columns: 1.5fr 1fr 1fr; gap: 0.75rem; margin: 0; }
  .example-facts dt { color: var(--color-text-secondary); font-size: var(--text-xs); margin-bottom: 0.25rem; overflow-wrap: anywhere; }
  .example-facts dd { margin: 0; font-family: var(--font-mono); font-size: var(--text-sm); }
  .example-output { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--color-border-subtle); }
  .example-status { display: block; margin-top: 0.5rem; font-size: var(--text-base); }
  .example-score { display: grid; gap: 0.25rem; text-align: right; }
  .example-score > span { max-width: 11rem; font-size: var(--text-xs); color: var(--color-text-secondary); }
  .example-score > strong { font-family: var(--font-mono); font-size: var(--text-2xl); color: var(--color-accent); }
  .example-score small { font-size: var(--text-sm); color: var(--color-text-secondary); }
  .example-rubric, .example-boundary, .example-failure p { font-size: var(--text-sm); line-height: 1.5; color: var(--color-text-secondary); }
  .example-boundary { margin: 1rem 0 0; }
  .example-source, .example-failures { margin-top: 1rem; font-size: var(--text-sm); }
  summary { cursor: pointer; line-height: 1.5; }
  summary:hover { color: var(--color-accent); }
  blockquote { margin: 0.75rem 0 0; padding-left: 0.75rem; border-left: 2px solid var(--color-border); color: var(--color-text-secondary); line-height: 1.5; }
  .example-failure { margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid var(--color-border-subtle); }
  .example-failure > code { color: var(--color-text-secondary); overflow-wrap: anywhere; }
  .example-failure-result { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem; margin-top: 0.5rem; }
  .example-failure-result span { color: var(--color-text-secondary); }
  .example-failure p { margin: 0.5rem 0 0; }
  @media (max-width: 380px) {
    .example { padding: 1rem; }
    .example-facts { grid-template-columns: 1fr 1fr; }
    .example-facts > div:first-child { grid-column: 1 / -1; }
  }
</style>
