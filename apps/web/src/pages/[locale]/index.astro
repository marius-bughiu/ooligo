---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Container from "~/components/Container.astro";
import Section from "~/components/Section.astro";
import ToolCard from "~/components/ToolCard.astro";
import EnrichmentExample from "~/components/EnrichmentExample.astro";
import { ENRICHMENT_WORKFLOW } from "~/lib/enrichmentExampleData";
import ComparisonStrip from "~/components/ComparisonStrip.astro";
import WorkflowCard from "~/components/WorkflowCard.astro";
import StackBadgeRow from "~/components/StackBadgeRow.astro";
import AeoAnswerBlock from "~/components/AeoAnswerBlock.astro";
import {
  locales,
  verticals,
  localizedName,
  localizedTagline,
  localeText,
  REPO_URL,
  type LocaleCode,
} from "~/lib/config";

export function getStaticPaths() {
  return locales.map((l) => ({ params: { locale: l.code } }));
}

const { locale } = Astro.params as { locale: LocaleCode };

// Locale-aware copy. Strings unique to home live here; chrome strings
// live in lib/strings.ts.
const headlines = {
  en: {
    title: "ooligo — AI tools and workflows you can inspect",
    h1_lede: "Find a workflow.",
    h1_rest: " See what it actually does.",
    sub: "Compare AI tools for ops. Start with a lead-enrichment example, inspect its evidence, and run the free sample on your own machine.",
    cta_primary: "Run the free example",
    cta_secondary: "Browse the catalog",
    counters_heading: "Live catalog",
    counter_tools: "tools",
    counter_comparisons: "comparisons",
    counter_workflows: "workflows",
    counter_learn: "learn",
    counter_verticals: "verticals",
    verticals_heading: "Browse by vertical",
    starter_stack: "Starter stack",
    featured_tools: "Tools for your enrichment setup",
    recent_comparisons: "Recent comparisons",
    recent_workflows: "Recently updated workflows",
    see_all: "See all",
    aeo_questions: ["What is ooligo?", "Where can I try a RevOps workflow?", "Do I need a paid account for the example?"],
    aeo_answer: "ooligo helps operations teams compare AI tools and inspect downloadable workflows. The featured lead-enrichment example runs locally with Python and synthetic data, without a paid account. This example documents its setup and test limits; live integrations require separate configuration.",
    bip_heading: "Public roadmap. Public metrics. Public repo.",
    bip_blurb:
      "Built in the open on GitHub. Roadmap, source, and traffic numbers all live in the repo.",
    bip_cta: "Check it out on GitHub",
    empty_comparisons: "No comparisons indexed yet for this locale.",
    hero_eyebrow: "Start here · RevOps",
    hero_note: "20 synthetic records · Python · no account needed",
    featured_tools_note: "Source-reviewed profiles to help you decide what you need after the offline example.",
  },
  es: {
    title: "ooligo — herramientas y workflows de IA que puedes revisar",
    h1_lede: "Encuentra un workflow.",
    h1_rest: " Comprueba qué hace.",
    sub: "Compara herramientas de IA para operaciones. Empieza con un ejemplo de enriquecimiento de leads, revisa sus evidencias y ejecútalo gratis en tu computadora.",
    cta_primary: "Ejecutar el ejemplo gratuito",
    cta_secondary: "Explorar el catálogo",
    counters_heading: "Catálogo en vivo",
    counter_tools: "herramientas",
    counter_comparisons: "comparaciones",
    counter_workflows: "workflows",
    counter_learn: "aprender",
    counter_verticals: "verticales",
    verticals_heading: "Explorar por vertical",
    starter_stack: "Stack inicial",
    featured_tools: "Herramientas para tu proceso de enriquecimiento",
    recent_comparisons: "Comparaciones recientes",
    recent_workflows: "Workflows actualizados recientemente",
    see_all: "Ver todo",
    aeo_questions: ["¿Qué es ooligo?", "¿Dónde puedo probar un workflow de RevOps?", "¿Necesito una cuenta de pago para el ejemplo?"],
    aeo_answer: "ooligo ayuda a equipos de operaciones a comparar herramientas de IA y revisar workflows descargables. El ejemplo destacado de enriquecimiento de leads funciona localmente con Python y datos sintéticos, sin cuenta de pago. Este ejemplo explica su configuración y los límites de sus pruebas; las integraciones reales necesitan configuración adicional.",
    bip_heading: "Hoja de ruta pública. Métricas públicas. Repositorio público.",
    bip_blurb:
      "Construido en abierto en GitHub. La hoja de ruta, el código fuente y las métricas de tráfico viven en el repo.",
    bip_cta: "Échale un vistazo en GitHub",
    empty_comparisons: "Aún no hay comparaciones indexadas para este idioma.",
    hero_eyebrow: "Empieza aquí · RevOps",
    hero_note: "20 registros sintéticos · Python · sin cuenta",
    featured_tools_note: "Perfiles basados en fuentes para decidir qué necesitas después del ejemplo sin conexión.",
  },
  "pt-BR": {
    title: "ooligo — ferramentas e workflows de IA que você pode avaliar",
    h1_lede: "Encontre um workflow.",
    h1_rest: " Veja o que ele faz.",
    sub: "Compare ferramentas de IA para operações. Comece com um exemplo de enriquecimento de leads, confira suas evidências e execute a amostra grátis no seu computador.",
    cta_primary: "Executar o exemplo gratuito",
    cta_secondary: "Explorar o catálogo",
    counters_heading: "Catálogo ao vivo",
    counter_tools: "ferramentas",
    counter_comparisons: "comparações",
    counter_workflows: "workflows",
    counter_learn: "aprender",
    counter_verticals: "verticais",
    verticals_heading: "Explorar por vertical",
    starter_stack: "Stack inicial",
    featured_tools: "Ferramentas para seu processo de enriquecimento",
    recent_comparisons: "Comparações recentes",
    recent_workflows: "Workflows atualizados recentemente",
    see_all: "Ver tudo",
    aeo_questions: ["O que é o ooligo?", "Onde posso testar um workflow de RevOps?", "Preciso de uma conta paga para o exemplo?"],
    aeo_answer: "O ooligo ajuda equipes de operações a comparar ferramentas de IA e examinar workflows para download. O exemplo em destaque de enriquecimento de leads roda localmente com Python e dados sintéticos, sem conta paga. Este exemplo descreve sua configuração e os limites dos testes; integrações reais exigem configuração separada.",
    bip_heading: "Roadmap público. Métricas públicas. Repositório público.",
    bip_blurb:
      "Construído em público no GitHub. Roadmap, código-fonte e números de tráfego vivem no repo.",
    bip_cta: "Dá uma olhada no GitHub",
    empty_comparisons: "Ainda não há comparações indexadas para este idioma.",
    hero_eyebrow: "Comece aqui · RevOps",
    hero_note: "20 registros sintéticos · Python · sem conta",
    featured_tools_note: "Perfis baseados em fontes para decidir o que você precisa depois do exemplo offline.",
  },
  ja: {
    title: "ooligo — 内容を確かめられる AI ツールとワークフロー",
    h1_lede: "ワークフローを探す。",
    h1_rest: " 実際の動作を確かめる。",
    sub: "業務向け AI ツールを比較できます。リード情報補完の例から始め、証拠を確認し、無料サンプルを自分のコンピューターで実行してください。",
    cta_primary: "無料サンプルを実行",
    cta_secondary: "カタログを見る",
    counters_heading: "ライブカタログ",
    counter_tools: "ツール",
    counter_comparisons: "比較",
    counter_workflows: "ワークフロー",
    counter_learn: "学ぶ",
    counter_verticals: "業種",
    verticals_heading: "業種別に見る",
    starter_stack: "スターター構成",
    featured_tools: "情報補完に使うツール",
    recent_comparisons: "最近の比較",
    recent_workflows: "最近更新されたワークフロー",
    see_all: "すべて見る",
    aeo_questions: ["ooligo とは何ですか？", "RevOps ワークフローはどこで試せますか？", "サンプルに有料アカウントは必要ですか？"],
    aeo_answer: "ooligo は業務チーム向けに AI ツールの比較とダウンロード可能なワークフローを提供します。注目のリード情報補完サンプルは Python と合成データでローカル実行でき、有料アカウントは不要です。このサンプルには設定とテストの限界を記載しています。実環境の連携には別の設定が必要です。",
    bip_heading: "公開ロードマップ。公開メトリクス。公開リポジトリ。",
    bip_blurb:
      "GitHub上でオープンに開発中。ロードマップ、ソースコード、トラフィック数値はすべてリポジトリにあります。",
    bip_cta: "GitHubで見る",
    empty_comparisons: "この言語ではまだ比較がインデックスされていません。",
    hero_eyebrow: "ここから開始 · RevOps",
    hero_note: "合成レコード20件 · Python · アカウント不要",
    featured_tools_note: "オフラインサンプルの次に必要なツールを、出典に基づく紹介で検討できます。",
  },
  fr: {
    title: "ooligo — outils et workflows IA à examiner",
    h1_lede: "Trouvez un workflow.",
    h1_rest: " Voyez ce qu’il fait.",
    sub: "Comparez les outils IA pour les opérations. Commencez par un exemple d’enrichissement de leads, examinez ses preuves et exécutez-le gratuitement sur votre ordinateur.",
    cta_primary: "Exécuter l’exemple gratuit",
    cta_secondary: "Parcourir le catalogue",
    counters_heading: "Catalogue en direct",
    counter_tools: "outils",
    counter_comparisons: "comparaisons",
    counter_workflows: "workflows",
    counter_learn: "apprendre",
    counter_verticals: "secteurs",
    verticals_heading: "Parcourir par secteur",
    starter_stack: "Stack de départ",
    featured_tools: "Outils pour votre enrichissement de données",
    recent_comparisons: "Comparaisons récentes",
    recent_workflows: "Workflows récemment mis à jour",
    see_all: "Tout voir",
    aeo_questions: ["Qu’est-ce que ooligo ?", "Où essayer un workflow RevOps ?", "Faut-il un compte payant pour l’exemple ?"],
    aeo_answer: "ooligo aide les équipes opérations à comparer les outils IA et à examiner des workflows téléchargeables. L’exemple d’enrichissement de leads fonctionne localement avec Python et des données synthétiques, sans compte payant. Cet exemple décrit sa configuration et les limites des tests ; les intégrations réelles demandent une configuration distincte.",
    bip_heading: "Roadmap publique. Métriques publiques. Repo public.",
    bip_blurb:
      "Construit en public sur GitHub. La roadmap, le code source et les chiffres de trafic vivent tous dans le repo.",
    bip_cta: "À voir sur GitHub",
    empty_comparisons: "Aucune comparaison indexée pour cette langue pour le moment.",
    hero_eyebrow: "Commencez ici · RevOps",
    hero_note: "20 données synthétiques · Python · sans compte",
    featured_tools_note: "Des profils fondés sur les sources pour choisir après l’exemple hors ligne.",
  },
  de: {
    title: "ooligo — KI-Tools und Workflows zum Prüfen",
    h1_lede: "Finden Sie einen Workflow.",
    h1_rest: " Prüfen Sie, was er tut.",
    sub: "Vergleichen Sie KI-Tools für Operations. Starten Sie mit einem Beispiel zur Lead-Anreicherung, prüfen Sie die Belege und führen Sie es kostenlos lokal aus.",
    cta_primary: "Kostenloses Beispiel ausführen",
    cta_secondary: "Katalog durchsuchen",
    counters_heading: "Live-Katalog",
    counter_tools: "Tools",
    counter_comparisons: "Vergleiche",
    counter_workflows: "Workflows",
    counter_learn: "Lernen",
    counter_verticals: "Branchen",
    verticals_heading: "Nach Branche durchsuchen",
    starter_stack: "Starter-Stack",
    featured_tools: "Tools für Ihre Datenanreicherung",
    recent_comparisons: "Aktuelle Vergleiche",
    recent_workflows: "Kürzlich aktualisierte Workflows",
    see_all: "Alle ansehen",
    aeo_questions: ["Was ist ooligo?", "Wo kann ich einen RevOps-Workflow ausprobieren?", "Brauche ich ein kostenpflichtiges Konto für das Beispiel?"],
    aeo_answer: "ooligo hilft Operations-Teams, KI-Tools zu vergleichen und herunterladbare Workflows zu prüfen. Das vorgestellte Beispiel zur Lead-Anreicherung läuft lokal mit Python und synthetischen Daten, ohne kostenpflichtiges Konto. Dieses Beispiel erklärt Einrichtung und Testgrenzen; Live-Integrationen müssen separat eingerichtet werden.",
    bip_heading: "Öffentliche Roadmap. Öffentliche Metriken. Öffentliches Repo.",
    bip_blurb:
      "Offen auf GitHub gebaut. Roadmap, Quellcode und Traffic-Zahlen liegen alle im Repo.",
    bip_cta: "Auf GitHub ansehen",
    empty_comparisons: "Für diese Sprache sind noch keine Vergleiche indexiert.",
    hero_eyebrow: "Hier starten · RevOps",
    hero_note: "20 synthetische Datensätze · Python · kein Konto nötig",
    featured_tools_note: "Quellenbasierte Profile für die Auswahl nach dem Offline-Beispiel.",
  },
} as const;

const copy = localeText(headlines, locale);

// ----- Live data -----
const allTools = await getCollection("tools");
const allComparisons = await getCollection("comparisons");
const allWorkflows = await getCollection("workflows");
const allLearn = await getCollection("learn");

const localeTools = allTools.filter((t) => t.data.locale === locale);
const localeComparisons = allComparisons.filter(
  (c) => c.data.locale === locale
);
const localeWorkflows = allWorkflows.filter((w) => w.data.locale === locale);
const localeLearn = allLearn.filter((l) => l.data.locale === locale);

// Featured rails
// Curated around the featured example, rather than an unverified numeric ranking.
const featuredTools = ["clay", "claude", "apollo"].flatMap((slug) => {
  const tool = localeTools.find((entry) => entry.data.slug === slug);
  return tool ? [tool] : [];
});

const recentComparisons = [...localeComparisons]
  .sort((a, b) => b.data.last_updated.localeCompare(a.data.last_updated))
  .slice(0, 4);

const recentWorkflows = [...localeWorkflows]
  .sort((a, b) => b.data.last_updated.localeCompare(a.data.last_updated) || a.data.slug.localeCompare(b.data.slug))
  .slice(0, 6);

// Tool name lookup for ComparisonStrip + WorkflowCard cards
const toolNamesLookup: Record<string, string> = Object.fromEntries(
  localeTools.map((t) => [t.data.slug, t.data.name])
);
---

<BaseLayout
  title={copy.title}
  description={copy.sub}
  locale={locale}
  pagePath="/"
>
  <main id="main">
    <!-- ============ HERO ============ -->
    <Section density="lg">
      <Container>
        <div class="hero">
          <div class="hero-copy">
            <p class="hero-eyebrow">{copy.hero_eyebrow}</p>
            <h1 class="hero-headline">
              <span class="hero-headline-accent">{copy.h1_lede}</span>{copy.h1_rest}
            </h1>
            <p class="hero-sub">{copy.sub}</p>
            <div class="hero-ctas">
              <a
                href={`/${locale}/workflows/${ENRICHMENT_WORKFLOW}/#run-example`}
                class="cta cta-primary"
                data-ooligo-event="workflow_cta_click"
                data-workflow-slug={ENRICHMENT_WORKFLOW}
                data-placement="home_hero"
              >
                {copy.cta_primary} <span aria-hidden="true">→</span>
              </a>
              <a href={`/${locale}/tools/`} class="cta cta-secondary">
                {copy.cta_secondary}
              </a>
            </div>
            <p class="hero-note">{copy.hero_note}</p>
          </div>
          <EnrichmentExample locale={locale} compact />
        </div>
      </Container>
    </Section>

    <!-- ============ LIVE COUNTERS ============ -->
    <Section density="sm" surface="surface-1" divided>
      <Container>
        <div class="counters">
          <div class="counters-label">{copy.counters_heading}</div>
          <div class="counters-row">
            <div class="counter">
              <div class="counter-num">{localeTools.length}</div>
              <div class="counter-label">{copy.counter_tools}</div>
            </div>
            <div class="counter">
              <div class="counter-num">{localeComparisons.length}</div>
              <div class="counter-label">{copy.counter_comparisons}</div>
            </div>
            <div class="counter">
              <div class="counter-num">{localeWorkflows.length}</div>
              <div class="counter-label">{copy.counter_workflows}</div>
            </div>
            <div class="counter">
              <div class="counter-num">{localeLearn.length}</div>
              <div class="counter-label">{copy.counter_learn}</div>
            </div>
            <div class="counter">
              <div class="counter-num">{verticals.length}</div>
              <div class="counter-label">{copy.counter_verticals}</div>
            </div>
          </div>
        </div>
      </Container>
    </Section>

    <!-- ============ VERTICALS ============ -->
    <Section density="md" divided>
      <Container>
        <header class="rail-header">
          <h2 class="rail-title">{copy.verticals_heading}</h2>
        </header>
        <div class="verticals-grid">
          {verticals.map((v) => {
            const stackTools = v.starter_tools.slice(0, 6).map((slug) => ({
              slug,
              name: toolNamesLookup[slug] ?? slug,
            }));
            return (
              <article
                class:list={["v-card", v.is_flagship && "v-card-flagship"]}
              >
                <a href={`/${locale}/r/${v.slug}/`} class="v-card-primary">
                  <div class="v-card-head">
                    <span class="v-card-mark" aria-hidden="true"></span>
                    <h3 class="v-card-name">{localizedName(v, locale)}</h3>
                    {v.is_flagship && (
                      <span class="v-card-flag">FLAGSHIP</span>
                    )}
                  </div>
                  <p class="v-card-tagline">{localizedTagline(v, locale)}</p>
                </a>
                <div class="v-card-stack">
                  <span class="v-card-stack-label">{copy.starter_stack}</span>
                  <StackBadgeRow tools={stackTools} locale={locale} size="sm" />
                </div>
              </article>
            );
          })}
        </div>
      </Container>
    </Section>

    <!-- ============ FEATURED TOOLS ============ -->
    {featuredTools.length > 0 && (
      <Section density="md" divided>
        <Container>
          <header class="rail-header">
            <div>
              <h2 class="rail-title">{copy.featured_tools}</h2>
              <p class="rail-note">{copy.featured_tools_note}</p>
            </div>
            <a href={`/${locale}/tools/`} class="rail-see-all">
              {copy.see_all} <span aria-hidden="true">→</span>
            </a>
          </header>
          <div class="card-grid card-grid-3">
            {featuredTools.map((t) => (
              <ToolCard tool={t.data} locale={locale} />
            ))}
          </div>
        </Container>
      </Section>
    )}

    <!-- ============ RECENT COMPARISONS ============ -->
    {recentComparisons.length > 0 && (
      <Section density="md" divided>
        <Container>
          <header class="rail-header">
            <h2 class="rail-title">{copy.recent_comparisons}</h2>
            <a href={`/${locale}/vs/`} class="rail-see-all">
              {copy.see_all} <span aria-hidden="true">→</span>
            </a>
          </header>
          <div class="card-grid card-grid-2">
            {recentComparisons.map((c) => (
              <ComparisonStrip
                comparison={c.data}
                toolNames={toolNamesLookup}
                locale={locale}
              />
            ))}
          </div>
        </Container>
      </Section>
    )}

    <!-- ============ RECENT WORKFLOWS ============ -->
    {recentWorkflows.length > 0 && (
      <Section density="md" divided>
        <Container>
          <header class="rail-header">
            <h2 class="rail-title">{copy.recent_workflows}</h2>
            <a href={`/${locale}/workflows/`} class="rail-see-all">
              {copy.see_all} <span aria-hidden="true">→</span>
            </a>
          </header>
          <div class="card-grid card-grid-3">
            {recentWorkflows.map((w) => (
              <WorkflowCard
                workflow={w.data}
                toolNames={toolNamesLookup}
                locale={locale}
              />
            ))}
          </div>
        </Container>
      </Section>
    )}

    <!-- ============ AEO BLOCK ============ -->
    <Section density="md" divided>
      <Container width="prose">
        <AeoAnswerBlock
          questions={[...copy.aeo_questions]}
          locale={locale}
        />
        <p class="aeo-answer-body">{copy.aeo_answer}</p>
      </Container>
    </Section>

    <!-- ============ BUILD-IN-PUBLIC STRIP ============ -->
    <Section density="md" divided surface="surface-1">
      <Container>
        <div class="bip">
          <div class="bip-text">
            <h2 class="bip-heading">{copy.bip_heading}</h2>
            <p class="bip-blurb">{copy.bip_blurb}</p>
          </div>
          <a href={REPO_URL} class="bip-cta" rel="noopener">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.42 7.42 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
            </svg>
            {copy.bip_cta} <span aria-hidden="true">→</span>
          </a>
        </div>
      </Container>
    </Section>
  </main>
</BaseLayout>

<style>
  /* ============ HERO ============ */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: 2rem;
  }
  .hero-copy { min-width: 0; }
  .hero-eyebrow { margin: 0 0 1rem; font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-text-secondary); }
  .hero-note { margin: 1rem 0 0; font-size: var(--text-sm); line-height: 1.5; color: var(--color-text-secondary); }
  @media (min-width: 1024px) {
    .hero { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 3rem; }
  }

  .hero-headline {
    margin: 0;
    font-size: clamp(2rem, 3.5vw + 0.5rem, var(--text-3xl));
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--color-text-primary);
  }

  .hero-headline-accent {
    color: var(--color-accent);
  }

  .hero-sub {
    margin: 1.5rem 0 0;
    max-width: 42rem;
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  .hero-ctas {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.75rem 1.125rem;
    border-radius: var(--radius-xs);
    font-size: var(--text-sm);
    font-weight: 600;
