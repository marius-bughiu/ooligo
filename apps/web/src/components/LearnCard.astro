---
/**
 * LearnCard — /learn index list cell.
 *
 * Surfaces target_questions[0] (the canonical AEO query the page
 * answers) directly on the card so readers and crawlers can match
 * intent at glance. Small type chip in the corner labels the
 * entity flavor: definition / faq / how-to / framework / glossary.
 */

import type { CollectionEntry } from "astro:content";
import type { LocaleCode } from "~/lib/config";

type LearnData = CollectionEntry<"learn">["data"];

interface Props {
  entry: LearnData;
  locale: LocaleCode;
  class?: string;
}

const { entry, locale, class: className = "" } = Astro.props;
const firstQuestion = entry.target_questions[0];
---

<a
  href={`/${locale}/learn/${entry.slug}/`}
  class:list={["learn-card", className]}
>
  <div class="learn-card-head">
    <span class="learn-card-type">{entry.type}</span>
  </div>

  <h3 class="learn-card-title">{entry.title}</h3>

  {firstQuestion && (
    <p class="learn-card-question">{firstQuestion}</p>
  )}
</a>

<style>
  .learn-card {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1rem;
    background-color: var(--color-bg-surface-1);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    color: var(--color-text-primary);
    transition: border-color 150ms var(--ease-out-soft),
      background-color 150ms var(--ease-out-soft);
  }
  .learn-card:hover {
    border-color: var(--color-border);
    background-color: var(--color-bg-surface-2);
  }

  .learn-card-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .learn-card-type {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-tertiary);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xs);
    padding: 0.2rem 0.4rem;
    line-height: 1;
  }

  .learn-card-title {
    margin: 0;
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--color-text-primary);
  }

  .learn-card-question {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.45;
    /* Truncate long questions to keep cards uniform-ish */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
