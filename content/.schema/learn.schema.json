{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ooligo/learn.schema.json",
  "title": "Learn entry frontmatter",
  "type": "object",
  "required": ["slug", "canonical_slug", "locale", "type", "title", "target_questions", "last_updated", "ai_generated"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "canonical_slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "locale": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
    "type": {
      "type": "string",
      "enum": ["definition", "faq", "how-to", "framework", "glossary"]
    },
    "title": { "type": "string", "minLength": 1 },
    "verticals": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "related_tools": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "related_workflows": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "target_questions": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "last_updated": { "type": "string", "format": "date" },
    "ai_generated": { "type": "boolean" },
    "ai_translated": { "type": "boolean" },
    "translated_from": { "type": "string" },
    "translated_at": { "type": "string", "format": "date-time" },
    "translation_model": { "type": "string" }
  }
}
