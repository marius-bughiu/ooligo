---
/**
 * Header — global chrome.
 *
 * Sticky 64px bar with subtle blur backdrop. Contains:
 *   - Wordmark (links home)
 *   - Primary nav (Tools / Comparisons / Workflows / Learn)
 *   - Verticals dropdown
 *   - Locale switcher (only links to locales where the page actually exists)
 *   - GitHub icon link
 *   - Subscribe CTA
 *   - Mobile sheet (hamburger ≥ all of the above stacked)
 *
 * Zero-JS: dropdowns and the mobile sheet use native <details> elements.
 */

import Wordmark from "./Wordmark.astro";
import {
  locales,
  verticals,
  localizedName,
  type LocaleCode,
} from "~/lib/config";
import { chromeStrings } from "~/lib/strings";

interface Props {
  locale: LocaleCode;
  /** Path WITHOUT locale prefix, with leading slash. e.g. "/tools/clay" */
  pagePath: string;
  /** Locales where this page actually exists. Defaults to all. */
  availableLocales?: LocaleCode[];
}

const { locale, pagePath, availableLocales } = Astro.props;
const t = chromeStrings(locale);

function withTrailingSlash(p: string): string {
  if (p === "" || p === "/") return "/";
  return p.endsWith("/") ? p : `${p}/`;
}
const slashed = withTrailingSlash(pagePath);

const navItems = [
  { href: `/${locale}/tools/`, label: t.nav.tools },
  { href: `/${locale}/vs/`, label: t.nav.comparisons },
  { href: `/${locale}/workflows/`, label: t.nav.workflows },
  { href: `/${locale}/learn/`, label: t.nav.learn },
];

const localesShown = availableLocales
  ? locales.filter((l) => availableLocales.includes(l.code))
  : locales;

const REPO_URL = "https://github.com/marius-bughiu/ooligo";
---

<header class="header">
  <div class="header-inner">
    <Wordmark href={`/${locale}/`} size={24} label={t.meta.home} />

    <nav class="nav-desktop" aria-label="Primary">
      {navItems.map((item) => (
        <a href={item.href} class="nav-link">{item.label}</a>
      ))}

      <details class="dropdown">
        <summary class="nav-link nav-link-with-caret">
          {t.nav.verticals}
          <svg aria-hidden="true" width="10" height="10" viewBox="0 0 10 10">
            <path d="M2 4l3 3 3-3" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </summary>
        <div class="dropdown-panel" role="menu">
          {verticals.map((v) => (
            <a
              href={`/${locale}/r/${v.slug}/`}
              class="dropdown-item"
              role="menuitem"
            >
              <span class="dropdown-item-mark" aria-hidden="true"></span>
              <span class="dropdown-item-name">{localizedName(v, locale)}</span>
            </a>
          ))}
        </div>
      </details>
    </nav>

    <div class="header-right">
      <details class="dropdown locale-switcher">
        <summary class="icon-btn" aria-label={t.cta.locale}>
          <span class="locale-current">{locale.toUpperCase()}</span>
          <svg aria-hidden="true" width="10" height="10" viewBox="0 0 10 10">
            <path d="M2 4l3 3 3-3" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </summary>
        <div class="dropdown-panel dropdown-panel-right" role="menu">
          {localesShown.map((l) => (
            <a
              href={`/${l.code}${slashed}`}
              class:list={["dropdown-item", l.code === locale && "is-current"]}
              role="menuitem"
              hreflang={l.hreflang}
              lang={l.hreflang}
            >
              <span class="dropdown-item-name">{l.native_name}</span>
              <span class="dropdown-item-code">{l.code}</span>
            </a>
          ))}
        </div>
      </details>

      <a
        href={REPO_URL}
        class="icon-btn"
        rel="noopener"
        aria-label={t.cta.github}
      >
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
          <path
            fill="currentColor"
            d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.42 7.42 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          />
        </svg>
      </a>

      <a href={`/${locale}/#newsletter`} class="cta-subscribe">
        {t.cta.subscribe}
      </a>
    </div>

    <details class="nav-mobile" aria-label="Primary">
      <summary class="icon-btn" aria-label={t.cta.open_menu}>
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
          <path d="M2 5h14M2 9h14M2 13h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </summary>
      <div class="mobile-sheet">
        <div class="mobile-sheet-section">
          {navItems.map((item) => (
            <a href={item.href} class="mobile-link">{item.label}</a>
          ))}
        </div>

        <div class="mobile-sheet-section">
          <div class="mobile-section-label">{t.nav.verticals}</div>
          {verticals.map((v) => (
            <a href={`/${locale}/r/${v.slug}/`} class="mobile-link">
              {localizedName(v, locale)}
            </a>
          ))}
        </div>

        <div class="mobile-sheet-section">
          <div class="mobile-section-label">{t.cta.locale}</div>
          {localesShown.map((l) => (
            <a
              href={`/${l.code}${slashed}`}
              class:list={["mobile-link", l.code === locale && "is-current"]}
              hreflang={l.hreflang}
              lang={l.hreflang}
            >
              {l.native_name}
            </a>
          ))}
        </div>

        <div class="mobile-sheet-section">
          <a href={REPO_URL} class="mobile-link" rel="noopener">{t.cta.github}</a>
          <a href={`/${locale}/#newsletter`} class="cta-subscribe cta-mobile">
            {t.cta.subscribe}
          </a>
        </div>
      </div>
    </details>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: color-mix(in oklab, var(--color-bg-canvas) 80%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 64px;
    max-width: var(--container-app);
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  @media (min-width: 1024px) {
    .header-inner {
      padding-inline: 2rem;
    }
  }

  /* ----- Desktop nav ----- */
  .nav-desktop {
    display: none;
    align-items: center;
    gap: 0.25rem;
    flex: 1;
    margin-left: 1.5rem;
  }
  @media (min-width: 768px) {
    .nav-desktop {
      display: flex;
    }
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-xs);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1;
    transition: color 150ms var(--ease-out-soft),
      background-color 150ms var(--ease-out-soft);
  }
  .nav-link:hover {
    color: var(--color-text-primary);
    background-color: var(--color-bg-surface-2);
  }

  .nav-link-with-caret {
    cursor: pointer;
  }

  /* ----- Right cluster ----- */
  .header-right {
    display: none;
    align-items: center;
    gap: 0.5rem;
  }
  @media (min-width: 768px) {
    .header-right {
      display: flex;
    }
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    height: 32px;
    padding: 0 0.625rem;
    border: 1px solid transparent;
    border-radius: var(--radius-xs);
    background: transparent;
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    cursor: pointer;
    transition: color 150ms var(--ease-out-soft),
      border-color 150ms var(--ease-out-soft),
      background-color 150ms var(--ease-out-soft);
  }
  .icon-btn:hover {
    color: var(--color-text-primary);
    background-color: var(--color-bg-surface-2);
    border-color: var(--color-border-subtle);
  }

  .locale-current {
    letter-spacing: 0.04em;
  }

  .cta-subscribe {
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding: 0 0.875rem;
    border-radius: var(--radius-xs);
    background-color: var(--color-accent);
    color: var(--color-bg-canvas);
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1;
    transition: background-color 150ms var(--ease-out-soft);
  }
  .cta-subscribe:hover {
    background-color: var(--color-accent-hover);
  }

  /* ----- Dropdowns (zero-JS via <details>) ----- */
  .dropdown {
    position: relative;
  }
  .dropdown > summary {
    list-style: none;
    user-select: none;
  }
  .dropdown > summary::-webkit-details-marker {
    display: none;
  }
  .dropdown[open] > summary svg {
    transform: rotate(180deg);
  }
  .dropdown > summary svg {
    transition: transform 150ms var(--ease-out-soft);
  }

  .dropdown-panel {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    min-width: 220px;
    padding: 0.375rem;
    background-color: var(--color-bg-surface-1);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    gap: 1px;
    box-shadow: 0 8px 24px -4px rgba(0, 0, 0, 0.5);
  }
  .dropdown-panel-right {
    left: auto;
    right: 0;
  }

  .dropdown-item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 0.625rem;
    border-radius: var(--radius-xs);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    transition: color 150ms var(--ease-out-soft),
      background-color 150ms var(--ease-out-soft);
  }
  .dropdown-item:hover {
    color: var(--color-text-primary);
    background-color: var(--color-bg-surface-2);
  }
  .dropdown-item.is-current {
    color: var(--color-accent);
  }
  .dropdown-item-name {
    flex: 1;
  }
  .dropdown-item-code {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .dropdown-item-mark {
    width: 8px;
    height: 8px;
    border-radius: 1px;
    background: var(--color-border);
    flex-shrink: 0;
  }

  /* ----- Mobile sheet ----- */
  .nav-mobile {
    display: block;
  }
  @media (min-width: 768px) {
    .nav-mobile {
      display: none;
    }
  }
  .nav-mobile > summary {
    list-style: none;
  }
  .nav-mobile > summary::-webkit-details-marker {
    display: none;
  }

  .mobile-sheet {
    position: fixed;
    inset: 64px 0 0 0;
    background-color: var(--color-bg-canvas);
    border-top: 1px solid var(--color-border-subtle);
    padding: 1.5rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .mobile-sheet-section {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mobile-section-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-tertiary);
    margin-bottom: 0.5rem;
  }

  .mobile-link {
    display: block;
    padding: 0.625rem 0;
    border-bottom: 1px solid var(--color-border-subtle);
    color: var(--color-text-primary);
    font-size: var(--text-base);
    font-weight: 500;
  }
  .mobile-link.is-current {
    color: var(--color-accent);
  }

  .cta-mobile {
    margin-top: 1rem;
    height: 44px;
    justify-content: center;
    width: 100%;
  }
</style>
