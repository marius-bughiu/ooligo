---
/**
 * PricingLabel — `$149/mo · usage-based`, mono.
 *
 * Renders the pricing_model + pricing_starts_at fields off a tool entry.
 * Free tier is collapsed to the model word; missing starts_at hides the
 * amount cleanly. Currency hard-coded to USD per ARCHITECTURE.md.
 */

import type { CollectionEntry } from "astro:content";

type ToolData = CollectionEntry<"tools">["data"];

interface Props {
  model: ToolData["pricing_model"];
  startsAt?: number | null;
  class?: string;
}

const { model, startsAt, class: className = "" } = Astro.props;
const showAmount = model !== "free" && startsAt != null;
---

<span class:list={["pricing-label", className]}>
  {showAmount && (
    <>
      <span class="pricing-amount">${startsAt}/mo</span>
      <span class="pricing-sep" aria-hidden="true">·</span>
    </>
  )}
  <span class="pricing-model">{model}</span>
</span>

<style>
  .pricing-label {
    display: inline-flex;
    align-items: baseline;
    gap: 0.375rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    line-height: 1;
  }

  .pricing-amount {
    color: var(--color-text-primary);
    font-weight: 500;
  }

  .pricing-sep {
    color: var(--color-border);
  }

  .pricing-model {
    color: var(--color-text-tertiary);
  }
</style>
