---
import { getCollection, render } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import JsonLd from "~/components/JsonLd.astro";
import { type LocaleCode } from "~/lib/config";

export async function getStaticPaths() {
  const learn = await getCollection("learn");
  return learn.map((entry) => ({
    params: { locale: entry.data.locale, slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { locale } = Astro.params as { locale: LocaleCode };
const { Content } = await render(entry);
const data = entry.data;

const jsonLdByType: Record<typeof data.type, Record<string, unknown>> = {
  definition: {
    "@context": "https://schema.org",
    "@type": "DefinedTerm",
    name: data.title,
    description: data.target_questions[0],
  },
  faq: {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: data.target_questions.map((q) => ({
      "@type": "Question",
      name: q,
    })),
  },
  "how-to": {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: data.title,
  },
  framework: {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: data.title,
  },
  glossary: {
    "@context": "https://schema.org",
    "@type": "DefinedTermSet",
    name: data.title,
  },
};

const jsonLd = jsonLdByType[data.type];
---
<BaseLayout
  title={`${data.title} — ooligo`}
  description={data.target_questions[0] ?? data.title}
  locale={locale}
  pagePath={`/learn/${data.slug}`}
>
  <JsonLd slot="head" data={jsonLd} />
  <main>
    <nav><a href={`/${locale}/learn`}>← Learn</a></nav>

    <header>
      <h1>{data.title}</h1>
      <p><em>{data.type}</em> · last updated {data.last_updated}</p>
    </header>

    <article>
      <Content />
    </article>
  </main>
</BaseLayout>
