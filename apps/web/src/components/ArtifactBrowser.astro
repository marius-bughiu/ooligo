---
/**
 * ArtifactBrowser — sidebar + main-pane file viewer for workflow artifacts.
 *
 * Wraps the workflow's overview body (MDX, passed via the default slot)
 * and renders three navigation surfaces:
 *
 *   1. Right-rail sidebar (sticky on desktop): Overview link + per-file
 *      links + "Download all (.zip)" button.
 *   2. A "Files in this artifact" block at the bottom of the overview,
 *      listing each file as a clickable card + the same Download-all
 *      button. Mirrors the sidebar so users who scroll the body don't
 *      need to look right.
 *   3. A prominent "← Back to overview" link at the top of every file
 *      panel — the sidebar's Overview link is too easy to miss.
 *
 * Clicking any file entry swaps the main pane to that file's viewer
 * (filename, lang, copy, download, mono content).
 *
 * Matches the zero-syntax-highlighting aesthetic of the rest of the
 * site: mono on surface-2, no client-side highlighter.
 *
 * If `files` is empty, the component renders the slot directly — no
 * sidebar, no layout shift. Lets callers wrap unconditionally.
 *
 * Pane switching uses a small inline script. The page still works
 * without JS: the overview pane is always visible by default;
 * file downloads still work via direct /artifacts/<slug>/<path> URLs.
 */
import type { CollectionEntry } from "astro:content";
import { localeText, type LocaleCode } from "~/lib/config";

type ArtifactType = CollectionEntry<"workflows">["data"]["artifact_type"];

export interface ArtifactFile {
  /** Display name, e.g. "SKILL.md" or "references/icp-rubric-template.md". */
  name: string;
  /** Path relative to the artifact directory. */
  path: string;
  /** Raw file contents. */
  content: string;
  /** Display lang badge — "MARKDOWN", "JSON", "TYPESCRIPT", etc. */
  lang: string;
  sizeBytes: number;
}

interface Props {
  files: ArtifactFile[];
  /** URL prefix for individual file downloads, e.g. "/artifacts/account-research-claude-skill". */
  downloadBase: string;
  /** URL of the bundle .zip, e.g. "/artifacts/account-research-claude-skill.zip". */
  zipUrl?: string;
  /** Stable id for scoping the script + pane targets to this instance. */
  id: string;
  locale: LocaleCode;
  /** Workflow's artifact_type — drives the n8n preview surface. */
  artifactType?: ArtifactType;
  /** GitHub edit-URL base for files in this artifact (no trailing slash). */
  editBase: string;
}

const { files, downloadBase, zipUrl, id, locale, artifactType, editBase } =
  Astro.props;

function isN8nFlowFile(f: ArtifactFile): boolean {
  return artifactType === "n8n-flow" && f.path.toLowerCase().endsWith(".json");
}
const hasN8nFlow = files.some(isN8nFlowFile);

const labels = {
  en: {
    sidebar_label: "Artifact files",
    overview: "Overview",
    files_heading: "Files",
    files_in_bundle: "Files in this artifact",
    copy: "Copy",
    copied: "Copied",
    download: "Download",
    download_all: "Download all (.zip)",
    back_to_overview: "Back to overview",
    preview: "Preview",
    source: "Source",
    edit: "Edit",
  },
  es: {
    sidebar_label: "Archivos del artefacto",
    overview: "Resumen",
    files_heading: "Archivos",
    files_in_bundle: "Archivos de este artefacto",
    copy: "Copiar",
    copied: "Copiado",
    download: "Descargar",
    download_all: "Descargar todo (.zip)",
    back_to_overview: "Volver al resumen",
    preview: "Vista previa",
    source: "Fuente",
    edit: "Editar",
  },
  "pt-BR": {
    sidebar_label: "Arquivos do artefato",
    overview: "Visão geral",
    files_heading: "Arquivos",
    files_in_bundle: "Arquivos deste artefato",
    copy: "Copiar",
    copied: "Copiado",
    download: "Baixar",
    download_all: "Baixar tudo (.zip)",
    back_to_overview: "Voltar para a visão geral",
    preview: "Visualizar",
    source: "Código",
    edit: "Editar",
  },
} as const;
const t = localeText(labels, locale);

function formatBytes(n: number): string {
  if (n < 1024) return `${n} B`;
  if (n < 1024 * 1024) return `${(n / 1024).toFixed(1)} KB`;
  return `${(n / 1024 / 1024).toFixed(2)} MB`;
}
---

{files.length === 0 ? (
  <slot />
) : (
  <div class="ab-layout" data-ab-id={id}>
    <main class="ab-main">
      <section class="ab-pane ab-pane-overview" data-pane="overview" data-active="true">
        <slot />

        <!-- ============ FILES BLOCK at bottom of overview ============ -->
        <section class="ab-overview-files">
          <h2 class="ab-overview-heading">{t.files_in_bundle}</h2>
          <ul class="ab-file-card-list">
            {files.map((f, i) => (
              <li class="ab-file-card-row">
                <button type="button" class="ab-file-card-view" data-target-file={i}>
                  <span class="ab-file-card-name">{f.name}</span>
                  <span class="ab-file-card-meta">
                    <span class="ab-file-card-lang">{f.lang}</span>
                    <span class="ab-file-card-size">{formatBytes(f.sizeBytes)}</span>
                  </span>
                </button>
                <span class="ab-file-card-actions">
                  <button
                    type="button"
                    class="ab-file-card-icon ab-copy"
                    data-ab-copy={i}
                    data-icon=""
                    title={t.copy}
                    aria-label={`${t.copy} ${f.name}`}
                  >
                    <svg class="ab-icon ab-icon-default" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
                      <rect x="3.5" y="3.5" width="7" height="8" rx="1" stroke="currentColor" stroke-width="1.2" fill="none"/>
                      <path d="M5.5 3.5V2.5a1 1 0 011-1h4a1 1 0 011 1v6a1 1 0 01-1 1h-1" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round"/>
                    </svg>
                    <svg class="ab-icon ab-icon-success" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
                      <path d="M3 7l3 3 5-6" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                  <a
                    class="ab-file-card-icon"
                    href={`${downloadBase}/${f.path}`}
                    download={f.name}
                    title={t.download}
                    aria-label={`${t.download} ${f.name}`}
                  >
                    <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
                      <path d="M7 1.5v8m0 0L4 6.5m3 3l3-3M2.5 12.5h9" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                  <a
                    class="ab-file-card-icon"
                    href={`${editBase}/${f.path}`}
                    target="_blank"
                    rel="noopener"
                    title={t.edit}
                    aria-label={`${t.edit} ${f.name}`}
                  >
                    <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
                      <path d="M9.5 2.5l2 2-7 7H2.5v-2l7-7z" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M8.5 3.5l2 2" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round"/>
                    </svg>
                  </a>
                </span>
              </li>
            ))}
          </ul>
          {zipUrl && (
            <a class="ab-download-all" href={zipUrl} download>
              <svg class="ab-download-icon" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
                <path d="M7 1v8m0 0L4 6m3 3l3-3M2 12h10" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              {t.download_all}
            </a>
          )}
        </section>
      </section>

      {files.map((f, i) => {
        const isN8n = isN8nFlowFile(f);
        return (
          <section
            class="ab-pane ab-pane-file"
            data-pane-file={i}
            data-active="false"
            aria-hidden="true"
            data-view-mode={isN8n ? "preview" : undefined}
          >
            <button type="button" class="ab-back" data-target="overview">
              <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
                <path d="M9 2L4 7l5 5" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              {t.back_to_overview}
            </button>
            <div class="ab-toolbar">
              <span class="ab-filename">{f.name}</span>
              <span class="ab-lang">{f.lang}</span>
              <span class="ab-spacer"></span>
              {isN8n && (
                <span class="ab-view-toggle" role="group" aria-label="View mode">
                  <button
                    type="button"
                    class="ab-action ab-view-toggle-btn"
                    data-view-toggle="preview"
                    aria-pressed="true"
                  >
                    {t.preview}
                  </button>
                  <button
                    type="button"
                    class="ab-action ab-view-toggle-btn"
                    data-view-toggle="source"
                    aria-pressed="false"
                  >
                    {t.source}
                  </button>
                </span>
              )}
              <button
                type="button"
                class="ab-action ab-copy"
                data-ab-copy={i}
                data-label-default={t.copy}
                data-label-copied={t.copied}
              >
                {t.copy}
              </button>
              <a
                class="ab-action ab-download"
                href={`${downloadBase}/${f.path}`}
                download={f.name}
              >
                {t.download}
              </a>
              <a
                class="ab-action ab-edit"
                href={`${editBase}/${f.path}`}
                target="_blank"
                rel="noopener"
              >
                {t.edit}
              </a>
            </div>
            {isN8n && (
              <div class="ab-preview-n8n" data-view-target="preview">
                <n8n-demo
                  workflow={f.content}
                  theme="dark"
                  clicktointeract="false"
                  collapseformobile="true"
                />
              </div>
            )}
            <pre
              class="ab-body"
              data-ab-content={i}
              data-view-target={isN8n ? "source" : undefined}
            >{f.content}</pre>
          </section>
        );
      })}
    </main>

    <aside class="ab-sidebar" aria-label={t.sidebar_label}>
      <button
        type="button"
        class="ab-side-link ab-side-overview"
        data-target="overview"
        aria-current="true"
      >
        {t.overview}
      </button>

      <div class="ab-side-section">
        <div class="ab-side-section-heading">{t.files_heading}</div>
        <ul class="ab-side-list">
          {files.map((f, i) => (
            <li>
              <button
                type="button"
                class="ab-side-link"
                data-target-file={i}
                aria-current="false"
              >
                <span class="ab-side-name">{f.name}</span>
                <span class="ab-side-size">{formatBytes(f.sizeBytes)}</span>
              </button>
            </li>
          ))}
        </ul>
        {zipUrl && (
          <a class="ab-side-download-all" href={zipUrl} download>
            <svg width="12" height="12" viewBox="0 0 14 14" aria-hidden="true">
              <path d="M7 1v8m0 0L4 6m3 3l3-3M2 12h10" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            {t.download_all}
          </a>
        )}
      </div>
    </aside>
  </div>
)}

{hasN8nFlow && (
  <script>
    import "@n8n_io/n8n-demo-component";
  </script>
)}

<script is:inline define:vars={{ id }}>
  (() => {
    const root = document.querySelector(`.ab-layout[data-ab-id="${id}"]`);
    if (!root) return;

    const panes = root.querySelectorAll(".ab-pane");
    const sidebarLinks = root.querySelectorAll(".ab-side-link");

    function targetOf(el) {
      const t = el.getAttribute("data-target");
      if (t === "overview") return "overview";
      const f = el.getAttribute("data-target-file");
      return f === null ? null : `file:${f}`;
    }

    function activate(target) {
      panes.forEach((p) => {
        const isOverview = p.getAttribute("data-pane") === "overview";
        const fileIdx = p.getAttribute("data-pane-file");
        const isActive =
          (target === "overview" && isOverview) ||
          (target && target.startsWith("file:") && fileIdx === target.slice(5));
        p.setAttribute("data-active", isActive ? "true" : "false");
        p.setAttribute("aria-hidden", isActive ? "false" : "true");
      });
      sidebarLinks.forEach((l) => {
        l.setAttribute("aria-current", targetOf(l) === target ? "true" : "false");
      });
      // When switching into a file pane, scroll the back-link into view so
      // the user lands on "← Back to overview" rather than mid-content.
      // Going back to overview leaves the scroll position alone.
      if (target && target.startsWith("file:")) {
        const idx = target.slice(5);
        const pane = root.querySelector(`.ab-pane-file[data-pane-file="${idx}"]`);
        const back = pane && pane.querySelector(".ab-back");
        if (back) back.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    }

    // Bind every nav target: sidebar links, file cards in overview, back link.
    root.querySelectorAll("[data-target], [data-target-file]").forEach((el) => {
      el.addEventListener("click", (e) => {
        const t = targetOf(el);
        if (!t) return;
        e.preventDefault();
        activate(t);
      });
    });

    root.querySelectorAll("[data-view-toggle]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const pane = btn.closest(".ab-pane-file");
        if (!pane) return;
        const mode = btn.getAttribute("data-view-toggle");
        if (!mode) return;
        pane.setAttribute("data-view-mode", mode);
        pane.querySelectorAll("[data-view-toggle]").forEach((b) => {
          b.setAttribute(
            "aria-pressed",
            b.getAttribute("data-view-toggle") === mode ? "true" : "false",
          );
        });
      });
    });

    root.querySelectorAll(".ab-copy").forEach((btn) => {
      btn.addEventListener("click", async (e) => {
        e.stopPropagation();
        const idx = btn.getAttribute("data-ab-copy");
        const pre = root.querySelector(`pre[data-ab-content="${idx}"]`);
        if (!pre || !navigator.clipboard) return;
        try {
          await navigator.clipboard.writeText(pre.textContent || "");
          if (btn.hasAttribute("data-icon")) {
            // Icon-only button: toggle data-copied for CSS-driven check swap
            btn.setAttribute("data-copied", "true");
            setTimeout(() => btn.removeAttribute("data-copied"), 1500);
          } else {
            const copied = btn.getAttribute("data-label-copied") || "Copied";
            const original = btn.getAttribute("data-label-default") || "Copy";
            btn.textContent = copied;
            setTimeout(() => {
              btn.textContent = original;
            }, 1500);
          }
        } catch (_) {
          /* clipboard blocked — silent */
        }
      });
    });
  })();
</script>

<style>
  /* ============ LAYOUT ============ */
  .ab-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin: 0;
  }
  @media (min-width: 1024px) {
    .ab-layout {
      grid-template-columns: minmax(0, 1fr) 260px;
      gap: 2.5rem;
      align-items: start;
    }
  }

  .ab-main {
    min-width: 0;
  }

  /* ============ PANES ============ */
  .ab-pane[data-active="false"] {
    display: none;
  }

  /* ============ FILE PANEL ============ */
  .ab-pane-file {
    /* Wrapper for back-link + framed file viewer */
  }

  .ab-back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.875rem;
    padding: 0.4rem 0.7rem 0.4rem 0.55rem;
    background-color: transparent;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xs);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    cursor: pointer;
    line-height: 1;
    /* Leave room for the sticky page header when scrollIntoView aligns the back button to the top */
    scroll-margin-top: 5rem;
    transition: border-color 120ms var(--ease-out-soft),
      background-color 120ms var(--ease-out-soft);
  }
  .ab-back:hover {
    border-color: var(--color-accent);
    background-color: color-mix(in oklab, var(--color-accent) 8%, transparent);
  }

  .ab-pane-file > .ab-toolbar,
  .ab-pane-file > .ab-body,
  .ab-pane-file > .ab-preview-n8n {
    /* Pull the toolbar+body together with a left accent stripe */
  }
  .ab-pane-file > .ab-toolbar {
    border: 1px solid var(--color-border-subtle);
    border-left: 3px solid var(--color-accent);
    border-bottom: 0;
    border-top-left-radius: var(--radius-sm);
    border-top-right-radius: var(--radius-sm);
  }
  .ab-pane-file > .ab-body,
  .ab-pane-file > .ab-preview-n8n {
    border: 1px solid var(--color-border-subtle);
    border-top: 1px solid var(--color-border-subtle);
    border-left: 3px solid var(--color-accent);
    border-bottom-left-radius: var(--radius-sm);
    border-bottom-right-radius: var(--radius-sm);
  }

  /* View-mode swap: hide the inactive target. Non-n8n panes have no
     [data-view-mode] attribute, so the <pre> stays visible by default. */
  .ab-pane-file[data-view-mode="preview"] [data-view-target="source"] {
    display: none;
  }
  .ab-pane-file[data-view-mode="source"] [data-view-target="preview"] {
    display: none;
  }

  .ab-view-toggle {
    display: inline-flex;
  }
  .ab-view-toggle .ab-view-toggle-btn {
    border-radius: 0;
  }
  .ab-view-toggle .ab-view-toggle-btn:first-child {
    border-top-left-radius: var(--radius-xs);
    border-bottom-left-radius: var(--radius-xs);
  }
  .ab-view-toggle .ab-view-toggle-btn:last-child {
    border-top-right-radius: var(--radius-xs);
    border-bottom-right-radius: var(--radius-xs);
    margin-left: -1px;
  }
  .ab-view-toggle-btn[aria-pressed="true"] {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background-color: color-mix(in oklab, var(--color-accent) 10%, transparent);
    z-index: 1;
  }

  /* n8n preview frame — host the iframe rendered by <n8n-demo>.
     The component's iframe is loaded from n8n's preview service and
     handles its own theme via the `theme` attribute. We constrain
     the height and let the iframe fill the box. */
  .ab-preview-n8n {
    background-color: var(--color-bg-surface-2);
    overflow: hidden;
  }
  .ab-preview-n8n n8n-demo {
    display: block;
    width: 100%;
    --n8n-workflow-min-height: 30rem;
    --n8n-frame-background-color: var(--color-bg-surface-2);
    --n8n-overlay-background: color-mix(in oklab, var(--color-bg-surface-1) 80%, transparent);
  }

  .ab-toolbar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.875rem;
    background-color: var(--color-bg-surface-1);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .ab-filename {
    color: var(--color-text-primary);
    font-weight: 500;
  }
  .ab-lang {
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xs);
    padding: 0.15rem 0.4rem;
    line-height: 1;
  }
  .ab-spacer {
    flex: 1;
  }

  .ab-action {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.6rem;
    background-color: transparent;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xs);
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    cursor: pointer;
    text-decoration: none;
    line-height: 1;
    transition: border-color 120ms var(--ease-out-soft),
      color 120ms var(--ease-out-soft);
  }
  .ab-action:hover {
    color: var(--color-text-primary);
    border-color: var(--color-accent);
  }

  .ab-body {
    margin: 0;
    padding: 1rem 1.125rem;
    background-color: var(--color-bg-surface-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-primary);
    overflow-x: auto;
    white-space: pre;
    tab-size: 2;
    max-height: 40rem;
    overflow-y: auto;
  }

  /* ============ OVERVIEW FILES BLOCK (bottom) ============ */
  .ab-overview-files {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border-subtle);
  }
  .ab-overview-heading {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-tertiary);
    font-weight: 600;
  }
  .ab-file-card-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.25rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
  }
  .ab-file-card-row {
    display: flex;
    align-items: stretch;
    background-color: var(--color-bg-surface-1);
    border: 1px solid var(--color-border-subtle);
    border-left: 3px solid transparent;
    border-radius: var(--radius-sm);
    overflow: hidden;
    transition: border-color 120ms var(--ease-out-soft),
      background-color 120ms var(--ease-out-soft);
  }
  .ab-file-card-row:hover {
    background-color: var(--color-bg-surface-2);
    border-color: var(--color-border);
    border-left-color: var(--color-accent);
  }

  .ab-file-card-view {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 1rem;
    background: transparent;
    border: 0;
    color: var(--color-text-primary);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    cursor: pointer;
    text-align: left;
  }
  .ab-file-card-name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ab-file-card-meta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  .ab-file-card-lang {
    color: var(--color-text-tertiary);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xs);
    padding: 0.15rem 0.4rem;
    line-height: 1;
  }
  .ab-file-card-size {
