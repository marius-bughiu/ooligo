---
/**
 * ooligo wordmark — glyph + lowercase typographic mark.
 *
 * Used in the header (D1), footer, OG images, and any "back to home"
 * affordance. The glyph is a single SVG referenced from /public so
 * browsers can cache it across pages.
 *
 * Single brand asset — never recolor, never restack vertically without
 * a derivative variant living next to this one.
 */

interface Props {
  /** Visual size of the glyph in px. Wordmark scales proportionally. */
  size?: number;
  /** Render only the glyph (for tight contexts like avatars). */
  glyphOnly?: boolean;
  /** Optional href; if omitted renders as a plain span. */
  href?: string;
  /** Accessible label, defaults to "ooligo, home". */
  label?: string;
}

const {
  size = 24,
  glyphOnly = false,
  href,
  label = "ooligo, home",
} = Astro.props;

const Tag = href ? "a" : "span";
const wordmarkSize = `${(size / 24) * 1.125}rem`; // 18px when size=24
---

<Tag
  {...(href ? { href, "aria-label": label } : { "aria-label": label, role: "img" })}
  class="wordmark"
  data-glyph-only={glyphOnly}
>
  <img
    src="/glyph.svg"
    alt=""
    width={size}
    height={size}
    class="wordmark-glyph"
    decoding="async"
  />
  {!glyphOnly && (
    <span class="wordmark-text" style={`font-size: ${wordmarkSize}`}>
      ooligo
    </span>
  )}
</Tag>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-primary);
    font-family: var(--font-mono);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1;
    transition: color 150ms var(--ease-out-soft);
  }

  a.wordmark:hover {
    color: var(--color-accent);
  }

  .wordmark-glyph {
    display: block;
    border-radius: var(--radius-xs);
    flex-shrink: 0;
  }

  .wordmark-text {
    /* Slight optical baseline correction so glyph and text align */
    transform: translateY(0.5px);
  }
</style>
