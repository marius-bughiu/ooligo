---
import BaseLayout from "~/layouts/BaseLayout.astro";
import {
  locales,
  verticals,
  localizedName,
  localizedTagline,
  type LocaleCode,
} from "~/lib/config";

export function getStaticPaths() {
  const paths: Array<{ params: { locale: string; vertical: string } }> = [];
  for (const l of locales) {
    for (const v of verticals) {
      paths.push({ params: { locale: l.code, vertical: v.slug } });
    }
  }
  return paths;
}

const { locale, vertical: verticalSlug } = Astro.params as {
  locale: LocaleCode;
  vertical: string;
};

const vertical = verticals.find((v) => v.slug === verticalSlug);
if (!vertical) {
  return Astro.redirect(`/${locale}/`, 302);
}

const name = localizedName(vertical, locale);
const tagline = localizedTagline(vertical, locale);
---
<BaseLayout
  title={`${name} — ooligo`}
  description={tagline}
  locale={locale}
  pagePath={`/r/${vertical.slug}`}
>
  <main id="main">
    <header>
      <h1>{name}</h1>
      <p>{tagline}</p>
    </header>

    <section>
      <h2>Starter stack</h2>
      <ul>
        {vertical.starter_tools.map((slug) => (
          <li>
            <a href={`/${locale}/tools/${slug}`}>{slug}</a>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2>Coming soon</h2>
      <ul>
        <li><a href={`/${locale}/tools`}>Tool directory</a></li>
        <li><a href={`/${locale}/vs`}>Comparisons</a></li>
        <li><a href={`/${locale}/workflows`}>Workflow library</a></li>
        <li><a href={`/${locale}/learn`}>Learn / glossary</a></li>
      </ul>
    </section>
  </main>
</BaseLayout>
