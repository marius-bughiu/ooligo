---
import type { LocaleCode } from "~/lib/config";
import { ENRICHMENT_WORKFLOW, ENRICHMENT_COMMAND } from "~/lib/enrichmentExampleData";
import { enrichmentExampleCopy } from "~/lib/enrichmentExampleCopy";
import EnrichmentExample from "./EnrichmentExample.astro";
import SampleFeedback from "./SampleFeedback.astro";

interface Props { locale: LocaleCode; }
const { locale } = Astro.props;
const t = enrichmentExampleCopy(locale);
---

<section id="run-example" class="quickstart" aria-labelledby="quickstart-title">
  <header>
    <h2 id="quickstart-title">{t.quickTitle}</h2>
    <p class="quickstart-intro">{t.quickIntro}</p>
  </header>
  <div class="quickstart-grid">
    <div class="quickstart-instructions">
      <ol class="quickstart-steps">
        <li>
          <p>{t.downloadStep}</p>
          <a
            class="quickstart-download"
            href={`/artifacts/${ENRICHMENT_WORKFLOW}.zip`}
            download
            data-ooligo-event="artifact_download_click"
            data-workflow-slug={ENRICHMENT_WORKFLOW}
            data-artifact-type="claude-skill"
            data-download-kind="bundle"
            data-placement="sample"
          >{t.download} <span aria-hidden="true">↓</span></a>
        </li>
        <li>
          <p>{t.runStep}</p>
          <div class="quickstart-command">
            <code>{ENRICHMENT_COMMAND}</code>
            <button
              type="button"
              data-ooligo-copy={ENRICHMENT_COMMAND}
              data-workflow-slug={ENRICHMENT_WORKFLOW}
              data-placement="sample"
              data-copy-success={t.copySuccess}
              data-copy-error={t.copyError}
            >{t.copyCommand}</button>
            <span class="copy-status" data-copy-status role="status" aria-live="polite"></span>
          </div>
        </li>
        <li>
          <p>{t.expectStep}</p>
          <p class="quickstart-expect">{t.expect}</p>
        </li>
      </ol>
      <a class="quickstart-readme" href={`/artifacts/${ENRICHMENT_WORKFLOW}/README.md`}>{t.setupGuide} →</a>
      <SampleFeedback locale={locale} workflowSlug={ENRICHMENT_WORKFLOW} />
    </div>
    <EnrichmentExample locale={locale} />
  </div>
  <aside class="quickstart-live">
    <div>
      <h3>{t.liveTitle}</h3>
      <p>{t.live}</p>
    </div>
    <a href="#workflow-guide">{t.guide} <span aria-hidden="true">→</span></a>
  </aside>
</section>

<style>
  .quickstart { margin: 1.5rem 0 2rem; scroll-margin-top: 6rem; }
  .quickstart h2 { margin: 0; font-size: var(--text-2xl); line-height: 1.2; }
  .quickstart-intro { color: var(--color-text-secondary); line-height: 1.5; margin: 0.75rem 0 1.5rem; max-width: 52rem; }
  .quickstart-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem; align-items: start; }
  .quickstart-instructions { min-width: 0; }
  .quickstart-steps { margin: 0; padding-left: 1.5rem; list-style: decimal; }
  .quickstart-steps li { padding-left: 0.25rem; margin-bottom: 1.5rem; }
  .quickstart-steps li::marker { color: var(--color-accent); font-family: var(--font-mono); }
  .quickstart-steps p { margin: 0 0 0.75rem; line-height: 1.5; }
  .quickstart-download { display: inline-flex; align-items: center; justify-content: center; gap: 0.75rem; min-height: 44px; padding: 0.75rem 1rem; background: var(--color-accent); color: var(--color-bg-canvas); font-size: var(--text-sm); font-weight: 600; border-radius: var(--radius-xs); }
  .quickstart-download:hover { background: var(--color-accent-hover); }
  .quickstart-command { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; }
  .quickstart-command code { display: block; width: 100%; overflow-wrap: anywhere; padding: 0.875rem; border: 1px solid var(--color-border-subtle); border-radius: var(--radius-xs); background: var(--color-bg-surface-2); font-size: var(--text-sm); }
  .quickstart-command button { min-height: 44px; padding: 0.5rem 0.75rem; border: 1px solid var(--color-border); border-radius: var(--radius-xs); background: transparent; color: var(--color-text-primary); font-size: var(--text-sm); cursor: pointer; }
  .quickstart-command button:hover { border-color: var(--color-accent); }
  .copy-status, .quickstart-expect { font-size: var(--text-sm); color: var(--color-text-secondary); }
  .copy-status:empty { display: none; }
  .quickstart-readme, .quickstart-live a { color: var(--color-accent); font-size: var(--text-sm); line-height: 1.5; text-decoration: underline; text-underline-offset: 0.2em; }
  .quickstart-live { display: flex; flex-direction: column; align-items: start; gap: 0.75rem; margin-top: 1.5rem; padding: 1rem 1.25rem; border: 1px solid var(--color-border-subtle); border-radius: var(--radius-sm); }
  .quickstart-live h3 { margin: 0; font-size: var(--text-base); line-height: 1.4; }
  .quickstart-live p { max-width: 56rem; margin: 0.5rem 0 0; font-size: var(--text-sm); line-height: 1.5; color: var(--color-text-secondary); }
  @media (min-width: 900px) {
    .quickstart-grid { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 2rem; }
    .quickstart-live { flex-direction: row; align-items: center; justify-content: space-between; gap: 2rem; }
    .quickstart-live a { flex-shrink: 0; max-width: 15rem; }
  }
</style>
