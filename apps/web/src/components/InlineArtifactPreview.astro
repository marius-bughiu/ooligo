---
/**
 * InlineArtifactPreview — code/markdown preview block for workflows.
 *
 * Used on workflow detail pages to show a snippet of the artifact
 * (Claude Skill body, Cursor rule, prompt pack header, etc.) before
 * the user downloads. The preview language comes from the workflow
 * frontmatter's `preview_lang` field.
 *
 * No syntax highlighting library — keeps the page zero-JS. The code
 * block is styled like a developer editor (mono, dim line height,
 * surface-2 ground) which is enough signal at preview density.
 *
 * Caller passes the snippet as the default slot.
 */

interface Props {
  /** Display in the preview header — e.g. "lead-enrichment.md". */
  filename?: string;
  /** Display in the preview header — e.g. "markdown", "yaml", "json". */
  lang?: string;
  /** Optional caption shown beneath the preview (e.g. "first 40 lines"). */
  caption?: string;
  class?: string;
}

const {
  filename,
  lang,
  caption,
  class: className = "",
} = Astro.props;
---

<figure class:list={["artifact", className]}>
  {(filename || lang) && (
    <header class="artifact-head">
      {filename && (
        <span class="artifact-filename">{filename}</span>
      )}
      {lang && (
        <span class="artifact-lang">{lang}</span>
      )}
    </header>
  )}

  <pre class="artifact-body"><slot /></pre>

  {caption && (
    <figcaption class="artifact-caption">{caption}</figcaption>
  )}
</figure>

<style>
  .artifact {
    margin: 0;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    background-color: var(--color-bg-surface-2);
    overflow: hidden;
  }

  .artifact-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.875rem;
    background-color: var(--color-bg-surface-1);
    border-bottom: 1px solid var(--color-border-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .artifact-filename {
    color: var(--color-text-primary);
    font-weight: 500;
  }

  .artifact-lang {
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xs);
    padding: 0.15rem 0.4rem;
    line-height: 1;
  }

  .artifact-body {
    margin: 0;
    padding: 1rem 1.125rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-primary);
    overflow-x: auto;
    white-space: pre;
    tab-size: 2;
  }

  .artifact-caption {
    padding: 0.5rem 0.875rem;
    border-top: 1px solid var(--color-border-subtle);
    background-color: var(--color-bg-surface-1);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }
</style>
