---
/**
 * ScorePill — `9.2 / 10`, mono, color-graded by band.
 *
 * Bands (from DESIGN.md):
 *   high (>=9): accent text on canvas
 *   mid  (7-9): primary text on canvas
 *   low  (<7):  tertiary text on canvas
 *
 * Used on tool cards (size=sm), tool detail headers (size=md), and
 * comparison hero columns. Color encodes ranking; numerals are mono.
 */

interface Props {
  /** 0-10 */
  score: number;
  size?: "sm" | "md";
  class?: string;
}

const { score, size = "md", class: className = "" } = Astro.props;
const band = score >= 9 ? "high" : score >= 7 ? "mid" : "low";
---

<span
  class:list={[
    "score-pill",
    `score-pill-${size}`,
    `score-pill-${band}`,
    className,
  ]}
  aria-label={`ooligo score ${score} out of 10`}
>
  <span class="score-pill-value">{score.toFixed(1)}</span>
  <span class="score-pill-max">/10</span>
</span>

<style>
  .score-pill {
    display: inline-flex;
    align-items: baseline;
    gap: 0.125rem;
    font-family: var(--font-mono);
    font-weight: 500;
    line-height: 1;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-pill);
    background-color: var(--color-bg-surface-1);
  }

  .score-pill-sm {
    padding: 0.25rem 0.5rem;
    font-size: var(--text-xs);
  }
  .score-pill-md {
    padding: 0.375rem 0.75rem;
    font-size: var(--text-sm);
  }

  .score-pill-value {
    letter-spacing: -0.01em;
  }
  .score-pill-max {
    color: var(--color-text-tertiary);
    font-size: 0.85em;
  }

  .score-pill-high .score-pill-value {
    color: var(--color-accent);
  }
  .score-pill-mid .score-pill-value {
    color: var(--color-text-primary);
  }
  .score-pill-low .score-pill-value {
    color: var(--color-text-tertiary);
  }
  .score-pill-high {
    border-color: color-mix(in oklab, var(--color-accent) 30%, var(--color-border-subtle));
  }
</style>
