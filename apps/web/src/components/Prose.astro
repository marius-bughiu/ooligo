---
/**
 * Prose — typographic shell for MDX article bodies.
 *
 * Wraps an Astro <Content /> render with the long-form reading
 * styles used on tool / workflow / learn detail pages. Keeps every
 * MDX body looking like one consistent document instead of pulling
 * default browser styles on the dark canvas.
 *
 * Defaults to the reading width set in tokens (var(--container-prose)
 * = 720px). Pass class="prose-app" for the wider content area used
 * by tool detail pages.
 */

interface Props {
  /** width preset; "prose" = reading 720, "app" = container 1280 */
  width?: "prose" | "app" | "full";
  class?: string;
}

const { width = "prose", class: className = "" } = Astro.props;
---

<article class:list={["prose", `prose-${width}`, className]}>
  <slot />
</article>

<style is:global>
  .prose {
    color: var(--color-text-primary);
    font-size: var(--text-base);
    line-height: 1.65;
  }
  .prose-prose {
    max-width: var(--container-prose);
  }
  .prose-app {
    max-width: none;
  }

  /* Headings */
  .prose :is(h2, h3, h4) {
    color: var(--color-text-primary);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.2;
    scroll-margin-top: 5rem; /* avoid sticky header overlap when anchored */
  }
  .prose h2 {
    font-size: var(--text-2xl);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border-subtle);
  }
  .prose h2:first-child {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }
  .prose h3 {
    font-size: var(--text-xl);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .prose h4 {
    font-size: var(--text-lg);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  /* Paragraphs */
  .prose p {
    margin: 0 0 1.25rem;
    color: var(--color-text-secondary);
  }
  .prose p strong {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  /* Inline links */
  .prose a {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: color-mix(
      in oklab,
      var(--color-accent) 35%,
      transparent
    );
    text-underline-offset: 3px;
    transition: text-decoration-color 150ms var(--ease-out-soft);
  }
  .prose a:hover {
    text-decoration-color: var(--color-accent);
  }

  /* Lists */
  .prose :is(ul, ol) {
    margin: 0 0 1.25rem;
    padding-left: 1.25rem;
    color: var(--color-text-secondary);
  }
  .prose ul {
    list-style: none;
    padding-left: 0;
  }
  .prose ul > li {
    position: relative;
    padding-left: 1.25rem;
    margin-bottom: 0.4rem;
  }
  .prose ul > li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 0.5rem;
    height: 1px;
    background-color: var(--color-border);
  }
  .prose ol > li {
    margin-bottom: 0.4rem;
  }
  .prose ol > li::marker {
    color: var(--color-text-tertiary);
    font-family: var(--font-mono);
  }
  .prose li > :is(ul, ol) {
    margin-top: 0.4rem;
    margin-bottom: 0.4rem;
  }

  /* Inline code */
  .prose code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    color: var(--color-accent);
    background-color: color-mix(
      in oklab,
      var(--color-accent) 10%,
      var(--color-bg-surface-2)
    );
    padding: 0.1rem 0.35rem;
    border-radius: var(--radius-xs);
    border: 1px solid var(--color-border-subtle);
  }

  /* Code blocks */
  .prose pre {
    margin: 0 0 1.25rem;
    padding: 1rem 1.125rem;
    background-color: var(--color-bg-surface-2);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-primary);
  }
  .prose pre code {
    color: inherit;
    background: transparent;
    padding: 0;
    border: 0;
    font-size: 1em;
  }

  /* Block quotes */
  .prose blockquote {
    margin: 1.5rem 0;
    padding: 0.5rem 0 0.5rem 1rem;
    border-left: 2px solid var(--color-accent);
    color: var(--color-text-primary);
    font-style: italic;
  }
  .prose blockquote p:last-child {
    margin-bottom: 0;
  }

  /* Tables */
  .prose table {
    width: 100%;
    margin: 0 0 1.5rem;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }
  .prose th,
  .prose td {
    padding: 0.625rem 0.875rem;
    border-bottom: 1px solid var(--color-border-subtle);
    text-align: left;
  }
  .prose thead th {
    color: var(--color-text-tertiary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
  }
  .prose tbody td {
    color: var(--color-text-secondary);
  }

  /* Horizontal rule */
  .prose hr {
    border: 0;
    border-top: 1px solid var(--color-border-subtle);
    margin: 2.5rem 0;
  }

  /* Images */
  .prose img {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-subtle);
    margin: 1.5rem 0;
  }
</style>
