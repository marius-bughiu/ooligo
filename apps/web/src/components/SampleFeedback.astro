---
import { localeText, type LocaleCode } from "~/lib/config";

interface Props {
  locale: LocaleCode;
  workflowSlug: string;
}
const { locale, workflowSlug } = Astro.props;
const t = localeText({
  en: { question: "After running the local demo, how did it go?", worked: "It worked", stuck: "I got stuck", workedResponse: "You selected: it worked.", stuckResponse: "You selected: I got stuck." },
  es: { question: "Después de ejecutar la demo local, ¿cómo te fue?", worked: "Funcionó", stuck: "Me quedé atascado", workedResponse: "Seleccionaste: funcionó.", stuckResponse: "Seleccionaste: me quedé atascado." },
  "pt-BR": { question: "Depois de executar a demonstração local, como foi?", worked: "Funcionou", stuck: "Não consegui concluir", workedResponse: "Você selecionou: funcionou.", stuckResponse: "Você selecionou: não consegui concluir." },
  de: { question: "Wie lief es, nachdem Sie die lokale Demo ausgeführt haben?", worked: "Es hat funktioniert", stuck: "Ich kam nicht weiter", workedResponse: "Ihre Auswahl: Es hat funktioniert.", stuckResponse: "Ihre Auswahl: Ich kam nicht weiter." },
  fr: { question: "Après avoir lancé la démo en local, comment cela s’est-il passé ?", worked: "Cela a fonctionné", stuck: "Je suis resté bloqué", workedResponse: "Votre choix : cela a fonctionné.", stuckResponse: "Votre choix : je suis resté bloqué." },
  ja: { question: "ローカルでデモを実行した結果はいかがでしたか？", worked: "動作した", stuck: "途中で進めなくなった", workedResponse: "「動作した」を選択しました。", stuckResponse: "「途中で進めなくなった」を選択しました。" },
}, locale);
---

<fieldset class="sample-feedback" data-sample-feedback>
  <legend>{t.question}</legend>
  <div class="sample-feedback-options">
    <button type="button" data-ooligo-feedback="worked" data-workflow-slug={workflowSlug} data-placement="sample" data-feedback-response={t.workedResponse} aria-pressed="false">{t.worked}</button>
    <button type="button" data-ooligo-feedback="got_stuck" data-workflow-slug={workflowSlug} data-placement="sample" data-feedback-response={t.stuckResponse} aria-pressed="false">{t.stuck}</button>
  </div>
  <p class="sample-feedback-status" data-feedback-status role="status" aria-live="polite"></p>
</fieldset>

<style>
  .sample-feedback { border: 0; padding: 0; margin: 1.5rem 0 0; }
  .sample-feedback legend { padding: 0; color: var(--color-text-secondary); font-size: var(--text-sm); }
  .sample-feedback-options { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.75rem; }
  .sample-feedback button { padding: 0.55rem 0.85rem; border: 1px solid var(--color-border); border-radius: var(--radius-xs); background: var(--color-bg-surface-1); color: var(--color-text-primary); font: inherit; font-size: var(--text-sm); cursor: pointer; }
  .sample-feedback button:hover:not(:disabled), .sample-feedback button[aria-pressed="true"] { border-color: var(--color-accent); }
  .sample-feedback button:disabled { cursor: default; }
  .sample-feedback button:disabled[aria-pressed="false"] { opacity: 0.5; }
  .sample-feedback-status { margin: 0.75rem 0 0; color: var(--color-text-secondary); font-size: var(--text-sm); }
  .sample-feedback-status:empty { display: none; }
</style>
