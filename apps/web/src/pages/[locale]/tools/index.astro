---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { locales, type LocaleCode } from "~/lib/config";

export function getStaticPaths() {
  return locales.map((l) => ({ params: { locale: l.code } }));
}

const { locale } = Astro.params as { locale: LocaleCode };

const allTools = await getCollection("tools");
const tools = allTools
  .filter((t) => t.data.locale === locale)
  .sort((a, b) => a.data.name.localeCompare(b.data.name));

const byCategory = tools.reduce<Record<string, typeof tools>>((acc, t) => {
  const cat = t.data.category;
  acc[cat] ??= [];
  acc[cat].push(t);
  return acc;
}, {});

const categories = Object.keys(byCategory).sort();
---
<BaseLayout
  title="Tools — ooligo"
  description="Directory of AI tools, MCP servers, agents, GPTs for ops leaders."
  locale={locale}
  pagePath="/tools"
>
  <main>
    <header>
      <h1>Tools</h1>
      <p>
        {tools.length} {tools.length === 1 ? "tool" : "tools"} indexed.
        Catalog grows on every push.
      </p>
    </header>

    {categories.length === 0 ? (
      <p>No tools yet — first entries land in Phase 1.</p>
    ) : (
      categories.map((cat) => (
        <section>
          <h2>{cat}</h2>
          <ul>
            {byCategory[cat]!.map((t) => (
              <li>
                <a href={`/${locale}/tools/${t.data.slug}`}>
                  <strong>{t.data.name}</strong>
                </a>
                {t.data.ooligo_score !== undefined && (
                  <> · <span>{t.data.ooligo_score}/10</span></>
                )}
                {t.data.ai_native && <> · <em>AI-native</em></>}
                {t.data.mcp_available && <> · <em>MCP</em></>}
              </li>
            ))}
          </ul>
        </section>
      ))
    )}

    <p><a href={`/${locale}/`}>← Home</a></p>
  </main>
</BaseLayout>
