---
import BaseLayout from "~/layouts/BaseLayout.astro";
import LegalPageView from "~/components/LegalPageView.astro";
import { locales, type LocaleCode } from "~/lib/config";
import { termsPage, lastUpdatedLabel } from "~/lib/legalStrings";

export function getStaticPaths() {
  return locales.map((l) => ({ params: { locale: l.code } }));
}

const { locale } = Astro.params as { locale: LocaleCode };
const page = termsPage(locale);
---

<BaseLayout
  title={page.title}
  description={page.description}
  locale={locale}
  pagePath="/terms"
>
  <main id="main">
    <LegalPageView
      page={page}
      locale={locale}
      breadcrumbKey="terms"
      lastUpdatedLabel={lastUpdatedLabel(locale)}
    />
  </main>
</BaseLayout>
