{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ooligo/comparison.schema.json",
  "title": "Comparison entry frontmatter",
  "type": "object",
  "required": ["slug", "canonical_slug", "locale", "type", "verticals", "last_updated", "ai_generated"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "canonical_slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "locale": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
    "type": { "type": "string", "enum": ["pairwise", "roundup", "alternatives"] },
    "tool_a": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "tool_b": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "tools": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "verticals": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "minItems": 1
    },
    "last_updated": { "type": "string", "format": "date" },
    "ai_generated": { "type": "boolean" },
    "ai_translated": { "type": "boolean" },
    "translated_from": { "type": "string" },
    "translated_at": { "type": "string", "format": "date-time" },
    "translation_model": { "type": "string" },
    "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "pairwise" } } },
      "then": { "required": ["tool_a", "tool_b"] }
    },
    {
      "if": { "properties": { "type": { "enum": ["roundup", "alternatives"] } } },
      "then": { "required": ["tools"], "properties": { "tools": { "minItems": 2 } } }
    }
  ]
}
