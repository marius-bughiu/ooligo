---
/**
 * Container — page-level horizontal max-width + gutter.
 *
 * Two widths matching DESIGN.md:
 *   - "app"   = 1280  (default; tools/comparisons/workflows index/detail)
 *   - "prose" = 720   (/learn long-form reading width)
 *
 * Vertical rhythm is owned by <Section>, so Container is layout-only.
 */

interface Props {
  width?: "app" | "prose";
  as?: "div" | "main" | "header" | "footer" | "section" | "nav" | "article";
  class?: string;
}

const { width = "app", as: Tag = "div", class: className = "" } = Astro.props;
const widthClass = width === "prose" ? "container-prose" : "container-app";
---

<Tag class:list={[widthClass, className]}>
  <slot />
</Tag>

<style>
  .container-app,
  .container-prose {
    width: 100%;
    margin-inline: auto;
    padding-inline: 1.5rem; /* 24px gutter, mirrors grid */
  }
  .container-app {
    max-width: var(--container-app);
  }
  .container-prose {
    max-width: var(--container-prose);
  }

  @media (min-width: 1024px) {
    .container-app,
    .container-prose {
      padding-inline: 2rem;
    }
  }
</style>
