---
import { getCollection, getEntry, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import JsonLd from "~/components/JsonLd.astro";
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import Container from "~/components/Container.astro";
import Section from "~/components/Section.astro";
import Prose from "~/components/Prose.astro";
import ArtifactTypeIcon from "~/components/ArtifactTypeIcon.astro";
import StackBadgeRow from "~/components/StackBadgeRow.astro";
import CapabilityChip from "~/components/CapabilityChip.astro";
import VerticalTag from "~/components/VerticalTag.astro";
import CrossLinkRail from "~/components/CrossLinkRail.astro";
import EditOnGitHub from "~/components/EditOnGitHub.astro";
import { localeText, type LocaleCode } from "~/lib/config";
import { chromeStrings } from "~/lib/strings";

export async function getStaticPaths() {
  const workflows = await getCollection("workflows");
  return workflows.map((entry) => ({
    params: { locale: entry.data.locale, slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { locale } = Astro.params as { locale: LocaleCode };
const { Content } = await render(entry);
const data = entry.data;

type ToolEntry = CollectionEntry<"tools">;
type WorkflowEntry = CollectionEntry<"workflows">;
type LearnEntry = CollectionEntry<"learn">;

const allWorkflows = await getCollection("workflows");
const allLearn = await getCollection("learn");

const availableLocales = allWorkflows
  .filter((w) => w.data.canonical_slug === data.canonical_slug)
  .map((w) => w.data.locale);

async function resolveTools(slugs: string[]): Promise<ToolEntry[]> {
  const resolved = await Promise.all(
    slugs.map((slug) =>
      getEntry("tools", `${locale}/${slug}`).catch(() => undefined)
    )
  );
  return resolved.filter((tt): tt is ToolEntry => tt !== undefined);
}

const tools = await resolveTools(data.tools_used);
const chrome = chromeStrings(locale);

// ----- Localized labels -----
const labels = {
  en: {
    meta_difficulty: "Difficulty",
    meta_time: "Setup time",
    meta_roles: "For",
    meta_tested: "Human-tested",
    section_stack: "Stack",
    section_install: "Setup",
    cta_download: "Download artifact",
    cta_download_desc: "Plug it into your stack and run.",
    rail_workflows: "Related workflows",
    rail_learn: "Related learning",
  },
  es: {
    meta_difficulty: "Dificultad",
    meta_time: "Tiempo de setup",
    meta_roles: "Para",
    meta_tested: "Probado por humanos",
    section_stack: "Stack",
    section_install: "Instalación",
    cta_download: "Descargar artefacto",
    cta_download_desc: "Conéctalo a tu stack y ejecuta.",
    rail_workflows: "Workflows relacionados",
    rail_learn: "Aprendizaje relacionado",
  },
  "pt-BR": {
    meta_difficulty: "Dificuldade",
    meta_time: "Tempo de setup",
    meta_roles: "Para",
    meta_tested: "Testado por humanos",
    section_stack: "Stack",
    section_install: "Instalação",
    cta_download: "Baixar artefato",
    cta_download_desc: "Plugue na sua stack e rode.",
    rail_workflows: "Workflows relacionados",
    rail_learn: "Aprendizado relacionado",
  },
} as const;

const t = localeText(labels, locale);

// ----- Cross-link computation -----
const localeWorkflows = allWorkflows.filter((w) => w.data.locale === locale);
const localeLearn = allLearn.filter((l) => l.data.locale === locale);

// Related workflows: same artifact_type OR sharing >=1 tool, excluding self.
const relatedWorkflows: WorkflowEntry[] = localeWorkflows
  .filter((w) => w.data.slug !== data.slug)
  .map((w) => {
    const sharedTools = w.data.tools_used.filter((slug) =>
      data.tools_used.includes(slug)
    ).length;
    const sameType = w.data.artifact_type === data.artifact_type ? 1 : 0;
    const sharedVerticals = w.data.verticals.filter((v) =>
      data.verticals.includes(v)
    ).length;
    return {
      entry: w,
      score: sharedTools * 3 + sharedVerticals + sameType,
    };
  })
  .filter((r) => r.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 4)
  .map((r) => r.entry);

// Related learn: entries that include any of this workflow's tools in
// related_tools, OR entries tagged with any of this workflow's verticals.
const relatedLearn: LearnEntry[] = localeLearn
  .filter((l) => {
    const hasTool = (l.data.related_tools ?? []).some((slug) =>
      data.tools_used.includes(slug)
    );
    const hasVertical = (l.data.verticals ?? []).some((v) =>
      data.verticals.includes(v)
    );
    return hasTool || hasVertical;
  })
  .slice(0, 3);

// ----- JSON-LD -----
const jsonLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: data.title,
  totalTime: data.time_to_setup,
  tool: tools.map((tt) => ({
    "@type": "HowToTool",
    name: tt.data.name,
  })),
};

// File extension from download URL → preview lang fallback label
function fileExt(url: string | undefined): string | undefined {
  if (!url) return undefined;
  const m = url.match(/\.([a-z0-9]{1,8})(?:\?|#|$)/i);
  return m ? m[1]?.toUpperCase() : undefined;
}
const downloadExt = fileExt(data.download_url);
const previewLangLabel = data.preview_lang ?? downloadExt;
---

<BaseLayout
  title={`${data.title} — ooligo`}
  description={`${data.artifact_type} workflow for ${data.roles.join(", ")}.`}
  locale={locale}
  pagePath={`/workflows/${data.slug}`}
  availableLocales={availableLocales}
  ogImagePath={`/og/${locale}/workflows/${data.slug}.svg`}
>
  <JsonLd slot="head" data={jsonLd} />
  <main id="main">
    <Section density="md">
      <Container>
        <Breadcrumbs
          items={[
            { label: "ooligo", href: `/${locale}/` },
            { label: chrome.nav.workflows, href: `/${locale}/workflows/` },
            { label: data.title },
          ]}
        />

        <!-- ============ HEADER BAND ============ -->
        <header class="wf-header">
          <div class="wf-header-type">
            <ArtifactTypeIcon type={data.artifact_type} size={20} />
            <span class="wf-artifact-type">{data.artifact_type}</span>
          </div>

          <h1 class="wf-title">{data.title}</h1>

          <div class="wf-meta-grid">
            <div class="wf-meta-item">
              <div class="wf-meta-label">{t.meta_difficulty}</div>
              <div class="wf-meta-value wf-meta-value-mono">
                {chrome.difficulty[data.difficulty]}
              </div>
            </div>
            {data.time_to_setup && (
              <div class="wf-meta-item">
                <div class="wf-meta-label">{t.meta_time}</div>
                <div class="wf-meta-value wf-meta-value-mono">{data.time_to_setup}</div>
              </div>
            )}
            <div class="wf-meta-item">
              <div class="wf-meta-label">{t.meta_roles}</div>
              <div class="wf-meta-value">
                {data.roles.join(" · ")}
              </div>
            </div>
            {data.human_tested && (
              <div class="wf-meta-item">
                <div class="wf-meta-label">{t.meta_tested}</div>
                <div class="wf-meta-value">
                  <CapabilityChip label="VERIFIED" variant="accent" />
                </div>
              </div>
            )}
          </div>

          <div class="wf-vtags">
            {data.verticals.map((vSlug) => (
              <VerticalTag slug={vSlug} locale={locale} size="sm" />
            ))}
          </div>
        </header>

        <!-- ============ STACK ROW ============ -->
        {tools.length > 0 && (
          <section class="wf-stack-section">
            <h2 class="wf-section-title">{t.section_stack}</h2>
            <StackBadgeRow
              tools={tools.map((tt) => ({
                slug: tt.data.slug,
                name: tt.data.name,
              }))}
              locale={locale}
            />
          </section>
        )}

        <!-- ============ DOWNLOAD CTA ============ -->
        {data.download_url && (
          <section class="wf-download-section">
            <a class="wf-download" href={data.download_url} download>
              <div class="wf-download-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M10 3v10m0 0l-4-4m4 4l4-4M3 17h14"/>
                </svg>
              </div>
              <div class="wf-download-text">
                <div class="wf-download-label">{t.cta_download}</div>
                <div class="wf-download-desc">{t.cta_download_desc}</div>
              </div>
              {previewLangLabel && (
                <div class="wf-download-lang">{previewLangLabel}</div>
              )}
            </a>
          </section>
        )}

        <!-- ============ MDX BODY ============ -->
        <div class="wf-body">
          <Prose width="prose">
            <Content />
            <div class="edit-on-github-wrap">
              <EditOnGitHub
                mode="edit"
                collection="workflows"
                locale={locale}
                slug={data.slug}
                label={chrome.contribute.edit_page}
              />
            </div>
          </Prose>
        </div>
      </Container>
    </Section>

    <!-- ============ CROSS-LINK RAILS ============ -->
    {(relatedWorkflows.length > 0 || relatedLearn.length > 0) && (
      <Section density="md" divided surface="surface-1">
        <Container>
          <div class="rails-grid">
            {relatedWorkflows.length > 0 && (
              <CrossLinkRail
                heading={t.rail_workflows}
                variant="compact"
                links={relatedWorkflows.map((w) => ({
                  label: w.data.title,
                  href: `/${locale}/workflows/${w.data.slug}/`,
                  meta: w.data.artifact_type,
                }))}
              />
            )}
            {relatedLearn.length > 0 && (
              <CrossLinkRail
                heading={t.rail_learn}
                variant="compact"
                links={relatedLearn.map((l) => ({
                  label: l.data.title,
                  href: `/${locale}/learn/${l.data.slug}/`,
                  meta: l.data.type,
                }))}
              />
            )}
          </div>
        </Container>
      </Section>
    )}
  </main>
</BaseLayout>

<style>
  /* ============ HEADER ============ */
  .wf-header {
    margin-top: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .wf-header-type {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.875rem;
    color: var(--color-text-tertiary);
  }
  .wf-artifact-type {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .wf-title {
    margin: 0 0 1.5rem;
    font-size: var(--text-3xl);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .wf-meta-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem 1.5rem;
    padding: 1rem 0;
    border-top: 1px solid var(--color-border-subtle);
    border-bottom: 1px solid var(--color-border-subtle);
    margin-bottom: 1rem;
  }
  @media (min-width: 768px) {
    .wf-meta-grid {
      grid-template-columns: repeat(4, auto);
      column-gap: 3rem;
    }
  }

  .wf-meta-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-tertiary);
    margin-bottom: 0.25rem;
  }

  .wf-meta-value {
    font-size: var(--text-sm);
    color: var(--color-text-primary);
  }
  .wf-meta-value-mono {
    font-family: var(--font-mono);
    text-transform: capitalize;
  }

  .wf-vtags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
  }

  /* ============ STACK SECTION ============ */
  .wf-section-title {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-tertiary);
    font-weight: 600;
  }

  .wf-stack-section {
    margin: 2.5rem 0;
  }

  /* ============ DOWNLOAD CTA ============ */
  .wf-download-section {
    margin: 2rem 0 2.5rem;
  }

  .wf-download {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 1.125rem 1.25rem;
    background-color: var(--color-bg-surface-1);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius-sm);
    color: var(--color-text-primary);
    transition: border-color 150ms var(--ease-out-soft),
      background-color 150ms var(--ease-out-soft);
  }
  .wf-download:hover {
    background-color: var(--color-bg-surface-2);
    border-color: var(--color-accent);
  }

  .wf-download-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background-color: color-mix(in oklab, var(--color-accent) 15%, transparent);
    color: var(--color-accent);
    border-radius: var(--radius-xs);
  }

  .wf-download-text {
    min-width: 0;
  }
  .wf-download-label {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: 1.2;
  }
  .wf-download-desc {
    margin-top: 0.25rem;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .wf-download-lang {
    align-self: flex-start;
    padding: 0.25rem 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* ============ BODY ============ */
  .wf-body {
    margin-top: 1.5rem;
  }

  .edit-on-github-wrap {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  /* ============ RAILS ============ */
  .rails-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 768px) {
    .rails-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem;
    }
  }
</style>
