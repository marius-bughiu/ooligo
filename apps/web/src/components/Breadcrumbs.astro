---
/**
 * Breadcrumbs — visual + BreadcrumbList JSON-LD.
 *
 * Used on every detail page. Fulfills the BreadcrumbList structured-data
 * requirement in ARCHITECTURE.md while doubling as the page-internal
 * affordance back up the entity hierarchy.
 *
 * Pass an ordered array; the LAST item is the current page (rendered
 * without a link, marked aria-current).
 *
 * The JSON-LD <script> renders inline in the body, which Google indexes
 * the same as head-mounted JSON-LD; placing it next to the visual list
 * keeps the contract single-component.
 */

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
  /** Site origin for absolute URLs in JSON-LD. */
  site?: string;
}

const { items, site } = Astro.props;
const origin =
  site ?? (Astro.site?.toString().replace(/\/$/, "") ?? "https://ooligo.com");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: items.map((c, i) => {
    const item: Record<string, unknown> = {
      "@type": "ListItem",
      position: i + 1,
      name: c.label,
    };
    if (c.href) {
      item.item = c.href.startsWith("http") ? c.href : `${origin}${c.href}`;
    }
    return item;
  }),
};
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol class="breadcrumbs-list">
    {items.map((c, i) => {
      const isLast = i === items.length - 1;
      return (
        <li class="breadcrumbs-item">
          {c.href && !isLast ? (
            <a href={c.href} class="breadcrumbs-link">{c.label}</a>
          ) : (
            <span class="breadcrumbs-current" aria-current={isLast ? "page" : undefined}>
              {c.label}
            </span>
          )}
          {!isLast && (
            <span class="breadcrumbs-sep" aria-hidden="true">/</span>
          )}
        </li>
      );
    })}
  </ol>
</nav>

<script
  type="application/ld+json"
  set:html={JSON.stringify(jsonLd)}
  is:inline
/>

<style>
  .breadcrumbs {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .breadcrumbs-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .breadcrumbs-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-tertiary);
  }

  .breadcrumbs-link {
    color: var(--color-text-secondary);
    transition: color 150ms var(--ease-out-soft);
  }
  .breadcrumbs-link:hover {
    color: var(--color-text-primary);
  }

  .breadcrumbs-current {
    color: var(--color-text-primary);
  }

  .breadcrumbs-sep {
    color: var(--color-border);
  }
</style>
