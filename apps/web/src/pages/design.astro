---
/**
 * /design — internal component gallery.
 *
 * One page that renders every primitive in the D2 component library,
 * with realistic sample data shaped to the content.config.ts schemas.
 * Useful for visual review during D3/D4 page-template work and as the
 * canonical design-system reference once content is in flight.
 *
 * NOT in the public sitemap (filtered in astro.config.mjs).
 * NOT indexed (noindex robots meta below).
 * NOT linked from chrome — direct URL only.
 */

import BaseLayout from "~/layouts/BaseLayout.astro";
import Container from "~/components/Container.astro";
import Section from "~/components/Section.astro";

import ScorePill from "~/components/ScorePill.astro";
import CapabilityChip from "~/components/CapabilityChip.astro";
import PricingLabel from "~/components/PricingLabel.astro";
import VerticalTag from "~/components/VerticalTag.astro";
import ToolMonogram from "~/components/ToolMonogram.astro";

import ScoreBreakdownBars from "~/components/ScoreBreakdownBars.astro";
import EmptyState from "~/components/EmptyState.astro";
import AeoAnswerBlock from "~/components/AeoAnswerBlock.astro";

import ArtifactTypeIcon from "~/components/ArtifactTypeIcon.astro";
import ToolCard from "~/components/ToolCard.astro";
import WorkflowCard from "~/components/WorkflowCard.astro";
import LearnCard from "~/components/LearnCard.astro";
import ComparisonStrip from "~/components/ComparisonStrip.astro";
import StackBadgeRow from "~/components/StackBadgeRow.astro";

import SpecTable from "~/components/SpecTable.astro";
import SpecRow from "~/components/SpecRow.astro";
import CrossLinkRail from "~/components/CrossLinkRail.astro";
import InlineArtifactPreview from "~/components/InlineArtifactPreview.astro";

// Sample data shaped exactly like the Zod schemas in content.config.ts
// so cards render with realistic dimensions.
const sampleTool = {
  slug: "clay",
  canonical_slug: "clay",
  locale: "en" as const,
  verticals: ["revops", "marketing-ops"],
  name: "Clay",
  category: "prospecting",
  subcategories: ["data-enrichment", "outbound-orchestration"],
  pricing_model: "usage-based" as const,
  pricing_starts_at: 149,
  pricing_url: "https://clay.com/pricing",
  website: "https://clay.com",
  ai_native: true,
  mcp_available: false,
  api_available: true,
  integrations: ["salesforce", "hubspot", "apollo"],
  ooligo_score: 9.2,
  ooligo_score_breakdown: {
    ux: 9,
    ai_quality: 9,
    pricing_value: 8,
    integrations: 10,
  },
  last_reviewed: "2026-05-02",
};

const sampleToolFree = {
  ...sampleTool,
  slug: "n8n",
  name: "n8n",
  category: "automation",
  pricing_model: "freemium" as const,
  pricing_starts_at: null,
  ooligo_score: 8.4,
  ai_native: false,
  mcp_available: true,
  api_available: true,
};

const sampleToolLow = {
  ...sampleTool,
  slug: "legacy-crm",
  name: "Legacy CRM",
  category: "crm",
  pricing_model: "flat" as const,
  pricing_starts_at: 89,
  ooligo_score: 6.1,
  ai_native: false,
  mcp_available: false,
};

const sampleWorkflow = {
  slug: "lead-enrichment-clay-claude",
  canonical_slug: "lead-enrichment-clay-claude",
  locale: "en" as const,
  verticals: ["revops"],
  title: "Lead enrichment with Clay + Claude",
  artifact_type: "claude-skill" as const,
  tools_used: ["clay", "claude", "hubspot"],
  roles: ["revops", "sdr-leader"],
  difficulty: "intermediate" as const,
  time_to_setup: "30min",
};

const sampleLearn = {
  slug: "what-is-revops",
  canonical_slug: "what-is-revops",
  locale: "en" as const,
  type: "definition" as const,
  title: "What is RevOps?",
  verticals: ["revops"],
  target_questions: [
    "What is RevOps?",
    "What does a RevOps team do?",
    "RevOps vs Sales Ops",
  ],
  last_updated: "2026-05-02",
};

const sampleComparisonPair = {
  slug: "clay-vs-apollo",
  canonical_slug: "clay-vs-apollo",
  locale: "en" as const,
  type: "pairwise" as const,
  tool_a: "clay",
  tool_b: "apollo",
  verticals: ["revops", "sales"],
  last_updated: "2026-05-02",
};

const sampleComparisonRoundup = {
  slug: "best-ai-dialers",
  canonical_slug: "best-ai-dialers",
  locale: "en" as const,
  type: "roundup" as const,
  tools: ["orum", "nooks", "regie", "default"],
  verticals: ["revops"],
  last_updated: "2026-05-02",
};

const toolNamesLookup: Record<string, string> = {
  clay: "Clay",
  claude: "Claude",
  hubspot: "HubSpot",
  apollo: "Apollo",
  orum: "Orum",
  nooks: "Nooks",
  regie: "Regie.ai",
  default: "Default",
};

const allArtifactTypes = [
  "prompt",
  "claude-skill",
  "mcp-server",
  "n8n-flow",
  "cursor-rule",
  "agent-template",
  "sop",
] as const;
---

<BaseLayout
  title="ooligo · design system"
  description="Internal design-system gallery. Not for public consumption."
  locale="en"
  pagePath="/design"
  availableLocales={[]}
>
  <meta slot="head" name="robots" content="noindex,nofollow" />

  <main id="main">
    <Section density="md">
      <Container>
        <header class="ds-header">
          <h1 class="ds-title">design system</h1>
          <p class="ds-sub">
            Every primitive in the D2 component library, sample data shaped to
            content schemas. Internal page — not in sitemap, not indexed, not
            linked from chrome.
          </p>
        </header>
      </Container>
    </Section>

    <!-- ATOMS -->
    <Section density="md" divided>
      <Container>
        <h2 class="ds-section-title">atoms</h2>

        <div class="ds-card">
          <div class="ds-card-label">ScorePill — bands</div>
          <div class="ds-row">
            <ScorePill score={9.5} />
            <ScorePill score={8.4} />
            <ScorePill score={6.7} />
            <ScorePill score={9.2} size="sm" />
          </div>
        </div>

        <div class="ds-card">
          <div class="ds-card-label">CapabilityChip — variants + sizes</div>
          <div class="ds-row">
            <CapabilityChip label="AI-NATIVE" variant="accent" />
            <CapabilityChip label="MCP" />
            <CapabilityChip label="API" />
            <CapabilityChip label="FREE-TIER" />
            <CapabilityChip label="OPEN SOURCE" size="md" />
          </div>
        </div>

        <div class="ds-card">
          <div class="ds-card-label">PricingLabel — usage / flat / free</div>
          <div class="ds-row ds-row-tight">
            <PricingLabel model="usage-based" startsAt={149} />
            <PricingLabel model="flat" startsAt={89} />
            <PricingLabel model="freemium" />
            <PricingLabel model="free" />
            <PricingLabel model="custom" />
          </div>
        </div>

        <div class="ds-card">
          <div class="ds-card-label">VerticalTag — all 3 verticals</div>
          <div class="ds-row">
            <VerticalTag slug="revops" locale="en" />
            <VerticalTag slug="legal-ops" locale="en" />
            <VerticalTag slug="recruiting" locale="en" />
            <VerticalTag slug="revops" locale="en" size="md" />
          </div>
        </div>

        <div class="ds-card">
          <div class="ds-card-label">ToolMonogram — sizes / outlined</div>
          <div class="ds-row">
            <ToolMonogram name="Clay" size={56} />
            <ToolMonogram name="HubSpot" size={48} />
            <ToolMonogram name="Apollo" size={36} />
            <ToolMonogram name="Salesforce" size={28} />
            <ToolMonogram name="Claude" size={48} outlined />
            <ToolMonogram name="Outreach" size={36} outlined />
          </div>
        </div>
      </Container>
    </Section>

    <!-- DISPLAY COMPOUNDS -->
    <Section density="md" divided>
      <Container>
        <h2 class="ds-section-title">display compounds</h2>

        <div class="ds-card">
          <div class="ds-card-label">ScoreBreakdownBars</div>
          <div style="max-width: 28rem">
            <ScoreBreakdownBars breakdown={sampleTool.ooligo_score_breakdown} />
          </div>
        </div>

        <div class="ds-card">
          <div class="ds-card-label">EmptyState</div>
          <div style="max-width: 32rem">
            <EmptyState
              title="No comparisons yet"
              message="The pairwise comparison generator runs on the next pipeline tick. Check back, or browse the tool catalog in the meantime."
              action={{ label: "Browse tools", href: "/en/tools/" }}
            />
          </div>
        </div>

        <div class="ds-card">
          <div class="ds-card-label">AeoAnswerBlock</div>
          <AeoAnswerBlock
            questions={sampleLearn.target_questions}
            locale="en"
          />
        </div>
      </Container>
    </Section>

    <!-- CARDS -->
    <Section density="md" divided>
      <Container>
        <h2 class="ds-section-title">cards</h2>

        <div class="ds-card">
          <div class="ds-card-label">ArtifactTypeIcon — all 7 types</div>
          <div class="ds-row">
            {allArtifactTypes.map((type) => (
              <span class="ds-icon-sample">
                <ArtifactTypeIcon type={type} size={20} />
                <code>{type}</code>
              </span>
            ))}
          </div>
        </div>

        <div class="ds-card">
          <div class="ds-card-label">ToolCard — high / mid / low score</div>
          <div class="ds-grid ds-grid-3">
            <ToolCard tool={sampleTool} locale="en" />
            <ToolCard tool={sampleToolFree} locale="en" />
            <ToolCard tool={sampleToolLow} locale="en" />
          </div>
        </div>

        <div class="ds-card">
          <div class="ds-card-label">WorkflowCard</div>
          <div class="ds-grid ds-grid-3">
            <WorkflowCard
              workflow={sampleWorkflow}
              toolNames={toolNamesLookup}
              locale="en"
            />
            <WorkflowCard
              workflow={{
                ...sampleWorkflow,
                slug: "outbound-mcp-server",
                title: "MCP server for outbound prospecting",
                artifact_type: "mcp-server",
                difficulty: "advanced",
                time_to_setup: "2h",
                tools_used: ["clay", "apollo", "hubspot", "claude", "default", "n8n"],
              }}
              toolNames={toolNamesLookup}
              locale="en"
            />
            <WorkflowCard
              workflow={{
                ...sampleWorkflow,
                slug: "icp-cursor-rules",
                title: "ICP guidance — Cursor rules pack",
                artifact_type: "cursor-rule",
                difficulty: "beginner",
                time_to_setup: "10min",
                tools_used: ["claude"],
              }}
              toolNames={toolNamesLookup}
              locale="en"
            />
          </div>
        </div>

        <div class="ds-card">
          <div class="ds-card-label">LearnCard — across types</div>
          <div class="ds-grid ds-grid-3">
            <LearnCard entry={sampleLearn} locale="en" />
            <LearnCard
              entry={{
                ...sampleLearn,
                slug: "pipeline-velocity",
                title: "Pipeline velocity",
                type: "framework",
                target_questions: [
                  "What is pipeline velocity and how do you calculate it?",
                ],
              }}
              locale="en"
            />
            <LearnCard
              entry={{
                ...sampleLearn,
                slug: "set-up-mcp",
                title: "How to set up an MCP server for HubSpot",
                type: "how-to",
                target_questions: [
                  "How do I connect Claude to HubSpot via MCP?",
                ],
              }}
              locale="en"
            />
          </div>
        </div>

        <div class="ds-card">
          <div class="ds-card-label">ComparisonStrip — pairwise / roundup</div>
          <div class="ds-grid ds-grid-2">
            <ComparisonStrip
              comparison={sampleComparisonPair}
              toolNames={toolNamesLookup}
              locale="en"
            />
            <ComparisonStrip
              comparison={sampleComparisonRoundup}
              toolNames={toolNamesLookup}
              locale="en"
            />
          </div>
        </div>

        <div class="ds-card">
          <div class="ds-card-label">StackBadgeRow</div>
          <StackBadgeRow
            tools={[
              { slug: "clay", name: "Clay" },
              { slug: "claude", name: "Claude" },
              { slug: "hubspot", name: "HubSpot" },
              { slug: "apollo", name: "Apollo" },
            ]}
            locale="en"
          />
        </div>
      </Container>
    </Section>

    <!-- STRUCTURED -->
    <Section density="md" divided>
      <Container>
        <h2 class="ds-section-title">structured</h2>

        <div class="ds-card">
          <div class="ds-card-label">SpecTable — slotted (rich values)</div>
          <div style="max-width: 32rem">
            <SpecTable>
              <SpecRow label="Website">
                <a href={sampleTool.website}>{sampleTool.website}</a>
              </SpecRow>
              <SpecRow label="Pricing">
                <PricingLabel
                  model={sampleTool.pricing_model}
                  startsAt={sampleTool.pricing_starts_at}
                />
              </SpecRow>
              <SpecRow label="AI-native">
                <CapabilityChip
                  label={sampleTool.ai_native ? "YES" : "NO"}
                  variant={sampleTool.ai_native ? "accent" : "default"}
                />
              </SpecRow>
              <SpecRow label="Score">
                <ScorePill score={sampleTool.ooligo_score!} />
              </SpecRow>
              <SpecRow label="Integrations">
                {sampleTool.integrations?.join(", ")}
              </SpecRow>
              <SpecRow label="Last reviewed" mono>
                {sampleTool.last_reviewed}
              </SpecRow>
            </SpecTable>
          </div>
        </div>

        <div class="ds-card">
          <div class="ds-card-label">SpecTable — data-driven (simple text rows)</div>
          <div style="max-width: 32rem">
            <SpecTable
              rows={[
                { label: "Website", value: sampleTool.website },
                { label: "AI-native", value: sampleTool.ai_native ? "Yes" : "No" },
                { label: "MCP", value: sampleTool.mcp_available ? "Yes" : "No" },
                { label: "API", value: sampleTool.api_available ? "Yes" : "No" },
                { label: "Last reviewed", value: sampleTool.last_reviewed, mono: true },
              ]}
            />
          </div>
        </div>

        <div class="ds-card">
          <div class="ds-card-label">CrossLinkRail — wide / compact</div>
          <CrossLinkRail
            heading="Alternatives"
            variant="wide"
            links={[
              { label: "Apollo", href: "/en/tools/apollo/", meta: "prospecting · 8.5/10" },
              { label: "Outreach", href: "/en/tools/outreach/", meta: "engagement · 8.1/10" },
              { label: "Salesloft", href: "/en/tools/salesloft/", meta: "engagement · 7.8/10" },
              { label: "Lemlist", href: "/en/tools/lemlist/", meta: "outbound · 7.4/10" },
            ]}
          />
          <div style="margin-top: 1.5rem; max-width: 24rem">
            <CrossLinkRail
              heading="Workflows using Clay"
              variant="compact"
              links={[
                { label: "Lead enrichment with Clay + Claude", href: "#", meta: "claude-skill" },
                { label: "ICP account list builder", href: "#", meta: "n8n-flow" },
                { label: "Outbound prospecting MCP", href: "#", meta: "mcp-server" },
              ]}
            />
          </div>
        </div>

        <div class="ds-card">
          <div class="ds-card-label">InlineArtifactPreview</div>
          <InlineArtifactPreview
            filename="lead-enrichment.md"
            lang="markdown"
            caption="first 12 lines of skill body"
          >
{`---
name: lead-enrichment
description: Enrich leads via Clay + Claude
---

# Lead Enrichment Skill

You are a RevOps assistant that takes a list of company domains
and, for each, calls Clay's enrichment endpoints to fetch firmographic
and technographic data. You then summarize the result in a HubSpot
note format with deal-stage suggestions.

## Inputs
- domain[]: array of company domains
`}
          </InlineArtifactPreview>
        </div>
      </Container>
    </Section>

    <!-- FOOTNOTES -->
    <Section density="sm" divided>
      <Container>
        <p class="ds-footnote">
          16 components in the D2 library · D3 (index pages) and D4 (detail
          pages) compose these · single-theme dark, accent
          <code>#F0A500</code>, Geist + Geist Mono.
        </p>
      </Container>
    </Section>
  </main>
</BaseLayout>

<style>
  .ds-header {
    padding: 1rem 0;
  }
  .ds-title {
    font-family: var(--font-mono);
    font-size: var(--text-3xl);
    letter-spacing: -0.04em;
    margin: 0;
  }
  .ds-sub {
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    line-height: 1.5;
    max-width: 60ch;
    margin-top: 0.5rem;
  }

  .ds-section-title {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-tertiary);
    margin: 0 0 1.5rem;
  }

  .ds-card {
    padding: 1.5rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    background-color: var(--color-bg-surface-1);
    margin-bottom: 1.25rem;
  }

  .ds-card-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-tertiary);
    margin-bottom: 1rem;
  }

  .ds-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .ds-row-tight {
    gap: 1.25rem;
  }

  .ds-grid {
    display: grid;
    gap: 1rem;
  }
  .ds-grid-2 {
    grid-template-columns: 1fr;
  }
  .ds-grid-3 {
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .ds-grid-2 {
      grid-template-columns: repeat(2, 1fr);
    }
    .ds-grid-3 {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .ds-grid-3 {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .ds-icon-sample {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xs);
    color: var(--color-text-secondary);
  }
  .ds-icon-sample code {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }

  .ds-footnote {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    text-align: center;
  }
  .ds-footnote code {
    color: var(--color-accent);
  }
</style>
