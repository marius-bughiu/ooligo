---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import JsonLd from "~/components/JsonLd.astro";
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import { type LocaleCode } from "~/lib/config";
import { chromeStrings } from "~/lib/strings";

export async function getStaticPaths() {
  const workflows = await getCollection("workflows");
  return workflows.map((entry) => ({
    params: { locale: entry.data.locale, slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { locale } = Astro.params as { locale: LocaleCode };
const { Content } = await render(entry);
const data = entry.data;

const allWorkflows = await getCollection("workflows");
const availableLocales = allWorkflows
  .filter((w) => w.data.canonical_slug === data.canonical_slug)
  .map((w) => w.data.locale);

async function resolveTools(slugs: string[]) {
  const tools = await Promise.all(
    slugs.map((slug) => getEntry("tools", `${locale}/${slug}`).catch(() => undefined))
  );
  return tools.filter((t): t is NonNullable<typeof t> => t !== undefined);
}

const tools = await resolveTools(data.tools_used);
const chrome = chromeStrings(locale);

const jsonLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: data.title,
  totalTime: data.time_to_setup,
  tool: tools.map((t) => ({
    "@type": "HowToTool",
    name: t.data.name,
  })),
};
---
<BaseLayout
  title={`${data.title} — ooligo`}
  description={`${data.artifact_type} workflow for ${data.roles.join(", ")}.`}
  locale={locale}
  pagePath={`/workflows/${data.slug}`}
  availableLocales={availableLocales}
>
  <JsonLd slot="head" data={jsonLd} />
  <main id="main">
    <Breadcrumbs
      items={[
        { label: "ooligo", href: `/${locale}/` },
        { label: chrome.nav.workflows, href: `/${locale}/workflows/` },
        { label: data.title },
      ]}
    />

    <header>
      <h1>{data.title}</h1>
      <p>
        <strong>{data.artifact_type}</strong>
        {" · "}
        <span>{data.difficulty}</span>
        {data.time_to_setup && <> · {data.time_to_setup}</>}
      </p>
    </header>

    <section>
      <h2>Stack</h2>
      <ul>
        {tools.map((t) => (
          <li>
            <a href={`/${locale}/tools/${t.data.slug}`}>{t.data.name}</a>
          </li>
        ))}
      </ul>
    </section>

    <article>
      <Content />
    </article>

    {data.download_url && (
      <section>
        <a href={data.download_url} download>Download artifact</a>
      </section>
    )}
  </main>
</BaseLayout>
