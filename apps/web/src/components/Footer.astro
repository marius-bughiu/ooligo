---
/**
 * Footer — global chrome.
 *
 * Four columns: Catalog · Verticals · Build · Subscribe. Bottom strip
 * for copyright. The footer is part of the brand surface (DESIGN.md),
 * not a regulatory afterthought — dense, multi-column, links to every
 * entity index.
 *
 * The subscribe form posts JSON to /api/subscribe — a Cloudflare Pages
 * Function that proxies to beehiiv with the API key kept server-side.
 */

import Wordmark from "./Wordmark.astro";
import {
  verticals,
  localizedName,
  REPO_URL,
  type LocaleCode,
} from "~/lib/config";
import { chromeStrings } from "~/lib/strings";

interface Props {
  locale: LocaleCode;
}

const { locale } = Astro.props;
const t = chromeStrings(locale);
const year = new Date().getUTCFullYear();

const ROADMAP_URL = `${REPO_URL}/blob/main/ROADMAP.md`;
const ARCHITECTURE_URL = `${REPO_URL}/blob/main/ARCHITECTURE.md`;

const catalogLinks = [
  { href: `/${locale}/tools/`, label: t.nav.tools },
  { href: `/${locale}/vs/`, label: t.nav.comparisons },
  { href: `/${locale}/workflows/`, label: t.nav.workflows },
  { href: `/${locale}/stacks/`, label: t.nav.stacks },
  { href: `/${locale}/learn/`, label: t.nav.learn },
];

const buildLinks = [
  { href: REPO_URL, label: t.footer.repo, external: true },
  { href: ROADMAP_URL, label: t.footer.roadmap, external: true },
  { href: ARCHITECTURE_URL, label: t.footer.architecture, external: true },
];
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <!-- Brand column -->
      <div class="footer-col footer-brand">
        <Wordmark href={`/${locale}/`} size={28} label={t.meta.home} />
        <p class="footer-tagline">{t.footer.brand_tagline}</p>
      </div>

      <!-- Catalog -->
      <nav class="footer-col" aria-labelledby="footer-catalog">
        <div id="footer-catalog" class="footer-heading">{t.footer.catalog}</div>
        <ul class="footer-list">
          {catalogLinks.map((l) => (
            <li><a href={l.href} class="footer-link">{l.label}</a></li>
          ))}
        </ul>
      </nav>

      <!-- Verticals -->
      <nav class="footer-col" aria-labelledby="footer-verticals">
        <div id="footer-verticals" class="footer-heading">{t.footer.verticals}</div>
        <ul class="footer-list">
          {verticals.map((v) => (
            <li>
              <a href={`/${locale}/r/${v.slug}/`} class="footer-link">
                {localizedName(v, locale)}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Build (in public) -->
      <nav class="footer-col" aria-labelledby="footer-build">
        <div id="footer-build" class="footer-heading">{t.footer.build}</div>
        <ul class="footer-list">
          {buildLinks.map((l) => (
            <li>
              <a
                href={l.href}
                class="footer-link"
                {...(l.external ? { rel: "noopener" } : {})}
              >
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Subscribe -->
      <div class="footer-col footer-subscribe" id="newsletter">
        <div class="footer-heading">{t.footer.subscribe_heading}</div>
        <p class="footer-blurb">{t.footer.subscribe_blurb}</p>
        <form
          class="subscribe-form"
          method="post"
          action="/api/subscribe"
          data-beehiiv-form
          data-source="footer"
        >
          <label class="visually-hidden" for="footer-email">
            {t.footer.subscribe_placeholder}
          </label>
          <input
            id="footer-email"
            type="email"
            name="email"
            class="subscribe-input"
            placeholder={t.footer.subscribe_placeholder}
            autocomplete="email"
            required
          />
          <button
            type="submit"
            class="subscribe-submit"
            data-label-default={t.cta.subscribe}
            data-label-loading={t.footer.subscribe_loading}
          >
            {t.cta.subscribe}
          </button>
        </form>
        <p
          class="subscribe-status"
          role="status"
          aria-live="polite"
          data-beehiiv-status
          data-msg-success={t.footer.subscribe_success}
          data-msg-error={t.footer.subscribe_error}
          data-msg-invalid-email={t.footer.subscribe_invalid_email}
          hidden
        ></p>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-bottom-left">
        <span class="footer-copyright">© {year} ooligo</span>
        <span class="footer-sep" aria-hidden="true">·</span>
        <span class="footer-license">MIT</span>
      </div>
      <div class="footer-bottom-right">
        <span class="footer-trademarks">
          Logos and trademarks are property of their respective owners.
        </span>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  // Wire any [data-beehiiv-form] on the page (footer + per-vertical pages).
  // Same-origin POST to the /api/subscribe Cloudflare Pages Function.
  (() => {
    const forms = document.querySelectorAll("form[data-beehiiv-form]");
    forms.forEach((form) => {
      const button = form.querySelector("[data-label-default]");
      const status = form.parentElement?.querySelector("[data-beehiiv-status]");
      if (!(form instanceof HTMLFormElement) || !button || !status) return;

      const labelDefault = button.getAttribute("data-label-default") || "";
      const labelLoading = button.getAttribute("data-label-loading") || labelDefault;
      const msgSuccess = status.getAttribute("data-msg-success") || "";
      const msgError = status.getAttribute("data-msg-error") || "";
      const msgInvalid = status.getAttribute("data-msg-invalid-email") || msgError;

      function showStatus(text, kind) {
        status.textContent = text;
        status.classList.remove("is-error", "is-success");
        status.classList.add(kind === "error" ? "is-error" : "is-success");
        status.hidden = false;
      }

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const data = new FormData(form);
        const email = String(data.get("email") || "").trim();

        button.disabled = true;
        button.textContent = labelLoading;
        status.hidden = true;

        try {
          const res = await fetch(form.action, {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({
              email,
              vertical: form.dataset.vertical || "global",
              source: form.dataset.source || "footer",
            }),
          });
          const json = await res.json().catch(() => ({}));

          if (res.ok && json && json.ok) {
            form.hidden = true;
            showStatus(msgSuccess, "success");
            return;
          }

          showStatus(json && json.error === "invalid_email" ? msgInvalid : msgError, "error");
        } catch {
          showStatus(msgError, "error");
        } finally {
          button.disabled = false;
          button.textContent = labelDefault;
        }
      });
    });
  })();
</script>

<style>
  .footer {
    background-color: var(--color-bg-surface-1);
    border-top: 1px solid var(--color-border-subtle);
    margin-top: 6rem;
  }

  .footer-inner {
    max-width: var(--container-app);
    margin-inline: auto;
    padding: 4rem 1.5rem 2rem;
  }
  @media (min-width: 1024px) {
    .footer-inner {
      padding: 5rem 2rem 2.5rem;
    }
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1.2fr repeat(3, 1fr) 1.4fr;
      gap: 3rem;
    }
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    min-width: 0;
  }

  .footer-tagline {
    color: var(--color-text-tertiary);
    font-size: var(--text-sm);
    line-height: 1.5;
    max-width: 28ch;
    margin: 0;
  }

  .footer-heading {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-tertiary);
  }

  .footer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-link {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    transition: color 150ms var(--ease-out-soft);
  }
  .footer-link:hover {
    color: var(--color-text-primary);
  }

  /* Subscribe block */
  .footer-blurb {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.5;
    margin: 0;
  }

  .subscribe-form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .subscribe-input {
    width: 100%;
    height: 38px;
    padding: 0 0.75rem;
    background-color: var(--color-bg-surface-2);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xs);
    color: var(--color-text-primary);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    transition: border-color 150ms var(--ease-out-soft);
  }
  .subscribe-input::placeholder {
    color: var(--color-text-tertiary);
  }
  .subscribe-input:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 1px var(--color-accent);
  }

  .subscribe-submit {
    height: 38px;
    padding: 0 0.875rem;
    background-color: var(--color-accent);
    color: var(--color-bg-canvas);
    border: 0;
    border-radius: var(--radius-xs);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    transition: background-color 150ms var(--ease-out-soft);
  }
  .subscribe-submit:hover {
    background-color: var(--color-accent-hover);
  }
  .subscribe-submit:disabled {
    cursor: not-allowed;
    opacity: 0.7;
  }

  .subscribe-status {
    margin: 0.5rem 0 0;
    font-size: var(--text-sm);
    line-height: 1.5;
  }
  .subscribe-status.is-success {
    color: var(--color-accent);
  }
  .subscribe-status.is-error {
    color: var(--color-text-secondary);
  }

  /* Bottom strip */
  .footer-bottom {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border-subtle);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    justify-content: space-between;
    align-items: flex-start;
    color: var(--color-text-tertiary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  @media (min-width: 640px) {
    .footer-bottom {
      flex-direction: row;
      align-items: center;
    }
  }

  .footer-bottom-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer-bottom-right {
    color: var(--color-text-tertiary);
  }

  .footer-trademarks {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .footer-sep {
    color: var(--color-border);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
