# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
.astro/
.output/
.vercel/
.netlify/
.wrangler/

# Generated artifact zips — built at config-load by scripts/generate-artifact-zips.mjs
apps/web/public/artifacts/*.zip

# Environment variables (NEVER commit)
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
# ...except the link-rot routine's durable record, which is meant to be committed
!content-strategy/link-rot.log

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Pipeline runtime
.cache/
.tmp/
packages/pipeline/dist/
packages/pipeline/.cache/

# Generated content drafts (drafts only — published content lives in content/)
drafts/

# Generated translation queues — rebuilt at repo root by packages/pipeline/src/translation/queue-build.ts (npm run queue:translations)
/*_TRANSLATION_QUEUE.md

# Test output
coverage/
.nyc_output/

# TypeScript
*.tsbuildinfo

# AI inference logs (may contain prompts; keep local for debugging only)
.ai-logs/
.claude/settings.local.json
__pycache__/
