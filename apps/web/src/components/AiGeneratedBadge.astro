---
/**
 * AiGeneratedBadge — transparency label.
 *
 * Treated as a brand asset, not a regulatory disclosure (DESIGN.md):
 * pinned to every tool/comparison/workflow/learn detail page so the
 * "AI-generated, AI-translated, transparently labeled" promise is
 * visible in-context. Reads the ai_generated / ai_translated frontmatter.
 *
 * Renders a small mono pill with an amber dot. Compact and unmissable.
 */

import { chromeStrings } from "~/lib/strings";
import type { LocaleCode } from "~/lib/config";

interface Props {
  generated: boolean;
  translated?: boolean;
  locale: LocaleCode;
  class?: string;
}

const {
  generated,
  translated = false,
  locale,
  class: className = "",
} = Astro.props;

// Locale-aware short labels — kept here (not strings.ts) because they're
// only used by this component and never appear in the chrome surfaces.
const labels: Record<LocaleCode, { generated: string; translated: string }> = {
  en: { generated: "AI-generated", translated: "AI-translated" },
  es: { generated: "Generado por IA", translated: "Traducido por IA" },
  "pt-BR": { generated: "Gerado por IA", translated: "Traduzido por IA" },
};
const t = labels[locale];

const parts: string[] = [];
if (generated) parts.push(t.generated);
if (translated) parts.push(t.translated);
const label = parts.join(" · ");
---

{label && (
  <span class:list={["ai-badge", className]}>
    <span class="ai-badge-dot" aria-hidden="true"></span>
    <span class="ai-badge-label">{label}</span>
  </span>
)}

<style>
  .ai-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    line-height: 1;
    white-space: nowrap;
  }

  .ai-badge-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-pill);
    background-color: var(--color-accent);
    flex-shrink: 0;
  }
</style>
