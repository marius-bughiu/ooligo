---
/**
 * ScoreBreakdownBars — horizontal bars for ooligo_score_breakdown.
 *
 * Bars not radar (DESIGN.md: ops people mistrust radar). Each row is
 * label + bar + numeric. Bar fill is accent-graded the same way as
 * ScorePill bands so a row of 9s and a row of 5s read at a glance.
 *
 * Accepts the breakdown object as-is from a tool entry; keys are
 * snake_case and rendered humanized.
 */

interface Props {
  /** e.g. { ux: 9, ai_quality: 9, pricing_value: 8, integrations: 10 } */
  breakdown: Record<string, number>;
  class?: string;
}

const { breakdown, class: className = "" } = Astro.props;
const rows = Object.entries(breakdown);

// Words that should stay all-caps (acronyms) when title-casing dimension keys.
const ACRONYMS = new Set(["ux", "ai", "mcp", "api", "crm", "roi", "kpi", "saas"]);

function humanize(key: string): string {
  return key
    .split("_")
    .map((w) =>
      ACRONYMS.has(w) ? w.toUpperCase() : w.charAt(0).toUpperCase() + w.slice(1)
    )
    .join(" ");
}

function band(v: number): "high" | "mid" | "low" {
  return v >= 9 ? "high" : v >= 7 ? "mid" : "low";
}
---

<dl class:list={["breakdown", className]}>
  {rows.map(([key, value]) => (
    <div class="breakdown-row">
      <dt class="breakdown-label">{humanize(key)}</dt>
      <dd class="breakdown-track" data-band={band(value)}>
        <div class="breakdown-fill" style={`width:${Math.max(0, Math.min(100, value * 10))}%`}></div>
      </dd>
      <dd class="breakdown-value">{value}</dd>
    </div>
  ))}
</dl>

<style>
  .breakdown {
    display: grid;
    grid-template-columns: minmax(8rem, 1fr) 2fr auto;
    column-gap: 1rem;
    row-gap: 0.625rem;
    margin: 0;
    align-items: center;
  }

  .breakdown-row {
    display: contents;
  }

  .breakdown-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    letter-spacing: 0.02em;
  }

  .breakdown-track {
    height: 6px;
    margin: 0;
    background-color: var(--color-bg-surface-2);
    border-radius: var(--radius-pill);
    overflow: hidden;
  }

  .breakdown-fill {
    height: 100%;
    background-color: var(--color-text-tertiary);
    transition: width 200ms var(--ease-out-soft);
  }

  .breakdown-track[data-band="high"] .breakdown-fill {
    background-color: var(--color-accent);
  }
  .breakdown-track[data-band="mid"] .breakdown-fill {
    background-color: var(--color-text-primary);
  }

  .breakdown-value {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-primary);
    text-align: right;
    min-width: 1.5rem;
  }
</style>
