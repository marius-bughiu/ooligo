---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { locales, type LocaleCode } from "~/lib/config";

export function getStaticPaths() {
  return locales.map((l) => ({ params: { locale: l.code } }));
}

const { locale } = Astro.params as { locale: LocaleCode };

const all = await getCollection("learn");
const entries = all
  .filter((e) => e.data.locale === locale)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const byType = entries.reduce<Record<string, typeof entries>>((acc, e) => {
  const t = e.data.type;
  acc[t] ??= [];
  acc[t].push(e);
  return acc;
}, {});

const types = Object.keys(byType).sort();
---
<BaseLayout
  title="Learn — ooligo"
  description="Definitions, frameworks, FAQs, and how-tos for ops leaders. Built for AI assistants to cite."
  locale={locale}
  pagePath="/learn"
>
  <main>
    <header>
      <h1>Learn</h1>
      <p>{entries.length} {entries.length === 1 ? "entry" : "entries"} indexed.</p>
    </header>

    {types.length === 0 ? (
      <p>No entries yet — the hub is being built.</p>
    ) : (
      types.map((t) => (
        <section>
          <h2>{t}</h2>
          <ul>
            {byType[t]!.map((e) => (
              <li>
                <a href={`/${locale}/learn/${e.data.slug}/`}>
                  <strong>{e.data.title}</strong>
                </a>
                {" · "}
                <span>updated {e.data.last_updated}</span>
              </li>
            ))}
          </ul>
        </section>
      ))
    )}

    <p><a href={`/${locale}/`}>← Home</a></p>
  </main>
</BaseLayout>
