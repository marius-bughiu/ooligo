---
/**
 * ArtifactTypeIcon — small inline glyph per workflow artifact_type.
 *
 * Each of the 7 artifact types in ARCHITECTURE.md gets a distinct
 * 16×16 outline glyph. Strokes use currentColor so the parent's
 * text color drives the icon — no per-icon recolor needed.
 *
 * artifact_type union (must stay in lockstep with content.config.ts):
 *   prompt | claude-skill | mcp-server | n8n-flow |
 *   cursor-rule | agent-template | sop
 */

import type { CollectionEntry } from "astro:content";

type ArtifactType = CollectionEntry<"workflows">["data"]["artifact_type"];

interface Props {
  type: ArtifactType;
  size?: number;
  class?: string;
}

const { type, size = 16, class: className = "" } = Astro.props;

const dim = `${size}`;
---

<span
  class:list={["artifact-icon", className]}
  style={`width:${dim}px;height:${dim}px`}
  aria-label={type}
  role="img"
>
  {type === "prompt" && (
    <svg viewBox="0 0 16 16" width={dim} height={dim} fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 3h10v8H8l-3 3v-3H3z"/>
    </svg>
  )}
  {type === "claude-skill" && (
    <svg viewBox="0 0 16 16" width={dim} height={dim} fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M8 2l5 3v6l-5 3-5-3V5z"/>
      <path d="M8 8l5-3M8 8l-5-3M8 8v6"/>
    </svg>
  )}
  {type === "mcp-server" && (
    <svg viewBox="0 0 16 16" width={dim} height={dim} fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
      <rect x="2" y="3" width="12" height="4" rx="1"/>
      <rect x="2" y="9" width="12" height="4" rx="1"/>
      <circle cx="5" cy="5" r="0.5" fill="currentColor"/>
      <circle cx="5" cy="11" r="0.5" fill="currentColor"/>
    </svg>
  )}
  {type === "n8n-flow" && (
    <svg viewBox="0 0 16 16" width={dim} height={dim} fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="3" cy="8" r="1.5"/>
      <circle cx="13" cy="4" r="1.5"/>
      <circle cx="13" cy="12" r="1.5"/>
      <path d="M4.5 8h3M9 4.5l2.5-.5M9 11.5l2.5.5"/>
      <path d="M7.5 8c1 0 1-3 2.5-3.5M7.5 8c1 0 1 3 2.5 3.5"/>
    </svg>
  )}
  {type === "cursor-rule" && (
    <svg viewBox="0 0 16 16" width={dim} height={dim} fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 3l4 11 1.7-4.3L13 8z"/>
    </svg>
  )}
  {type === "agent-template" && (
    <svg viewBox="0 0 16 16" width={dim} height={dim} fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="8" cy="6" r="3"/>
      <path d="M3 14c0-2.8 2.2-5 5-5s5 2.2 5 5"/>
    </svg>
  )}
  {type === "sop" && (
    <svg viewBox="0 0 16 16" width={dim} height={dim} fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="2" width="10" height="12" rx="1"/>
      <path d="M5.5 5.5h5M5.5 8h5M5.5 10.5h3"/>
    </svg>
  )}
</span>

<style>
  .artifact-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-secondary);
    flex-shrink: 0;
  }
</style>
