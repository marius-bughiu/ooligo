---
/**
 * SponsoredAdSlot — labeled in-content AdSense slot.
 *
 * Sibling pattern to AiGeneratedBadge: a transparency-first wrapper
 * around external content. Mirrors the same chrome (mono uppercase
 * label, amber 6px dot, surface-1, border-subtle) so the slot reads
 * as "labeled non-canonical content" rather than a marketing CTA.
 *
 * Renders nothing if AdSense env config is missing — lets ads stay
 * dark on dev/preview/missing-env builds without conditional usage
 * at the call site.
 *
 * Use as a top-level Section child on detail pages where placement
 * has been approved (learn/[slug], vs/[slug]). Do NOT scatter; one
 * slot per page is the design constraint.
 */

import { ADSENSE_CLIENT, type LocaleCode } from "~/lib/config";

interface Props {
  /** AdSense ad-unit slot ID (10-digit). If null, component renders nothing. */
  slot: string | null;
  /** Override the publisher client; defaults to ADSENSE_CLIENT from env. */
  client?: string | null;
  /** Locale — used to localize the "Sponsored" label. */
  locale: LocaleCode;
  class?: string;
}

const { slot, client = ADSENSE_CLIENT, locale, class: className = "" } = Astro.props;

const enabled = Boolean(slot && client);

// Locale-aware short labels. Only the dropped locales fall back to en.
// Kept here (not strings.ts) because they're component-local.
const labels: Partial<Record<LocaleCode, string>> & { en: string } = {
  en: "Sponsored · Ad",
  es: "Patrocinado · Anuncio",
  "pt-BR": "Patrocinado · Anúncio",
  ja: "広告 · スポンサー",
  ru: "Реклама",
  ro: "Sponsorizat · Reclamă",
  fr: "Sponsorisé · Annonce",
  de: "Gesponsert · Anzeige",
  "zh-CN": "赞助 · 广告",
  ko: "스폰서 · 광고",
  ar: "إعلان · ممول",
};
const label = labels[locale] ?? labels.en;
---

{enabled && (
  <aside class:list={["sponsored-ad-slot", className]} aria-label={label}>
    <div class="sponsored-ad-label">
      <span class="sponsored-ad-dot" aria-hidden="true"></span>
      <span class="sponsored-ad-text">{label}</span>
    </div>
    <div class="sponsored-ad-frame">
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={client}
        data-ad-slot={slot}
        data-ad-format="fluid"
        data-ad-layout="in-article"
      ></ins>
    </div>
    <script is:inline>
      (window.adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </aside>
)}

<style>
  .sponsored-ad-slot {
    display: block;
    background-color: var(--color-bg-surface-1);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    padding: 1.25rem 1.5rem;
  }

  .sponsored-ad-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-block-end: 0.875rem;
    /* Logical properties so the label flips correctly under dir="rtl"
       (Arabic locale): dot lands on the right, text reads RTL. */
    padding-inline-start: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    line-height: 1;
  }

  .sponsored-ad-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-pill);
    background-color: var(--color-accent);
    flex-shrink: 0;
  }

  .sponsored-ad-text {
    white-space: nowrap;
  }

  /* Inner frame contains the AdSense iframe. overflow:hidden + radius
     stop creatives from bleeding past the surface. min-height holds
     vertical rhythm when AdSense returns no-fill. */
  .sponsored-ad-frame {
    overflow: hidden;
    border-radius: var(--radius-xs);
    min-height: 280px;
  }

  .sponsored-ad-frame :global(.adsbygoogle) {
    display: block;
    min-height: 280px;
  }
</style>
