---
import BaseLayout from "~/layouts/BaseLayout.astro";
import LegalPageView from "~/components/LegalPageView.astro";
import { locales, REPO_URL, type LocaleCode } from "~/lib/config";
import { contactPage, lastUpdatedLabel } from "~/lib/legalStrings";

export function getStaticPaths() {
  return locales.map((l) => ({ params: { locale: l.code } }));
}

const { locale } = Astro.params as { locale: LocaleCode };
const page = contactPage(locale);
const issuesUrl = `${REPO_URL}/issues`;
---

<BaseLayout
  title={page.title}
  description={page.description}
  locale={locale}
  pagePath="/contact"
>
  <main id="main">
    <LegalPageView
      page={page}
      locale={locale}
      breadcrumbKey="contact"
      lastUpdatedLabel={lastUpdatedLabel(locale)}
    >
      <p class="contact-github">
        <a class="contact-github-link" href={issuesUrl} rel="noopener">
          {page.githubLinkLabel}
        </a>
      </p>
    </LegalPageView>
  </main>
</BaseLayout>

<style>
  .contact-github {
    margin: 2rem 0 0;
    font-size: var(--text-base);
  }
  .contact-github-link {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: color-mix(
      in oklab,
      var(--color-accent) 35%,
      transparent
    );
    text-underline-offset: 3px;
    font-weight: 600;
  }
  .contact-github-link:hover {
    text-decoration-color: var(--color-accent);
  }
</style>
