---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { locales, type LocaleCode } from "~/lib/config";

export function getStaticPaths() {
  return locales.map((l) => ({ params: { locale: l.code } }));
}

const { locale } = Astro.params as { locale: LocaleCode };
---
<BaseLayout
  title="Learn — ooligo"
  description="AEO-optimized FAQ, glossary, and frameworks for ops leaders."
  locale={locale}
  pagePath="/learn"
>
  <main>
    <h1>Learn</h1>
    <p>FAQ, glossary, and frameworks targeted for citation by ChatGPT, Claude, Perplexity. Lands in Phase 1.</p>
    <p><a href={`/${locale}/`}>← Home</a></p>
  </main>
</BaseLayout>
