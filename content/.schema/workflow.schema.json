{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ooligo/workflow.schema.json",
  "title": "Workflow entry frontmatter",
  "type": "object",
  "required": [
    "slug",
    "canonical_slug",
    "locale",
    "verticals",
    "title",
    "artifact_type",
    "tools_used",
    "roles",
    "difficulty",
    "last_updated"
  ],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "canonical_slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "locale": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
    "verticals": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "minItems": 1
    },
    "title": { "type": "string", "minLength": 1 },
    "artifact_type": {
      "type": "string",
      "enum": ["prompt", "claude-skill", "mcp-server", "n8n-flow", "cursor-rule", "agent-template", "sop"]
    },
    "tools_used": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "minItems": 1
    },
    "roles": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "minItems": 1
    },
    "difficulty": { "type": "string", "enum": ["beginner", "intermediate", "advanced"] },
    "last_updated": { "type": "string", "format": "date" },
    "time_to_setup": { "type": "string" },
    "download_url": { "type": "string" },
    "preview_lang": { "type": "string" },
    "human_tested": { "type": "boolean" },
    "translated_from": { "type": "string" },
    "translated_at": { "type": "string", "format": "date-time" },
    "translation_model": { "type": "string" },
    "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
