---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { locales, type LocaleCode } from "~/lib/config";

export function getStaticPaths() {
  return locales.map((l) => ({ params: { locale: l.code } }));
}

const { locale } = Astro.params as { locale: LocaleCode };
---
<BaseLayout
  title="Comparisons — ooligo"
  description="Side-by-side comparisons, alternatives, and category roundups."
  locale={locale}
  pagePath="/vs"
>
  <main>
    <h1>Comparisons</h1>
    <p>Pairwise comparisons, alternatives, and category roundups land in Phase 1.</p>
    <p><a href={`/${locale}/`}>← Home</a></p>
  </main>
</BaseLayout>
