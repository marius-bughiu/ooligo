---
/**
 * CapabilityChip — outlined uppercase label.
 *
 * AI-NATIVE / MCP / API / FREE-TIER and similar binary capability tags.
 * Monochrome by default; pass variant="accent" for the brand-essential
 * AI-NATIVE chip on tool detail headers.
 */

interface Props {
  label: string;
  variant?: "default" | "accent";
  size?: "sm" | "md";
  class?: string;
}

const {
  label,
  variant = "default",
  size = "sm",
  class: className = "",
} = Astro.props;
---

<span
  class:list={[
    "chip",
    `chip-${variant}`,
    `chip-${size}`,
    className,
  ]}
>
  {label}
</span>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xs);
    color: var(--color-text-secondary);
    background-color: transparent;
    white-space: nowrap;
  }

  .chip-sm {
    padding: 0.25rem 0.4rem;
    font-size: 0.6875rem; /* 11px */
  }
  .chip-md {
    padding: 0.375rem 0.6rem;
    font-size: var(--text-xs);
  }

  .chip-accent {
    color: var(--color-accent);
    border-color: color-mix(in oklab, var(--color-accent) 35%, var(--color-border-subtle));
    background-color: color-mix(in oklab, var(--color-accent) 8%, transparent);
  }
</style>
