---
/**
 * ToolIcon — vendor favicon with monogram fallback.
 *
 * Used wherever a tool needs a visual identifier (workflow cards, stack
 * rows). When a local icon exists at /tool-icons/<slug>.<ext> (populated
 * by scripts/sync-tool-icons.mjs), renders it inside a uniform light
 * plate so dark-on-white logos remain legible against the dark canvas.
 * Otherwise falls back to ToolMonogram.
 *
 * Vendor logos render in their native brand colors — this is an
 * explicit carve-out from the locked amber-mono design system, scoped
 * to tool identification on listing surfaces.
 */
import ToolMonogram from "./ToolMonogram.astro";
import { getToolIconPath } from "~/lib/toolIcons";

interface Props {
  slug: string;
  name: string;
  size?: number;
  /** Forwarded to monogram fallback only; icon plate ignores it. */
  outlined?: boolean;
  class?: string;
}

const {
  slug,
  name,
  size = 32,
  outlined = false,
  class: className = "",
} = Astro.props;

const iconPath = getToolIconPath(slug);
---

{iconPath ? (
  <span
    class:list={["tool-icon", className]}
    style={`width:${size}px;height:${size}px`}
    aria-label={name}
    role="img"
  >
    <img
      src={iconPath}
      alt=""
      width={size}
      height={size}
      loading="lazy"
      decoding="async"
    />
  </span>
) : (
  <ToolMonogram name={name} size={size} outlined={outlined} class={className} />
)}

<style>
  .tool-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background-color: #f5f5f7;
    border-radius: var(--radius-xs);
    overflow: hidden;
    user-select: none;
    box-sizing: border-box;
  }
  .tool-icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
