    transition: transform 150ms var(--ease-out-soft);
  }
  @media (min-width: 1024px) {
    .filter-rail-heading {
      border: 0;
      background: transparent;
      padding: 0 0 1rem 0;
    }
    .filter-rail-heading svg {
      display: none;
    }
  }

  .filter-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 1rem;
    padding: 0 0.25rem;
  }
  @media (min-width: 1024px) {
    .filter-form {
      margin-top: 0;
      padding: 0;
    }
  }

  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .filter-legend {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-tertiary);
    margin-bottom: 0.25rem;
    padding: 0;
  }

  .filter-check {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    transition: color 150ms var(--ease-out-soft);
  }
  .filter-check:hover {
