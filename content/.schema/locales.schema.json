{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ooligo/locales.schema.json",
  "title": "Locales configuration",
  "type": "object",
  "required": ["default_locale", "locales"],
  "properties": {
    "default_locale": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
    "locales": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "name", "native_name", "hreflang", "rtl", "is_canonical", "launch_phase"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
          "name": { "type": "string" },
          "native_name": { "type": "string" },
          "hreflang": { "type": "string" },
          "rtl": { "type": "boolean" },
          "is_canonical": { "type": "boolean" },
          "translated_from": {
            "oneOf": [
              { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
              { "type": "null" }
            ]
          },
          "launch_phase": { "type": "integer", "minimum": 1 },
          "regional_target": { "type": "string" }
        }
      }
    }
  }
}
