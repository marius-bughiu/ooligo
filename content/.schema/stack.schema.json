{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ooligo/stack.schema.json",
  "title": "Stack entry frontmatter",
  "type": "object",
  "required": ["slug", "canonical_slug", "locale", "verticals", "title", "tools", "use_case", "difficulty", "ai_generated"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "canonical_slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "locale": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
    "verticals": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "minItems": 1
    },
    "title": { "type": "string", "minLength": 1 },
    "tools": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "minItems": 2
    },
    "use_case": { "type": "string" },
    "difficulty": { "type": "string", "enum": ["beginner", "intermediate", "advanced"] },
    "related_workflows": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "ai_generated": { "type": "boolean" },
    "ai_translated": { "type": "boolean" },
    "translated_from": { "type": "string" },
    "translated_at": { "type": "string", "format": "date-time" },
    "translation_model": { "type": "string" }
  }
}
