{
  "name": "Hiring funnel alerts — staged Ashby aggregates",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 2 * * *"
            }
          ]
        }
      },
      "id": "27bdd6e0-863f-5bf4-92c4-d030d2585078",
      "name": "Stage detector at 02 UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT hfa.detect_stages($1::date) AS newly_queued;",
        "options": {
          "queryReplacement": "={{ [$now.toUTC().toISODate()] }}",
          "queryBatching": "independently"
        }
      },
      "id": "e42a57ed-13c1-5614-964d-f15b1c6aeed9",
      "name": "Queue stage alerts",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        250,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER_POSTGRES_ID",
          "name": "Postgres — hiring detector"
        }
      }
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 3 * * *"
            }
          ]
        }
      },
      "id": "3b70fc60-7c88-53ce-bb68-b310ea08e1de",
      "name": "Hire trend at 03 UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT hfa.detect_tth($1::date) AS newly_queued;",
        "options": {
          "queryReplacement": "={{ [$now.toUTC().toISODate()] }}",
          "queryBatching": "independently"
        }
      },
      "id": "2f3da57f-9bdb-5938-85aa-7d2d65b26bfd",
      "name": "Queue hire alerts",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        250,
        200
      ],
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER_POSTGRES_ID",
          "name": "Postgres — hiring detector"
        }
      }
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/15 * * * *"
            }
          ]
        }
      },
      "id": "65370272-83b9-5439-84f3-2d513bcb4154",
      "name": "Drain outbox every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        250,
        400
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM hfa.claim_pending($1::text);",
        "options": {
          "queryReplacement": "={{ [String($execution.id)] }}",
          "queryBatching": "independently"
        }
      },
      "id": "1eca594e-c98a-5f53-a04b-81d72914d6b6",
      "name": "Claim one pending alert",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        500,
        180
      ],
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER_POSTGRES_ID",
          "name": "Postgres — hiring detector"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const channel = $json.route === 'leadership' ? 'REPLACE_LEADERSHIP_CHANNEL_ID' : 'REPLACE_STAGE_CHANNEL_ID';\nif (channel.startsWith('REPLACE_')) throw new Error('Set both Slack channel IDs before delivery');\nreturn {json: {...$json, channel}};"
      },
      "id": "b072ce75-f421-5a92-91a4-e795a9b71cd3",
      "name": "Check channel configuration",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        180
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({model:'claude-haiku-5-5',max_tokens:120,system:'Summarize this aggregate recruiting metric in one sentence. Use only supplied observations. Do not infer causes or recommend action on an individual.',messages:[{role:'user',content:JSON.stringify($json.payload)}]}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "4e21da25-fc16-5103-95b6-3cb3b3fae8b8",
      "name": "Claude aggregate explanation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        930,
        180
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "PLACEHOLDER_HTTPHEADERAUTH_ID",
          "name": "Anthropic — x-api-key"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const claim = $('Check channel configuration').item.json;\nconst value = claim.payload;\nconst narrative = ($json.content || []).filter(part => part.type === 'text').map(part => part.text).join(' ').trim();\nif (!narrative) throw new Error('No Claude explanation; lease will expire before another attempt');\nconst channel = claim.channel;\nconst summary = [value.kind, value.role, value.stage].filter(Boolean).join(' / ');\nconst reference = value.reference == null ? '' : `, reference ${value.reference}`;\nconst text = `${summary} (${value.as_of} UTC)\\nObserved ${value.observed}${reference}, ${value.unit}. Sample: ${value.sample_size}.\\n${narrative}\\nRef ${claim.alert_key}`;\nreturn {json: {alert_key: claim.alert_key, lease_token: claim.lease_token, body: {channel, text, mrkdwn:false, unfurl_links:false, unfurl_media:false}}};"
      },
      "id": "32722210-3899-57f3-b521-2c5f175e60c8",
      "name": "Prepare Slack message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1140,
        180
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT hfa.begin_send($1::text,$2::text) AS alert_key;",
        "options": {
          "queryReplacement": "={{ [$json.alert_key, $json.lease_token] }}",
          "queryBatching": "independently"
        }
      },
      "id": "5a2c85a3-7022-5bac-a0fe-ece88edce1e8",
      "name": "Record send attempt",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1350,
        180
      ],
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER_POSTGRES_ID",
          "name": "Postgres — hiring detector"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://slack.com/api/chat.postMessage",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": false,
        "headerParameters": {
          "parameters": []
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Prepare Slack message').item.json.body) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "626416de-52fe-5e8d-b288-53b6c9ee2eee",
      "name": "Post Slack message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        180
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "PLACEHOLDER_HTTPHEADERAUTH_ID",
          "name": "Slack — Authorization"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT hfa.finish_send($1::text,$2::text,$3::jsonb) AS delivery_state;",
        "options": {
          "queryReplacement": "={{ [$('Prepare Slack message').item.json.alert_key, $('Prepare Slack message').item.json.lease_token, JSON.stringify($json)] }}",
          "queryBatching": "independently"
        }
      },
      "id": "e93925d3-b78e-58dd-8456-0a3a77c68e19",
      "name": "Persist Slack acknowledgement",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1770,
        180
      ],
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER_POSTGRES_ID",
          "name": "Postgres — hiring detector"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if ($json.delivery_state !== 'delivered') throw new Error(`Slack delivery ${$json.delivery_state}; inspect hfa.alerts`);\nreturn {json: {delivery_state: 'delivered'}};"
      },
      "id": "0e4f4b26-0b61-5474-9cb7-10ac237ec72a",
      "name": "Check delivery state",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        180
      ]
    }
  ],
