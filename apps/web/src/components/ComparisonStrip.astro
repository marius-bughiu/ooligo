---
/**
 * ComparisonStrip — `A vs B` index cell.
 *
 * Three flavors matching the comparison entity's `type`:
 *   pairwise     → two monograms side-by-side with "vs" label
 *   roundup      → category roundup pill (first 3 monograms + "+N")
 *   alternatives → "alternatives to" with the focal tool monogram
 *
 * Caller resolves tool slugs to names so the strip doesn't re-resolve
 * on every paint.
 */

import type { CollectionEntry } from "astro:content";
import ToolIcon from "./ToolIcon.astro";
import type { LocaleCode } from "~/lib/config";

type ComparisonData = CollectionEntry<"comparisons">["data"];

interface Props {
  comparison: ComparisonData;
  toolNames: Record<string, string>;
  locale: LocaleCode;
  class?: string;
}

const { comparison, toolNames, locale, class: className = "" } = Astro.props;

const resolve = (slug: string) => toolNames[slug] ?? slug;

const pairwiseTools =
  comparison.type === "pairwise"
    ? [comparison.tool_a!, comparison.tool_b!]
    : [];

const roundupTools = comparison.type !== "pairwise" ? comparison.tools ?? [] : [];
const roundupShown = roundupTools.slice(0, 3);
const roundupOverflow = Math.max(0, roundupTools.length - roundupShown.length);

let title: string;
if (comparison.type === "pairwise" && pairwiseTools.length === 2) {
  title = `${resolve(pairwiseTools[0]!)} vs ${resolve(pairwiseTools[1]!)}`;
} else if (comparison.type === "alternatives" && roundupTools.length > 0) {
  title = `Alternatives to ${resolve(roundupTools[0]!)}`;
} else {
  title = comparison.slug.replace(/-/g, " ");
}
---

<a
  href={`/${locale}/vs/${comparison.slug}/`}
  class:list={["vs-strip", `vs-strip-${comparison.type}`, className]}
>
  <div class="vs-strip-visual">
    {comparison.type === "pairwise" && (
      <>
        <ToolIcon slug={pairwiseTools[0]!} name={resolve(pairwiseTools[0]!)} size={32} />
        <span class="vs-strip-vs" aria-hidden="true">vs</span>
        <ToolIcon slug={pairwiseTools[1]!} name={resolve(pairwiseTools[1]!)} size={32} />
      </>
    )}
    {comparison.type !== "pairwise" && (
      <div class="vs-strip-stack">
        {roundupShown.map((slug) => (
          <ToolIcon slug={slug} name={resolve(slug)} size={28} outlined />
        ))}
        {roundupOverflow > 0 && (
          <span class="vs-strip-overflow">+{roundupOverflow}</span>
        )}
      </div>
    )}
  </div>

  <div class="vs-strip-body">
    <h3 class="vs-strip-title">{title}</h3>
    <div class="vs-strip-meta">
      <span class="vs-strip-type">{comparison.type}</span>
      <span class="vs-strip-sep" aria-hidden="true">·</span>
      <span class="vs-strip-date">updated {comparison.last_updated}</span>
    </div>
  </div>
</a>

<style>
  .vs-strip {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: center;
    padding: 1rem;
    background-color: var(--color-bg-surface-1);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    color: var(--color-text-primary);
    transition: border-color 150ms var(--ease-out-soft),
      background-color 150ms var(--ease-out-soft);
  }
  .vs-strip:hover {
    border-color: var(--color-border);
    background-color: var(--color-bg-surface-2);
  }

  .vs-strip-visual {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .vs-strip-vs {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .vs-strip-stack {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .vs-strip-overflow {
    display: inline-flex;
    align-items: center;
    height: 28px;
    padding: 0 0.45rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    border: 1px dashed var(--color-border-subtle);
    border-radius: var(--radius-xs);
  }

  .vs-strip-body {
    min-width: 0;
  }

  .vs-strip-title {
    margin: 0;
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .vs-strip-meta {
    margin-top: 0.25rem;
    display: flex;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }
  .vs-strip-type {
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .vs-strip-sep {
    color: var(--color-border);
  }
</style>
