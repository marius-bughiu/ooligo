---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Container from "~/components/Container.astro";
import Section from "~/components/Section.astro";
import ToolCard from "~/components/ToolCard.astro";
import EmptyState from "~/components/EmptyState.astro";
import {
  locales,
  verticals,
  localizedName,
  localeText,
  type LocaleCode,
} from "~/lib/config";
import { chromeStrings } from "~/lib/strings";

export function getStaticPaths() {
  return locales.map((l) => ({ params: { locale: l.code } }));
}

const { locale } = Astro.params as { locale: LocaleCode };
const chrome = chromeStrings(locale);

// Locale-aware filter labels — kept inline because they're tools-specific.
const labels = {
  en: {
    title: "Tools",
    sub: "AI tools, MCP servers, agents, GPTs, and plugins indexed for ops teams.",
    count_one: "tool indexed",
    count_many: "tools indexed",
    filter_heading: "Filter",
    filter_vertical: "Vertical",
    filter_category: "Category",
    filter_capabilities: "Capabilities",
    filter_pricing: "Pricing model",
    filter_all_categories: "All categories",
    filter_all_pricing: "All pricing",
    filter_reset: "Reset",
    cap_ai_native: "AI-native",
    cap_mcp: "MCP server",
    cap_api: "Public API",
    empty_title: "No tools match",
    empty_message: "Try removing a filter or two.",
    empty_action: "Clear filters",
    pre_launch_title: "Catalog still being built",
    pre_launch_message:
      "First tool entries land as the AI content pipeline runs. Check back, or watch the repo for live updates.",
  },
  es: {
    title: "Herramientas",
    sub: "Herramientas de IA, servidores MCP, agentes, GPTs y plugins indexados para equipos de operaciones.",
    count_one: "herramienta indexada",
    count_many: "herramientas indexadas",
    filter_heading: "Filtrar",
    filter_vertical: "Vertical",
    filter_category: "Categoría",
    filter_capabilities: "Capacidades",
    filter_pricing: "Modelo de precios",
    filter_all_categories: "Todas las categorías",
    filter_all_pricing: "Todos los precios",
    filter_reset: "Restablecer",
    cap_ai_native: "AI-native",
    cap_mcp: "Servidor MCP",
    cap_api: "API pública",
    empty_title: "Ninguna herramienta coincide",
    empty_message: "Prueba a quitar un filtro o dos.",
    empty_action: "Limpiar filtros",
    pre_launch_title: "Catálogo en construcción",
    pre_launch_message:
      "Las primeras herramientas se publican a medida que se ejecuta el pipeline de IA. Vuelve pronto o sigue el repo para novedades.",
  },
  "pt-BR": {
    title: "Ferramentas",
    sub: "Ferramentas de IA, servidores MCP, agentes, GPTs e plugins indexados para times de operações.",
    count_one: "ferramenta indexada",
    count_many: "ferramentas indexadas",
    filter_heading: "Filtrar",
    filter_vertical: "Vertical",
    filter_category: "Categoria",
    filter_capabilities: "Capacidades",
    filter_pricing: "Modelo de preço",
    filter_all_categories: "Todas as categorias",
    filter_all_pricing: "Todos os preços",
    filter_reset: "Redefinir",
    cap_ai_native: "AI-native",
    cap_mcp: "Servidor MCP",
    cap_api: "API pública",
    empty_title: "Nenhuma ferramenta encontrada",
    empty_message: "Tente remover um filtro ou dois.",
    empty_action: "Limpar filtros",
    pre_launch_title: "Catálogo em construção",
    pre_launch_message:
      "As primeiras ferramentas serão publicadas conforme o pipeline de IA roda. Volte em breve ou acompanhe o repo.",
  },
} as const;

const t = localeText(labels, locale);

const allTools = await getCollection("tools");
const tools = allTools
  .filter((tool) => tool.data.locale === locale)
  .sort((a, b) => a.data.name.localeCompare(b.data.name));

const categories = [...new Set(tools.map((tool) => tool.data.category))].sort();
const pricingModels = [
  ...new Set(tools.map((tool) => tool.data.pricing_model)),
].sort();
---

<BaseLayout
  title={`${t.title} — ooligo`}
  description={t.sub}
  locale={locale}
  pagePath="/tools"
>
  <main id="main">
    <Section density="md">
      <Container>
        <header class="page-header">
          <div class="page-header-text">
            <h1 class="page-title">{t.title}</h1>
            <p class="page-sub">
              <span id="result-count" class="page-count" data-singular={t.count_one} data-plural={t.count_many}>
                {tools.length}
              </span>
              {" "}
              <span id="result-count-label">
                {tools.length === 1 ? t.count_one : t.count_many}
              </span>
              {" · "}
              {t.sub}
            </p>
          </div>
        </header>

        {tools.length === 0 ? (
          <EmptyState
            title={t.pre_launch_title}
            message={t.pre_launch_message}
            action={{ label: chrome.cta.github, href: "https://github.com/marius-bughiu/ooligo" }}
          />
        ) : (
          <div class="index-layout">
            <!-- ============ FILTER RAIL ============ -->
            <aside class="filter-rail" aria-label={t.filter_heading}>
              <details class="filter-details" open>
                <summary class="filter-rail-heading">
                  <span>{t.filter_heading}</span>
                  <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
                    <path d="M2 4l3 3 3-3" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </summary>

                <form id="filter-form" class="filter-form">
                  <fieldset class="filter-group">
                    <legend class="filter-legend">{t.filter_vertical}</legend>
                    {verticals.map((v) => (
                      <label class="filter-check">
                        <input type="checkbox" name="vertical" value={v.slug} />
                        <span class="filter-check-mark" aria-hidden="true"></span>
                        <span class="filter-check-label">
                          {localizedName(v, locale)}
                        </span>
                      </label>
                    ))}
                  </fieldset>

                  <fieldset class="filter-group">
                    <legend class="filter-legend">{t.filter_category}</legend>
                    <label class="filter-select-wrap">
                      <select name="category" class="filter-select">
                        <option value="">{t.filter_all_categories}</option>
                        {categories.map((cat) => (
                          <option value={cat}>{cat}</option>
                        ))}
                      </select>
                    </label>
                  </fieldset>

                  <fieldset class="filter-group">
                    <legend class="filter-legend">{t.filter_capabilities}</legend>
                    <label class="filter-check">
                      <input type="checkbox" name="cap" value="ai-native" />
                      <span class="filter-check-mark" aria-hidden="true"></span>
                      <span class="filter-check-label">{t.cap_ai_native}</span>
                    </label>
                    <label class="filter-check">
                      <input type="checkbox" name="cap" value="mcp" />
                      <span class="filter-check-mark" aria-hidden="true"></span>
                      <span class="filter-check-label">{t.cap_mcp}</span>
                    </label>
                    <label class="filter-check">
                      <input type="checkbox" name="cap" value="api" />
                      <span class="filter-check-mark" aria-hidden="true"></span>
                      <span class="filter-check-label">{t.cap_api}</span>
                    </label>
                  </fieldset>

                  <fieldset class="filter-group">
                    <legend class="filter-legend">{t.filter_pricing}</legend>
                    <label class="filter-select-wrap">
                      <select name="pricing" class="filter-select">
                        <option value="">{t.filter_all_pricing}</option>
                        {pricingModels.map((m) => (
                          <option value={m}>{m}</option>
                        ))}
                      </select>
                    </label>
                  </fieldset>

                  <button type="reset" class="filter-reset">{t.filter_reset}</button>
                </form>
              </details>
            </aside>

            <!-- ============ RESULTS ============ -->
            <div class="results-area">
              <div id="results" class="card-grid card-grid-3">
                {tools.map((tool) => (
                  <article
                    class="result-item"
                    data-verticals={tool.data.verticals.join(",")}
                    data-category={tool.data.category}
                    data-ai-native={String(tool.data.ai_native)}
                    data-mcp={String(tool.data.mcp_available ?? false)}
                    data-api={String(tool.data.api_available ?? false)}
                    data-pricing={tool.data.pricing_model}
                  >
                    <ToolCard tool={tool.data} locale={locale} />
                  </article>
                ))}
              </div>

              <div id="empty-results" class="empty-results" hidden>
                <EmptyState
                  title={t.empty_title}
                  message={t.empty_message}
                />
              </div>
            </div>
          </div>
        )}
      </Container>
    </Section>
  </main>
</BaseLayout>

<script is:inline>
  // Client-side filter for the tools index. Runs once on DOMContentLoaded
  // and again on every form change. No framework — pure DOM.
  (() => {
    const form = document.getElementById("filter-form");
    if (!form) return;

    const items = /** @type {NodeListOf<HTMLElement>} */ (
      document.querySelectorAll(".result-item")
    );
    const empty = document.getElementById("empty-results");
    const count = document.getElementById("result-count");
    const countLabel = document.getElementById("result-count-label");
    const totalAll = items.length;

    function readMulti(name) {
      return [...form.querySelectorAll(`input[name="${name}"]:checked`)].map(
        (i) => /** @type {HTMLInputElement} */ (i).value
      );
    }
    function readSelect(name) {
      const el = /** @type {HTMLSelectElement} */ (form.querySelector(`[name="${name}"]`));
      return el ? el.value : "";
    }

    function apply() {
      const fv = readMulti("vertical");
      const fcat = readSelect("category");
      const fcaps = readMulti("cap");
      const fpricing = readSelect("pricing");

      let visible = 0;
      items.forEach((item) => {
        const verts = (item.dataset.verticals ?? "").split(",").filter(Boolean);
        const matchVertical = fv.length === 0 || fv.some((v) => verts.includes(v));
        const matchCategory = !fcat || item.dataset.category === fcat;
        const matchPricing = !fpricing || item.dataset.pricing === fpricing;
        const matchCaps = fcaps.every((cap) => {
          if (cap === "ai-native") return item.dataset.aiNative === "true";
          if (cap === "mcp") return item.dataset.mcp === "true";
          if (cap === "api") return item.dataset.api === "true";
          return true;
        });
        const show = matchVertical && matchCategory && matchPricing && matchCaps;
        item.hidden = !show;
        if (show) visible++;
      });

      if (empty) empty.hidden = visible > 0;
      if (count) count.textContent = String(visible);
      if (countLabel && count) {
        const sing = count.dataset.singular ?? "";
        const plur = count.dataset.plural ?? "";
        countLabel.textContent = visible === 1 ? sing : plur;
      }
    }

    form.addEventListener("change", apply);
    // <input type="reset"> dispatches a "reset" event BEFORE values change;
    // wait one frame so the form is actually cleared.
    form.addEventListener("reset", () => requestAnimationFrame(apply));

    // Initial pass — keeps DOM and counter in sync if browsers restored state.
    apply();
  })();
</script>

<style>
  .page-header {
    margin-bottom: 2rem;
  }

  .page-title {
    margin: 0;
    font-size: var(--text-3xl);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .page-sub {
    margin: 0.875rem 0 0;
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    line-height: 1.5;
    max-width: 60ch;
  }

  .page-count {
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--color-text-primary);
  }

  /* ============ INDEX LAYOUT ============ */
  .index-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 1024px) {
    .index-layout {
      grid-template-columns: 14rem 1fr;
      gap: 2.5rem;
    }
  }

  /* ============ FILTER RAIL ============ */
  .filter-rail {
    min-width: 0;
  }
  @media (min-width: 1024px) {
    .filter-rail {
      position: sticky;
      top: calc(64px + 1.5rem);
      align-self: start;
      max-height: calc(100vh - 96px);
      overflow-y: auto;
    }
  }

  .filter-details > summary {
    list-style: none;
    cursor: pointer;
    user-select: none;
  }
  .filter-details > summary::-webkit-details-marker {
    display: none;
  }
  @media (min-width: 1024px) {
    .filter-details > summary {
      cursor: default;
    }
  }

  .filter-rail-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    background-color: var(--color-bg-surface-1);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-tertiary);
  }
  .filter-details[open] > .filter-rail-heading svg {
    transform: rotate(180deg);
  }
  .filter-rail-heading svg {
    transition: transform 150ms var(--ease-out-soft);
    color: var(--color-text-tertiary);
  }
  @media (min-width: 1024px) {
    .filter-rail-heading {
      border: 0;
      background: transparent;
      padding: 0 0 1rem 0;
    }
    .filter-rail-heading svg {
      display: none;
    }
  }

  .filter-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 1rem;
    padding: 0 0.25rem;
  }
  @media (min-width: 1024px) {
    .filter-form {
      margin-top: 0;
      padding: 0;
    }
  }

  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .filter-legend {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-tertiary);
    margin-bottom: 0.25rem;
    padding: 0;
  }

  .filter-check {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    transition: color 150ms var(--ease-out-soft);
  }
  .filter-check:hover {
    color: var(--color-text-primary);
  }

  .filter-check input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .filter-check-mark {
    width: 14px;
    height: 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    background-color: var(--color-bg-surface-1);
    flex-shrink: 0;
    position: relative;
    transition: background-color 150ms var(--ease-out-soft),
      border-color 150ms var(--ease-out-soft);
  }
  .filter-check input:checked + .filter-check-mark {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .filter-check input:checked + .filter-check-mark::after {
    content: "";
    position: absolute;
    inset: 2px;
    background-color: var(--color-bg-canvas);
    clip-path: polygon(20% 50%, 0 70%, 40% 100%, 100% 30%, 80% 10%, 40% 70%);
  }
  .filter-check input:focus-visible + .filter-check-mark {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .filter-select-wrap {
    display: block;
    position: relative;
  }
  .filter-select {
    width: 100%;
    height: 36px;
    padding: 0 2rem 0 0.75rem;
    background-color: var(--color-bg-surface-1);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xs);
    color: var(--color-text-primary);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    appearance: none;
    cursor: pointer;
    transition: border-color 150ms var(--ease-out-soft);
  }
  .filter-select:hover {
    border-color: var(--color-border);
  }
  .filter-select:focus-visible {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 1px var(--color-accent);
  }
  .filter-select-wrap::after {
    content: "▾";
    position: absolute;
    right: 0.625rem;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: var(--color-text-tertiary);
    font-size: var(--text-xs);
  }

  .filter-reset {
    align-self: flex-start;
    padding: 0.5rem 0.75rem;
    background: transparent;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xs);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-tertiary);
    cursor: pointer;
    transition: color 150ms var(--ease-out-soft),
      border-color 150ms var(--ease-out-soft);
  }
  .filter-reset:hover {
    color: var(--color-text-primary);
    border-color: var(--color-border);
  }

  /* ============ RESULTS ============ */
  .results-area {
    min-width: 0;
  }

  .card-grid {
    display: grid;
    gap: 0.875rem;
  }
  .card-grid-3 {
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .card-grid-3 {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1280px) {
    .card-grid-3 {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .empty-results {
    margin-top: 1rem;
  }
</style>
