{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ooligo/tool.schema.json",
  "title": "Tool entry frontmatter",
  "type": "object",
  "required": [
    "slug",
    "canonical_slug",
    "locale",
    "verticals",
    "name",
    "category",
    "pricing_model",
    "website",
    "ai_native",
    "last_reviewed",
    "ai_generated"
  ],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "canonical_slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "locale": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
    "verticals": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "minItems": 1
    },
    "name": { "type": "string", "minLength": 1 },
    "category": { "type": "string" },
    "subcategories": { "type": "array", "items": { "type": "string" } },
    "pricing_model": {
      "type": "string",
      "enum": ["free", "freemium", "flat", "usage-based", "custom"]
    },
    "pricing_starts_at": {
      "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
    },
    "pricing_url": { "type": "string", "format": "uri" },
    "website": { "type": "string", "format": "uri" },
    "ai_native": { "type": "boolean" },
    "mcp_available": { "type": "boolean" },
    "api_available": { "type": "boolean" },
    "integrations": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
    "ooligo_score": { "type": "number", "minimum": 0, "maximum": 10 },
    "ooligo_score_breakdown": {
      "type": "object",
      "properties": {
        "ux": { "type": "number", "minimum": 0, "maximum": 10 },
        "ai_quality": { "type": "number", "minimum": 0, "maximum": 10 },
        "pricing_value": { "type": "number", "minimum": 0, "maximum": 10 },
        "integrations": { "type": "number", "minimum": 0, "maximum": 10 }
      }
    },
    "last_reviewed": { "type": "string", "format": "date" },
    "last_refreshed": { "type": "string", "format": "date-time" },
    "affiliate_link": { "type": "string", "format": "uri" },
    "ai_generated": { "type": "boolean" },
    "ai_translated": { "type": "boolean" },
    "translated_from": { "type": "string" },
    "translated_at": { "type": "string", "format": "date-time" },
    "translation_model": { "type": "string" },
    "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
