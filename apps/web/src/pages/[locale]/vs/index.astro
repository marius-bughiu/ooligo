---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { locales, type LocaleCode } from "~/lib/config";

export function getStaticPaths() {
  return locales.map((l) => ({ params: { locale: l.code } }));
}

const { locale } = Astro.params as { locale: LocaleCode };

const all = await getCollection("comparisons");
const entries = all
  .filter((c) => c.data.locale === locale)
  .sort((a, b) => a.data.slug.localeCompare(b.data.slug));

async function resolveName(slug: string): Promise<string> {
  const tool = await getEntry("tools", `${locale}/${slug}`).catch(() => undefined);
  return tool?.data.name ?? slug;
}

const enriched = await Promise.all(
  entries.map(async (e) => {
    const tools =
      e.data.type === "pairwise"
        ? [e.data.tool_a!, e.data.tool_b!]
        : e.data.tools ?? [];
    const names = await Promise.all(tools.map(resolveName));
    const title =
      e.data.type === "pairwise" && names.length === 2
        ? `${names[0]} vs ${names[1]}`
        : e.data.type === "alternatives"
          ? `Alternatives to ${names[0] ?? e.data.slug}`
          : e.data.slug;
    return { entry: e, title };
  })
);
---
<BaseLayout
  title="Comparisons — ooligo"
  description="Side-by-side comparisons, alternatives, and category roundups."
  locale={locale}
  pagePath="/vs"
>
  <main>
    <header>
      <h1>Comparisons</h1>
      <p>{enriched.length} {enriched.length === 1 ? "comparison" : "comparisons"} indexed.</p>
    </header>

    {enriched.length === 0 ? (
      <p>No comparisons yet — the catalog is being built.</p>
    ) : (
      <ul>
        {enriched.map(({ entry, title }) => (
          <li>
            <a href={`/${locale}/vs/${entry.data.slug}/`}>
              <strong>{title}</strong>
            </a>
            {" · "}
            <span>{entry.data.type}</span>
            {" · "}
            <span>updated {entry.data.last_updated}</span>
          </li>
        ))}
      </ul>
    )}

    <p><a href={`/${locale}/`}>← Home</a></p>
  </main>
</BaseLayout>
