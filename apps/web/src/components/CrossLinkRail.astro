---
/**
 * CrossLinkRail — related-content rail.
 *
 * Closes the link budget enforced by the validator (per ARCHITECTURE.md):
 *   Tool       → 3 alternatives, 1 comparison, 2 workflows, 2 learn
 *   Comparison → both/all tool entries, 1 stack
 *   Workflow   → all tools used, 2 related workflows, 1 learn
 *   Learn      → 2-3 tools, 1-2 workflows, 2-3 sibling learn
 *   Stack      → all tools, 3+ workflows, 2+ learn
 *
 * Page templates compose multiple CrossLinkRails (one per relation
 * group). Variant `compact` for sidebar use, `wide` for full-width
 * end-of-page rails.
 */

interface CrossLink {
  label: string;
  href: string;
  /** Secondary line (category, score, type, etc.) — mono on render. */
  meta?: string;
}

interface Props {
  heading: string;
  links: CrossLink[];
  variant?: "compact" | "wide";
  class?: string;
}

const {
  heading,
  links,
  variant = "wide",
  class: className = "",
} = Astro.props;
---

{links.length > 0 && (
  <aside
    class:list={["rail", `rail-${variant}`, className]}
    aria-labelledby="rail-heading"
  >
    <h3 id="rail-heading" class="rail-heading">{heading}</h3>
    <ul class="rail-list">
      {links.map((l) => (
        <li class="rail-item">
          <a href={l.href} class="rail-link">
            <span class="rail-link-label">{l.label}</span>
            {l.meta && <span class="rail-link-meta">{l.meta}</span>}
            <span class="rail-link-chev" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </aside>
)}

<style>
  .rail {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .rail-heading {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-tertiary);
    font-weight: 600;
  }

  .rail-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid var(--color-border-subtle);
  }
  .rail-wide .rail-list {
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .rail-wide .rail-list {
      grid-template-columns: repeat(2, 1fr);
      border-top: 0;
      gap: 0.5rem;
    }
  }

  .rail-item {
    border-bottom: 1px solid var(--color-border-subtle);
  }
  @media (min-width: 768px) {
    .rail-wide .rail-item {
      border: 1px solid var(--color-border-subtle);
      border-radius: var(--radius-sm);
      background-color: var(--color-bg-surface-1);
    }
  }

  .rail-link {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 0;
    color: var(--color-text-primary);
    transition: color 150ms var(--ease-out-soft);
  }
  @media (min-width: 768px) {
    .rail-wide .rail-link {
      padding: 0.75rem 1rem;
    }
  }
  .rail-link:hover {
    color: var(--color-accent);
  }
  .rail-link:hover .rail-link-chev {
    transform: translateX(2px);
  }

  .rail-link-label {
    font-size: var(--text-sm);
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .rail-link-meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .rail-link-chev {
    font-family: var(--font-mono);
    color: var(--color-text-tertiary);
    transition: transform 150ms var(--ease-out-soft);
  }
</style>
