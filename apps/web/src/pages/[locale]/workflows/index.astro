---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { locales, type LocaleCode } from "~/lib/config";

export function getStaticPaths() {
  return locales.map((l) => ({ params: { locale: l.code } }));
}

const { locale } = Astro.params as { locale: LocaleCode };

const all = await getCollection("workflows");
const entries = all
  .filter((w) => w.data.locale === locale)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const byArtifactType = entries.reduce<Record<string, typeof entries>>((acc, e) => {
  const t = e.data.artifact_type;
  acc[t] ??= [];
  acc[t].push(e);
  return acc;
}, {});

const types = Object.keys(byArtifactType).sort();
---
<BaseLayout
  title="Workflows — ooligo"
  description="Production-ready prompts, Claude Skills, Cursor rules, n8n flows, agent templates."
  locale={locale}
  pagePath="/workflows"
>
  <main id="main">
    <header>
      <h1>Workflows</h1>
      <p>{entries.length} {entries.length === 1 ? "workflow" : "workflows"} indexed.</p>
    </header>

    {types.length === 0 ? (
      <p>No workflows yet — the library is being built.</p>
    ) : (
      types.map((t) => (
        <section>
          <h2>{t}</h2>
          <ul>
            {byArtifactType[t]!.map((e) => (
              <li>
                <a href={`/${locale}/workflows/${e.data.slug}/`}>
                  <strong>{e.data.title}</strong>
                </a>
                {" · "}
                <span>{e.data.difficulty}</span>
                {e.data.time_to_setup && <> · <span>{e.data.time_to_setup}</span></>}
                {" · "}
                <span>tools: {e.data.tools_used.join(", ")}</span>
              </li>
            ))}
          </ul>
        </section>
      ))
    )}

    <p><a href={`/${locale}/`}>← Home</a></p>
  </main>
</BaseLayout>
