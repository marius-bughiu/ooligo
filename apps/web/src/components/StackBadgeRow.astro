---
/**
 * StackBadgeRow — horizontal tool monogram + name list.
 *
 * Used inside workflow detail pages and stack pages to render the
 * "this workflow uses {Clay, Claude, HubSpot}" affordance. Each
 * tool links to its detail page so the row functions as both a
 * legend and a navigation device.
 *
 * Caller passes resolved tool entries (slug + name) — page templates
 * already do the getCollection round-trip once for their own logic.
 */

import ToolMonogram from "./ToolMonogram.astro";
import type { LocaleCode } from "~/lib/config";

interface ToolRef {
  slug: string;
  name: string;
}

interface Props {
  tools: ToolRef[];
  locale: LocaleCode;
  size?: "sm" | "md";
  class?: string;
}

const { tools, locale, size = "md", class: className = "" } = Astro.props;
const monoSize = size === "sm" ? 22 : 28;
---

<ul class:list={["stack-row", `stack-row-${size}`, className]}>
  {tools.map((tool) => (
    <li class="stack-row-item">
      <a
        href={`/${locale}/tools/${tool.slug}/`}
        class="stack-row-link"
        title={tool.name}
      >
        <ToolMonogram name={tool.name} size={monoSize} outlined />
        <span class="stack-row-name">{tool.name}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .stack-row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .stack-row-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.625rem 0.25rem 0.25rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-pill);
    color: var(--color-text-secondary);
    background-color: var(--color-bg-surface-1);
    font-family: var(--font-mono);
    transition: color 150ms var(--ease-out-soft),
      border-color 150ms var(--ease-out-soft),
      background-color 150ms var(--ease-out-soft);
  }
  .stack-row-link:hover {
    color: var(--color-text-primary);
    border-color: var(--color-border);
    background-color: var(--color-bg-surface-2);
  }

  .stack-row-sm .stack-row-link {
    font-size: var(--text-xs);
  }
  .stack-row-md .stack-row-link {
    font-size: var(--text-sm);
  }
</style>
