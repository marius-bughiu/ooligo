---
/**
 * VerticalTag — geometric mark + localized vertical name.
 *
 * Per DESIGN.md the brand intentionally does NOT differentiate verticals
 * by hue. The mark is a uniform amber square (small) and the label is
 * the localized vertical name from content/verticals.json. As more
 * verticals join, the mark stays the same and the label scales.
 */

import {
  getVertical,
  localizedName,
  type LocaleCode,
} from "~/lib/config";

interface Props {
  slug: string;
  locale: LocaleCode;
  size?: "sm" | "md";
  class?: string;
}

const { slug, locale, size = "sm", class: className = "" } = Astro.props;
const v = getVertical(slug);
---

{v && (
  <span class:list={["v-tag", `v-tag-${size}`, className]}>
    <span class="v-tag-mark" aria-hidden="true"></span>
    <span class="v-tag-name">{localizedName(v, locale)}</span>
  </span>
)}

<style>
  .v-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    color: var(--color-text-secondary);
    line-height: 1;
    white-space: nowrap;
  }

  .v-tag-sm {
    font-size: var(--text-xs);
  }
  .v-tag-md {
    font-size: var(--text-sm);
  }

  .v-tag-mark {
    width: 0.5rem;
    height: 0.5rem;
    background-color: var(--color-accent);
    border-radius: 1px;
    flex-shrink: 0;
  }
</style>
