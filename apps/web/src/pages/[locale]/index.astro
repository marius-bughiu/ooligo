---
import BaseLayout from "~/layouts/BaseLayout.astro";
import {
  locales,
  verticals,
  localizedName,
  localizedTagline,
  type LocaleCode,
} from "~/lib/config";

export function getStaticPaths() {
  return locales.map((l) => ({ params: { locale: l.code } }));
}

const { locale } = Astro.params as { locale: LocaleCode };

const headlines = {
  en: {
    title: "ooligo — the AI workflow marketplace for ops leaders",
    h1: "Every AI tool, comparison, and workflow your ops team needs.",
    sub: "RevOps, Legal Ops, Recruiting. AI-generated, AI-translated, transparently labeled.",
    cta: "Browse the catalog",
    verticals_heading: "Verticals at launch",
  },
  es: {
    title: "ooligo — el marketplace de workflows de IA para líderes de operaciones",
    h1: "Cada herramienta de IA, comparación y workflow que tu equipo de operaciones necesita.",
    sub: "RevOps, Legal Ops, Reclutamiento. Generado y traducido por IA, etiquetado de forma transparente.",
    cta: "Explorar el catálogo",
    verticals_heading: "Verticales al lanzamiento",
  },
  "pt-BR": {
    title: "ooligo — o marketplace de workflows de IA para líderes de operações",
    h1: "Cada ferramenta de IA, comparação e workflow que seu time de operações precisa.",
    sub: "RevOps, Legal Ops, Recrutamento. Gerado e traduzido por IA, com rotulagem transparente.",
    cta: "Explorar o catálogo",
    verticals_heading: "Verticais no lançamento",
  },
} as const;

const copy = headlines[locale];
---
<BaseLayout
  title={copy.title}
  description={copy.sub}
  locale={locale}
  pagePath="/"
>
  <main>
    <section>
      <h1>{copy.h1}</h1>
      <p>{copy.sub}</p>
      <a href={`/${locale}/tools`}>{copy.cta} →</a>
    </section>

    <section>
      <h2>{copy.verticals_heading}</h2>
      <ul>
        {verticals.map((v) => (
          <li>
            <a href={`/${locale}/r/${v.slug}`}>
              <strong>{localizedName(v, locale)}</strong>
            </a>
            {" — "}
            <span>{localizedTagline(v, locale)}</span>
          </li>
        ))}
      </ul>
    </section>
  </main>
</BaseLayout>
