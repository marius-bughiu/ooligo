---
/**
 * /404 — branded not-found page.
 *
 * Cloudflare Pages serves /404.html as the not-found document for any
 * path that doesn't resolve to a static file. This page is locale-
 * agnostic — visitors landing here typed or followed a broken URL.
 * We default the chrome to the canonical English locale and offer
 * direct entry points to each catalog index.
 *
 * Not in the sitemap (pages with status "404" should never be indexed).
 */

import BaseLayout from "~/layouts/BaseLayout.astro";
import Container from "~/components/Container.astro";
import Section from "~/components/Section.astro";
import { defaultLocale } from "~/lib/config";
import { chromeStrings } from "~/lib/strings";

const locale = defaultLocale;
const t = chromeStrings(locale);
---

<BaseLayout
  title="404 — ooligo"
  description="Page not found."
  locale={locale}
  pagePath="/404"
  availableLocales={[]}
>
  <meta slot="head" name="robots" content="noindex" />

  <main id="main">
    <Section density="lg">
      <Container>
        <div class="nf">
          <div class="nf-code" aria-hidden="true">
            <span class="nf-code-digit">4</span>
            <span class="nf-code-zero">
              <span class="nf-code-dot nf-code-dot-1"></span>
              <span class="nf-code-dot nf-code-dot-2"></span>
            </span>
            <span class="nf-code-digit">4</span>
          </div>

          <div class="nf-text">
            <div class="nf-status">404 · NOT FOUND</div>
            <h1 class="nf-title">This page is not in the catalog.</h1>
            <p class="nf-message">
              The URL doesn't match any tool, comparison, workflow, or learn
              entry. The catalog grows on every push, but this slug isn't in
              it yet — or has been renamed. Try one of the entry points below.
            </p>
          </div>

          <div class="nf-links">
            <a href={`/${locale}/`} class="nf-link nf-link-primary">
              ooligo home
              <span class="nf-link-arrow" aria-hidden="true">→</span>
            </a>
            <a href={`/${locale}/tools/`} class="nf-link">
              {t.nav.tools}
              <span class="nf-link-arrow" aria-hidden="true">→</span>
            </a>
            <a href={`/${locale}/vs/`} class="nf-link">
              {t.nav.comparisons}
              <span class="nf-link-arrow" aria-hidden="true">→</span>
            </a>
            <a href={`/${locale}/workflows/`} class="nf-link">
              {t.nav.workflows}
              <span class="nf-link-arrow" aria-hidden="true">→</span>
            </a>
            <a href={`/${locale}/learn/`} class="nf-link">
              {t.nav.learn}
              <span class="nf-link-arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </Container>
    </Section>
  </main>
</BaseLayout>

<style>
  .nf {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2.5rem;
    max-width: 48rem;
    margin: 4rem 0;
  }

  /* ============ "404" GLYPH ============ */
  .nf-code {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--font-mono);
    font-size: clamp(5rem, 14vw, 9rem);
    line-height: 1;
    color: var(--color-text-primary);
    letter-spacing: -0.06em;
    font-weight: 600;
  }

  .nf-code-zero {
    width: 1ch;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    border: 0.08em solid var(--color-text-primary);
    display: inline-block;
    position: relative;
  }
  /* Knockout "oo" inside the zero — riffs on the wordmark glyph */
  .nf-code-dot {
    position: absolute;
    width: 16%;
    height: 16%;
    background-color: var(--color-accent);
    border-radius: 50%;
    top: 50%;
    transform: translateY(-50%);
  }
  .nf-code-dot-1 {
    left: 28%;
  }
  .nf-code-dot-2 {
    right: 28%;
  }

  /* ============ TEXT ============ */
  .nf-text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .nf-status {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    font-weight: 600;
  }

  .nf-title {
    margin: 0;
    font-size: clamp(1.75rem, 3vw + 1rem, var(--text-3xl));
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.1;
    color: var(--color-text-primary);
  }

  .nf-message {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    line-height: 1.65;
    max-width: 56ch;
  }

  /* ============ LINKS ============ */
  .nf-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .nf-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 40px;
    padding: 0 0.875rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xs);
    color: var(--color-text-primary);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: 1;
    transition: border-color 150ms var(--ease-out-soft),
      color 150ms var(--ease-out-soft);
  }
  .nf-link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .nf-link:hover .nf-link-arrow {
    transform: translateX(2px);
  }

  .nf-link-primary {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-bg-canvas);
    font-weight: 600;
  }
  .nf-link-primary:hover {
    background-color: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
    color: var(--color-bg-canvas);
  }

  .nf-link-arrow {
    font-family: var(--font-mono);
    color: var(--color-text-tertiary);
    transition: transform 150ms var(--ease-out-soft);
  }
  .nf-link-primary .nf-link-arrow {
    color: var(--color-bg-canvas);
    opacity: 0.6;
  }
</style>
