---
import { getCollection, render } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import JsonLd from "~/components/JsonLd.astro";
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import Container from "~/components/Container.astro";
import Section from "~/components/Section.astro";
import Prose from "~/components/Prose.astro";
import ScorePill from "~/components/ScorePill.astro";
import CapabilityChip from "~/components/CapabilityChip.astro";
import PricingLabel from "~/components/PricingLabel.astro";
import VerticalTag from "~/components/VerticalTag.astro";
import ScoreBreakdownBars from "~/components/ScoreBreakdownBars.astro";
import SpecTable from "~/components/SpecTable.astro";
import SpecRow from "~/components/SpecRow.astro";
import CrossLinkRail from "~/components/CrossLinkRail.astro";
import EditOnGitHub from "~/components/EditOnGitHub.astro";
import { localeText, type LocaleCode } from "~/lib/config";
import { chromeStrings } from "~/lib/strings";

export async function getStaticPaths() {
  const tools = await getCollection("tools");
  return tools.map((entry) => ({
    params: { locale: entry.data.locale, slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { locale } = Astro.params as { locale: LocaleCode };
const { Content } = await render(entry);
const data = entry.data;

const allTools = await getCollection("tools");
const allComparisons = await getCollection("comparisons");
const allWorkflows = await getCollection("workflows");
const allLearn = await getCollection("learn");

// hreflang only for locales where this tool entry actually exists.
const availableLocales = allTools
  .filter((t) => t.data.canonical_slug === data.canonical_slug)
  .map((t) => t.data.locale);

const chrome = chromeStrings(locale);

// ----- Detail-page localized strings -----
const labels = {
  en: {
    spec_website: "Website",
    spec_pricing: "Pricing",
    spec_score: "ooligo score",
    spec_ai_native: "AI-native",
    spec_mcp: "MCP server",
    spec_api: "Public API",
    spec_integrations: "Integrations",
    spec_last_reviewed: "Last reviewed",
    spec_verticals: "Verticals",
    score_breakdown: "Score breakdown",
    cta_visit: "Visit",
    cta_pricing_page: "View pricing",
    affiliate_note: "Affiliate link supports ooligo",
    rail_alternatives: "Alternatives",
    rail_comparisons: "Featured in comparisons",
    rail_workflows: "Workflows using",
    rail_learn: "Related learning",
    no_alternatives: "No alternatives indexed yet in this category.",
    yes: "Yes",
    no: "No",
  },
  es: {
    spec_website: "Sitio web",
    spec_pricing: "Precios",
    spec_score: "puntaje ooligo",
    spec_ai_native: "AI-native",
    spec_mcp: "Servidor MCP",
    spec_api: "API pública",
    spec_integrations: "Integraciones",
    spec_last_reviewed: "Última revisión",
    spec_verticals: "Verticales",
    score_breakdown: "Desglose del puntaje",
    cta_visit: "Visitar",
    cta_pricing_page: "Ver precios",
    affiliate_note: "Enlace de afiliado que apoya a ooligo",
    rail_alternatives: "Alternativas",
    rail_comparisons: "Aparece en comparaciones",
    rail_workflows: "Workflows que usan",
    rail_learn: "Aprendizaje relacionado",
    no_alternatives: "Aún no hay alternativas indexadas en esta categoría.",
    yes: "Sí",
    no: "No",
  },
  "pt-BR": {
    spec_website: "Site",
    spec_pricing: "Preços",
    spec_score: "pontuação ooligo",
    spec_ai_native: "AI-native",
    spec_mcp: "Servidor MCP",
    spec_api: "API pública",
    spec_integrations: "Integrações",
    spec_last_reviewed: "Última revisão",
    spec_verticals: "Verticais",
    score_breakdown: "Detalhamento da pontuação",
    cta_visit: "Visitar",
    cta_pricing_page: "Ver preços",
    affiliate_note: "Link de afiliado que apoia a ooligo",
    rail_alternatives: "Alternativas",
    rail_comparisons: "Aparece em comparações",
    rail_workflows: "Workflows que usam",
    rail_learn: "Aprendizado relacionado",
    no_alternatives: "Ainda não há alternativas indexadas nessa categoria.",
    yes: "Sim",
    no: "Não",
  },
} as const;

const t = localeText(labels, locale);

// ----- Cross-link computation -----
const localeTools = allTools.filter((tt) => tt.data.locale === locale);

// Alternatives: same category, different slug, top 3 by score
const alternatives = localeTools
  .filter(
    (tt) =>
      tt.data.slug !== data.slug && tt.data.category === data.category
  )
  .sort((a, b) => (b.data.ooligo_score ?? 0) - (a.data.ooligo_score ?? 0))
  .slice(0, 3);

// Comparisons featuring this tool, in this locale
const featuredComparisons = allComparisons
  .filter((c) => c.data.locale === locale)
  .filter((c) => {
    if (c.data.type === "pairwise") {
      return c.data.tool_a === data.slug || c.data.tool_b === data.slug;
    }
    return (c.data.tools ?? []).includes(data.slug);
  })
  .slice(0, 4);

// Workflows that use this tool
const workflowsUsing = allWorkflows
  .filter((w) => w.data.locale === locale)
  .filter((w) => w.data.tools_used.includes(data.slug))
  .slice(0, 4);

// Learn entries that relate to this tool
const relatedLearn = allLearn
  .filter((l) => l.data.locale === locale)
  .filter((l) => (l.data.related_tools ?? []).includes(data.slug))
  .slice(0, 3);

// ----- Comparison title resolver (uses tool names from this locale) -----
function comparisonTitle(c: (typeof allComparisons)[number]): string {
  if (c.data.type === "pairwise") {
    const a = localeTools.find((tt) => tt.data.slug === c.data.tool_a);
    const b = localeTools.find((tt) => tt.data.slug === c.data.tool_b);
    return `${a?.data.name ?? c.data.tool_a} vs ${b?.data.name ?? c.data.tool_b}`;
  }
  if (c.data.type === "alternatives") {
    const focal = localeTools.find((tt) => tt.data.slug === (c.data.tools ?? [])[0]);
    return `Alternatives to ${focal?.data.name ?? (c.data.tools ?? [])[0]}`;
  }
  return c.data.slug.replace(/-/g, " ");
}

// ----- JSON-LD -----
const offers =
  data.pricing_model === "free"
    ? { "@type": "Offer", price: "0", priceCurrency: "USD" }
    : data.pricing_starts_at
      ? {
          "@type": "Offer",
          price: String(data.pricing_starts_at),
          priceCurrency: "USD",
        }
      : undefined;

const review = data.ooligo_score
  ? {
      "@type": "Review",
      reviewRating: {
        "@type": "Rating",
        ratingValue: data.ooligo_score,
        bestRating: 10,
        worstRating: 0,
      },
      author: { "@type": "Organization", name: "ooligo" },
      datePublished: data.last_reviewed,
    }
  : undefined;

const jsonLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: data.name,
  url: data.website,
  applicationCategory: data.category,
  operatingSystem: "Web",
  ...(offers ? { offers } : {}),
  ...(review ? { review } : {}),
};

// Hostname for affiliate CTA "↗ on clay.com"
function hostnameOf(url: string): string {
  try {
    return new URL(url).hostname.replace(/^www\./, "");
  } catch {
    return url;
  }
}
const affiliateUrl = data.affiliate_link ?? data.website;
const affiliateHost = hostnameOf(affiliateUrl);
---

<BaseLayout
  title={`${data.name} — ooligo`}
  description={`${data.name}: ${data.category}. AI-native: ${data.ai_native ? "yes" : "no"}.`}
  locale={locale}
  pagePath={`/tools/${data.slug}`}
  availableLocales={availableLocales}
  ogImagePath={`/og/${locale}/tools/${data.slug}.svg`}
>
  <JsonLd slot="head" data={jsonLd} />
  <main id="main">
    <Section density="md">
      <Container>
        <Breadcrumbs
          items={[
            { label: "ooligo", href: `/${locale}/` },
            { label: chrome.nav.tools, href: `/${locale}/tools/` },
            { label: data.name },
          ]}
        />

        <!-- ============ HEADER BAND ============ -->
        <header class="tool-header">
          <div class="tool-header-id">
            <h1 class="tool-name">{data.name}</h1>
            <div class="tool-meta">
              <span class="tool-category">{data.category}</span>
              {data.subcategories && data.subcategories.length > 0 && (
                <>
                  <span class="tool-meta-sep" aria-hidden="true">·</span>
                  <span class="tool-subcategories">
                    {data.subcategories.join(" · ")}
                  </span>
                </>
              )}
            </div>
            <div class="tool-chips">
              {data.ai_native && <CapabilityChip label="AI-NATIVE" variant="accent" />}
              {data.mcp_available && <CapabilityChip label="MCP" />}
              {data.api_available && <CapabilityChip label="API" />}
              {data.pricing_model === "free" && <CapabilityChip label="FREE" />}
              {data.pricing_model === "freemium" && <CapabilityChip label="FREEMIUM" />}
            </div>
            <div class="tool-vtags">
              {data.verticals.map((vSlug) => (
                <VerticalTag slug={vSlug} locale={locale} size="sm" />
              ))}
            </div>
          </div>
          {data.ooligo_score != null && (
            <div class="tool-header-score">
              <ScorePill score={data.ooligo_score} size="md" />
            </div>
          )}
        </header>

        <!-- ============ 8/4 SPLIT ============ -->
        <div class="tool-layout">
          <Prose width="app" class="tool-body">
            <Content />
            <div class="edit-on-github-wrap">
              <EditOnGitHub
                mode="edit"
                collection="tools"
                locale={locale}
                slug={data.slug}
                label={chrome.contribute.edit_page}
              />
            </div>
          </Prose>

          <aside class="tool-aside">
            <div class="tool-aside-sticky">
              <!-- Affiliate CTA -->
              <a
                class="cta-affiliate"
                href={affiliateUrl}
                rel={data.affiliate_link ? "sponsored noopener" : "noopener"}
              >
                <span class="cta-affiliate-label">
                  {t.cta_visit} {data.name}
                </span>
                <span class="cta-affiliate-host">
                  ↗ {affiliateHost}
                </span>
              </a>
              {data.affiliate_link && (
                <p class="cta-affiliate-note">{t.affiliate_note}</p>
              )}

              <!-- Spec table -->
              <SpecTable>
                <SpecRow label={t.spec_pricing}>
                  <PricingLabel
                    model={data.pricing_model}
                    startsAt={data.pricing_starts_at}
                  />
                  {data.pricing_url && (
                    <>
                      {" · "}
                      <a href={data.pricing_url} class="aside-inline-link" rel="noopener">
                        {t.cta_pricing_page} ↗
                      </a>
                    </>
                  )}
                </SpecRow>
                {data.ooligo_score != null && (
                  <SpecRow label={t.spec_score}>
                    <ScorePill score={data.ooligo_score} size="sm" />
                  </SpecRow>
                )}
                <SpecRow label={t.spec_ai_native}>
                  {data.ai_native ? t.yes : t.no}
                </SpecRow>
                {data.mcp_available !== undefined && (
                  <SpecRow label={t.spec_mcp}>
                    {data.mcp_available ? t.yes : t.no}
                  </SpecRow>
                )}
                {data.api_available !== undefined && (
                  <SpecRow label={t.spec_api}>
                    {data.api_available ? t.yes : t.no}
                  </SpecRow>
                )}
                {data.integrations && data.integrations.length > 0 && (
                  <SpecRow label={t.spec_integrations}>
                    {data.integrations.join(", ")}
                  </SpecRow>
                )}
                <SpecRow label={t.spec_last_reviewed} mono>
                  {data.last_reviewed}
                </SpecRow>
              </SpecTable>

              <!-- Score breakdown bars -->
              {data.ooligo_score_breakdown &&
                Object.values(data.ooligo_score_breakdown).some((v) => v != null) && (
                  <div class="score-breakdown-card">
                    <div class="score-breakdown-label">
                      {t.score_breakdown}
                    </div>
                    <ScoreBreakdownBars
                      breakdown={Object.fromEntries(
                        Object.entries(data.ooligo_score_breakdown).filter(
                          ([, v]) => v != null
                        ) as [string, number][]
                      )}
                    />
                  </div>
                )}
            </div>
          </aside>
        </div>
      </Container>
    </Section>

    <!-- ============ CROSS-LINK RAILS ============ -->
    {(alternatives.length > 0 ||
      featuredComparisons.length > 0 ||
      workflowsUsing.length > 0 ||
      relatedLearn.length > 0) && (
      <Section density="md" divided surface="surface-1">
        <Container>
          <div class="rails-grid">
            {alternatives.length > 0 && (
              <CrossLinkRail
                heading={t.rail_alternatives}
                variant="compact"
                links={alternatives.map((alt) => ({
                  label: alt.data.name,
                  href: `/${locale}/tools/${alt.data.slug}/`,
                  meta:
                    alt.data.ooligo_score != null
                      ? `${alt.data.category} · ${alt.data.ooligo_score}/10`
                      : alt.data.category,
                }))}
              />
            )}
            {featuredComparisons.length > 0 && (
              <CrossLinkRail
                heading={t.rail_comparisons}
                variant="compact"
                links={featuredComparisons.map((c) => ({
                  label: comparisonTitle(c),
                  href: `/${locale}/vs/${c.data.slug}/`,
                  meta: c.data.type,
                }))}
              />
            )}
            {workflowsUsing.length > 0 && (
              <CrossLinkRail
                heading={`${t.rail_workflows} ${data.name}`}
                variant="compact"
                links={workflowsUsing.map((w) => ({
                  label: w.data.title,
                  href: `/${locale}/workflows/${w.data.slug}/`,
                  meta: w.data.artifact_type,
                }))}
              />
            )}
            {relatedLearn.length > 0 && (
              <CrossLinkRail
                heading={t.rail_learn}
                variant="compact"
                links={relatedLearn.map((l) => ({
                  label: l.data.title,
                  href: `/${locale}/learn/${l.data.slug}/`,
                  meta: l.data.type,
                }))}
              />
            )}
          </div>
        </Container>
      </Section>
    )}
  </main>
</BaseLayout>

<style>
  /* ============ HEADER BAND ============ */
  .tool-header {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-top: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }
  @media (min-width: 768px) {
    .tool-header {
      grid-template-columns: 1fr auto;
      align-items: start;
      gap: 2rem;
    }
  }

  .tool-header-id {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .tool-name {
    margin: 0;
    font-size: var(--text-3xl);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .tool-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }
  .tool-category {
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-primary);
  }
  .tool-meta-sep {
    color: var(--color-border);
  }
  .tool-subcategories {
    color: var(--color-text-tertiary);
  }

  .tool-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .tool-vtags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
  }

  /* ============ 8/4 SPLIT ============ */
  .tool-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin-top: 2.5rem;
  }
  @media (min-width: 1024px) {
    .tool-layout {
      grid-template-columns: minmax(0, 1fr) 22rem;
      gap: 3.5rem;
    }
  }

  .tool-body {
    min-width: 0;
  }

  .edit-on-github-wrap {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .tool-aside {
    min-width: 0;
  }

  .tool-aside-sticky {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  @media (min-width: 1024px) {
    .tool-aside-sticky {
      position: sticky;
      top: calc(64px + 1.5rem);
    }
  }

  /* Affiliate CTA */
  .cta-affiliate {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.875rem 1rem;
    background-color: var(--color-accent);
    color: var(--color-bg-canvas);
    border-radius: var(--radius-sm);
    font-weight: 600;
    transition: background-color 150ms var(--ease-out-soft);
  }
  .cta-affiliate:hover {
    background-color: var(--color-accent-hover);
  }
  .cta-affiliate-label {
    font-size: var(--text-base);
    line-height: 1;
  }
  .cta-affiliate-host {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    opacity: 0.7;
    line-height: 1;
  }
  .cta-affiliate-note {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    text-align: center;
  }

  /* Inline link inside SpecRow */
  .aside-inline-link {
    color: var(--color-accent);
  }

  /* Score breakdown card */
  .score-breakdown-card {
    padding: 1rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    background-color: var(--color-bg-surface-1);
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  .score-breakdown-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-tertiary);
  }

  /* ============ CROSS-LINK RAILS ============ */
  .rails-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 768px) {
    .rails-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem;
    }
  }
</style>
