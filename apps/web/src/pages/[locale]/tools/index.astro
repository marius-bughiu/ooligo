---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { locales, type LocaleCode } from "~/lib/config";

export function getStaticPaths() {
  return locales.map((l) => ({ params: { locale: l.code } }));
}

const { locale } = Astro.params as { locale: LocaleCode };
---
<BaseLayout
  title="Tools — ooligo"
  description="Directory of AI tools, MCP servers, agents, GPTs."
  locale={locale}
  pagePath="/tools"
>
  <main>
    <h1>Tools</h1>
    <p>Catalog populates in Phase 1. Watch the repo.</p>
    <p><a href={`/${locale}/`}>← Home</a></p>
  </main>
</BaseLayout>
