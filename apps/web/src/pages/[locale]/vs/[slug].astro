---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import JsonLd from "~/components/JsonLd.astro";
import { type LocaleCode } from "~/lib/config";

export async function getStaticPaths() {
  const comparisons = await getCollection("comparisons");
  return comparisons.map((entry) => ({
    params: { locale: entry.data.locale, slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { locale } = Astro.params as { locale: LocaleCode };
const { Content } = await render(entry);
const data = entry.data;

const allComparisons = await getCollection("comparisons");
const availableLocales = allComparisons
  .filter((c) => c.data.canonical_slug === data.canonical_slug)
  .map((c) => c.data.locale);

// Resolve referenced tool entries for the current locale to render names.
async function resolveTools(slugs: string[]) {
  const tools = await Promise.all(
    slugs.map((slug) => getEntry("tools", `${locale}/${slug}`).catch(() => undefined))
  );
  return tools.filter((t): t is NonNullable<typeof t> => t !== undefined);
}

const toolSlugs =
  data.type === "pairwise"
    ? [data.tool_a!, data.tool_b!]
    : data.tools ?? [];

const tools = await resolveTools(toolSlugs);

const titleByType: Record<typeof data.type, string> = {
  pairwise: tools.length === 2 ? `${tools[0]?.data.name} vs ${tools[1]?.data.name}` : data.slug,
  roundup: `Best ${data.verticals[0]} tools — ${data.slug}`,
  alternatives: `Alternatives to ${tools[0]?.data.name ?? data.slug}`,
};
const pageTitle = titleByType[data.type];

const jsonLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: tools.map((t, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "SoftwareApplication",
      name: t.data.name,
      url: t.data.website,
      applicationCategory: t.data.category,
    },
  })),
};
---
<BaseLayout
  title={`${pageTitle} — ooligo`}
  description={`Side-by-side comparison: ${tools.map((t) => t.data.name).join(", ")}.`}
  locale={locale}
  pagePath={`/vs/${data.slug}`}
  availableLocales={availableLocales}
>
  <JsonLd slot="head" data={jsonLd} />
  <main>
    <nav><a href={`/${locale}/vs`}>← All comparisons</a></nav>

    <header>
      <h1>{pageTitle}</h1>
      <p>Last updated: {data.last_updated}</p>
    </header>

    {tools.length > 0 && (
      <section>
        <h2>Tools in this comparison</h2>
        <ul>
          {tools.map((t) => (
            <li>
              <a href={`/${locale}/tools/${t.data.slug}`}>
                <strong>{t.data.name}</strong>
              </a>
              {" — "}
              <span>{t.data.category}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <article>
      <Content />
    </article>
  </main>
</BaseLayout>
