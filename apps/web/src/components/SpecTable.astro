---
/**
 * SpecTable — dense data display for tool detail spec cards.
 *
 * Replaces the raw <dl><dt><dd> rendering currently in tools/[slug].
 * Two-column key/value grid, mono-anchored, with optional `mono` flag
 * per row to flip the value to monospace (slugs, prices, scores).
 *
 * Two usage modes:
 *
 *   1. Data-driven (simple text rows):
 *      <SpecTable rows={[{ label: "Pricing", value: "$149/mo" }]} />
 *
 *   2. Slotted (rich rows containing other components):
 *      <SpecTable>
 *        <SpecRow label="Pricing">
 *          <PricingLabel ... />
 *        </SpecRow>
 *      </SpecTable>
 *
 * Styles are exposed globally so a manual <dl class="spec-table">
 * with <div class="spec-row"><dt class="spec-label">.. <dd
 * class="spec-value"> picks up the same look without going through
 * the wrapper. Astro doesn't permit dynamic <slot name>, hence this
 * dual-mode design.
 */

interface SimpleRow {
  label: string;
  value?: string | number | null;
  mono?: boolean;
}

interface Props {
  rows?: SimpleRow[];
  class?: string;
}

const { rows, class: className = "" } = Astro.props;
---

<dl class:list={["spec-table", className]}>
  {rows
    ? rows.map((row) => (
        <div class="spec-row">
          <dt class="spec-label">{row.label}</dt>
          <dd class:list={["spec-value", row.mono && "spec-value-mono"]}>
            {row.value ?? <span class="spec-empty">—</span>}
          </dd>
        </div>
      ))
    : <slot />}
</dl>

<style is:global>
  .spec-table {
    display: grid;
    grid-template-columns: minmax(7rem, auto) 1fr;
    column-gap: 1.25rem;
    margin: 0;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    background-color: var(--color-bg-surface-1);
    overflow: hidden;
  }

  .spec-table .spec-row {
    display: contents;
  }

  .spec-table .spec-label,
  .spec-table .spec-value {
    padding: 0.625rem 1rem;
    border-top: 1px solid var(--color-border-subtle);
    font-size: var(--text-sm);
    line-height: 1.4;
    margin: 0;
  }
  .spec-table .spec-row:first-child .spec-label,
  .spec-table .spec-row:first-child .spec-value {
    border-top: 0;
  }

  .spec-table .spec-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-tertiary);
    background-color: var(--color-bg-surface-2);
    align-self: stretch;
    display: flex;
    align-items: center;
  }

  .spec-table .spec-value {
    color: var(--color-text-primary);
    word-break: break-word;
  }

  .spec-table .spec-value-mono {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .spec-table .spec-empty {
    color: var(--color-text-tertiary);
  }
</style>
