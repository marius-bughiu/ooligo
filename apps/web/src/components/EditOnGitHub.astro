---
/**
 * Contribution CTA — links to GitHub for either editing the current
 * page's source MDX (`mode: "edit"`) or creating a new entry in a
 * collection's English directory (`mode: "new"`).
 *
 * Caller supplies the localized label so we don't bake any
 * locale-specific copy here.
 */

import { REPO_URL, REPO_BRANCH, type LocaleCode } from "~/lib/config";

type Collection = "tools" | "learn" | "comparisons" | "workflows";

type Props =
  | { mode: "edit"; collection: Collection; locale: LocaleCode; slug: string; label: string }
  | { mode: "new"; collection: Collection; label: string };

const props = Astro.props as Props;

const href =
  props.mode === "edit"
    ? `${REPO_URL}/edit/${REPO_BRANCH}/content/${props.collection}/${props.locale}/${props.slug}.mdx`
    : `${REPO_URL}/new/${REPO_BRANCH}/content/${props.collection}/en`;
---

<a class="edit-on-github" href={href} target="_blank" rel="noopener">
  <svg
    class="edit-on-github-icon"
    width="14"
    height="14"
    viewBox="0 0 16 16"
    aria-hidden="true"
    fill="currentColor"
  >
    <path d="M8 0C3.58 0 0 3.58 0 8a8 8 0 005.47 7.59c.4.07.55-.17.55-.38v-1.34c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.72 1.23 1.88.88 2.34.67.07-.52.28-.88.51-1.08-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.13 0 0 .67-.21 2.2.82a7.6 7.6 0 014 0c1.53-1.03 2.2-.82 2.2-.82.44 1.11.16 1.93.08 2.13.51.56.82 1.27.82 2.15 0 3.07-1.87 3.74-3.65 3.94.29.25.54.73.54 1.48v2.19c0 .21.15.46.55.38A8 8 0 0016 8c0-4.42-3.58-8-8-8z" />
  </svg>
  <span class="edit-on-github-label">{props.label}</span>
  <span class="edit-on-github-arrow" aria-hidden="true">→</span>
</a>

<style>
  .edit-on-github {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xs);
    background-color: transparent;
    color: var(--color-text-tertiary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1;
    transition:
      color 150ms var(--ease-out-soft),
      border-color 150ms var(--ease-out-soft),
      background-color 150ms var(--ease-out-soft);
  }

  .edit-on-github:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background-color: color-mix(in oklab, var(--color-accent) 6%, transparent);
  }

  .edit-on-github-icon {
    flex-shrink: 0;
    color: var(--color-text-tertiary);
    transition: color 150ms var(--ease-out-soft);
  }
  .edit-on-github:hover .edit-on-github-icon {
    color: var(--color-accent);
  }

  .edit-on-github-arrow {
    transition: transform 150ms var(--ease-out-soft);
  }
  .edit-on-github:hover .edit-on-github-arrow {
    transform: translateX(2px);
  }
</style>
