---
/**
 * EmptyState — index/section empty placeholder.
 *
 * Used on /tools, /vs, /workflows, /learn whenever the locale-filtered
 * collection has zero entries (still common pre-launch). Per DESIGN.md
 * empty states are ⅓ of the live surface area right now, so they
 * intentionally read as "the engine is online; the catalog is being
 * built" — not as broken pages.
 *
 * Visual: dotted-border surface card, mono caption-label, optional
 * action link styled as a secondary button.
 */

interface Props {
  title: string;
  message: string;
  action?: { label: string; href: string };
  class?: string;
}

const { title, message, action, class: className = "" } = Astro.props;
---

<div class:list={["empty-state", className]} role="status">
  <div class="empty-state-mark" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
  </div>
  <h3 class="empty-state-title">{title}</h3>
  <p class="empty-state-message">{message}</p>
  {action && (
    <a href={action.href} class="empty-state-action">{action.label} →</a>
  )}
</div>

<style>
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.75rem;
    padding: 3rem 1.5rem;
    border: 1px dashed var(--color-border-subtle);
    border-radius: var(--radius-md);
    background-color: var(--color-bg-surface-1);
  }

  .empty-state-mark {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-bottom: 0.5rem;
  }
  .empty-state-mark span {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-pill);
    background-color: var(--color-border);
  }
  .empty-state-mark span:nth-child(2) {
    background-color: var(--color-accent);
  }

  .empty-state-title {
    margin: 0;
    font-size: var(--text-lg);
    color: var(--color-text-primary);
  }

  .empty-state-message {
    margin: 0;
    max-width: 32ch;
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .empty-state-action {
    margin-top: 0.5rem;
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-primary);
    transition: border-color 150ms var(--ease-out-soft),
      color 150ms var(--ease-out-soft);
  }
  .empty-state-action:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
</style>
