---
import { getCollection, render } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import JsonLd from "~/components/JsonLd.astro";
import { locales, type LocaleCode } from "~/lib/config";

export async function getStaticPaths() {
  const tools = await getCollection("tools");
  return tools.map((entry) => ({
    params: { locale: entry.data.locale, slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { locale } = Astro.params as { locale: LocaleCode };
const { Content } = await render(entry);
const data = entry.data;

// Find all locale variants of this tool (same canonical_slug) so hreflang
// only points at pages that actually exist.
const allTools = await getCollection("tools");
const availableLocales = allTools
  .filter((t) => t.data.canonical_slug === data.canonical_slug)
  .map((t) => t.data.locale);

const site = Astro.site?.toString().replace(/\/$/, "") ?? "https://ooligo.com";
const canonical = `${site}/${locale}/tools/${data.slug}`;

const offers =
  data.pricing_model === "free"
    ? { "@type": "Offer", price: "0", priceCurrency: "USD" }
    : data.pricing_starts_at
      ? { "@type": "Offer", price: String(data.pricing_starts_at), priceCurrency: "USD" }
      : undefined;

const review = data.ooligo_score
  ? {
      "@type": "Review",
      reviewRating: {
        "@type": "Rating",
        ratingValue: data.ooligo_score,
        bestRating: 10,
        worstRating: 0,
      },
      author: { "@type": "Organization", name: "ooligo" },
      datePublished: data.last_reviewed,
    }
  : undefined;

const jsonLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: data.name,
  url: data.website,
  applicationCategory: data.category,
  operatingSystem: "Web",
  ...(offers ? { offers } : {}),
  ...(review ? { review } : {}),
};
---
<BaseLayout
  title={`${data.name} — ooligo`}
  description={`${data.name}: ${data.category}. AI-native: ${data.ai_native ? "yes" : "no"}.`}
  locale={locale}
  pagePath={`/tools/${data.slug}`}
  availableLocales={availableLocales}
>
  <JsonLd slot="head" data={jsonLd} />
  <main id="main">
    <nav>
      <a href={`/${locale}/tools`}>← All tools</a>
    </nav>

    <header>
      <h1>{data.name}</h1>
      <p>
        <strong>{data.category}</strong>
        {data.subcategories && data.subcategories.length > 0 && (
          <> · {data.subcategories.join(" · ")}</>
        )}
      </p>
    </header>

    <section>
      <dl>
        <dt>Website</dt>
        <dd><a href={data.affiliate_link ?? data.website} rel="sponsored noopener">{data.website}</a></dd>

        <dt>Pricing</dt>
        <dd>
          {data.pricing_model}
          {data.pricing_starts_at != null && <> · from ${data.pricing_starts_at}/mo</>}
          {data.pricing_url && (
            <> · <a href={data.pricing_url} rel="noopener">pricing page</a></>
          )}
        </dd>

        <dt>AI-native</dt>
        <dd>{data.ai_native ? "Yes" : "No"}</dd>

        {data.mcp_available !== undefined && (
          <>
            <dt>MCP server</dt>
            <dd>{data.mcp_available ? "Yes" : "No"}</dd>
          </>
        )}

        {data.api_available !== undefined && (
          <>
            <dt>Public API</dt>
            <dd>{data.api_available ? "Yes" : "No"}</dd>
          </>
        )}

        {data.ooligo_score !== undefined && (
          <>
            <dt>ooligo score</dt>
            <dd>{data.ooligo_score} / 10</dd>
          </>
        )}

        {data.integrations && data.integrations.length > 0 && (
          <>
            <dt>Integrations</dt>
            <dd>{data.integrations.join(", ")}</dd>
          </>
        )}

        <dt>Last reviewed</dt>
        <dd>{data.last_reviewed}</dd>
      </dl>
    </section>

    <article>
      <Content />
    </article>
  </main>
</BaseLayout>
