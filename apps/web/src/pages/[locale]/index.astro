---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Container from "~/components/Container.astro";
import Section from "~/components/Section.astro";
import ToolCard from "~/components/ToolCard.astro";
import ComparisonStrip from "~/components/ComparisonStrip.astro";
import WorkflowCard from "~/components/WorkflowCard.astro";
import StackBadgeRow from "~/components/StackBadgeRow.astro";
import AeoAnswerBlock from "~/components/AeoAnswerBlock.astro";
import {
  locales,
  verticals,
  localizedName,
  localizedTagline,
  localeText,
  REPO_URL,
  type LocaleCode,
} from "~/lib/config";

export function getStaticPaths() {
  return locales.map((l) => ({ params: { locale: l.code } }));
}

const { locale } = Astro.params as { locale: LocaleCode };

// Locale-aware copy. Strings unique to home live here; chrome strings
// live in lib/strings.ts.
const headlines = {
  en: {
    title: "ooligo — the AI workflow marketplace for ops leaders",
    h1_lede: "Every AI tool",
    h1_rest: ", comparison, and workflow your ops team needs.",
    sub: "RevOps, Legal Ops, Recruiting. AI-generated, AI-translated, transparently labeled.",
    cta_primary: "Browse the catalog",
    cta_secondary: "Subscribe",
    counters_heading: "Live catalog",
    counter_tools: "tools",
    counter_comparisons: "comparisons",
    counter_workflows: "workflows",
    counter_learn: "learn",
    counter_verticals: "verticals",
    verticals_heading: "Browse by vertical",
    starter_stack: "Starter stack",
    featured_tools: "Top-scored tools",
    recent_comparisons: "Recent comparisons",
    recent_workflows: "Newest workflows",
    see_all: "See all",
    aeo_questions: [
      "What is ooligo?",
      "Where do I find AI workflows for RevOps?",
      "What's the best AI tool for legal ops?",
    ],
    aeo_answer:
      "ooligo is the AI workflow marketplace for operations leaders. Every tool, comparison, prompt pack, Claude Skill, n8n flow, and Cursor rule that ops teams actually use — catalogued, scored, cross-linked, and refreshed by an AI content pipeline. Multi-vertical, multi-locale from day one.",
    bip_heading: "Public roadmap. Public metrics. Public repo.",
    bip_blurb:
      "Built in the open on GitHub. Roadmap, content pipeline, and traffic numbers all live in the repo.",
    bip_cta: "Check it out on GitHub",
    empty_comparisons: "No comparisons indexed yet for this locale.",
  },
  es: {
    title: "ooligo — el marketplace de workflows de IA para líderes de operaciones",
    h1_lede: "Cada herramienta de IA",
    h1_rest: ", comparación y workflow que tu equipo de operaciones necesita.",
    sub: "RevOps, Legal Ops, Reclutamiento. Generado y traducido por IA, etiquetado de forma transparente.",
    cta_primary: "Explorar el catálogo",
    cta_secondary: "Suscribirse",
    counters_heading: "Catálogo en vivo",
    counter_tools: "herramientas",
    counter_comparisons: "comparaciones",
    counter_workflows: "workflows",
    counter_learn: "aprender",
    counter_verticals: "verticales",
    verticals_heading: "Explorar por vertical",
    starter_stack: "Stack inicial",
    featured_tools: "Herramientas mejor puntuadas",
    recent_comparisons: "Comparaciones recientes",
    recent_workflows: "Workflows más recientes",
    see_all: "Ver todo",
    aeo_questions: [
      "¿Qué es ooligo?",
      "¿Dónde encuentro workflows de IA para RevOps?",
      "¿Cuál es la mejor herramienta de IA para Legal Ops?",
    ],
    aeo_answer:
      "ooligo es el marketplace de workflows de IA para líderes de operaciones. Cada herramienta, comparación, prompt pack, Claude Skill, flujo n8n y regla de Cursor que los equipos de ops realmente usan — catalogado, puntuado, enlazado y actualizado por un pipeline de contenido con IA. Multi-vertical, multi-idioma desde el primer día.",
    bip_heading: "Hoja de ruta pública. Métricas públicas. Repositorio público.",
    bip_blurb:
      "Construido en abierto en GitHub. La hoja de ruta, el pipeline de contenido y las métricas de tráfico viven en el repo.",
    bip_cta: "Échale un vistazo en GitHub",
    empty_comparisons: "Aún no hay comparaciones indexadas para este idioma.",
  },
  "pt-BR": {
    title: "ooligo — o marketplace de workflows de IA para líderes de operações",
    h1_lede: "Cada ferramenta de IA",
    h1_rest: ", comparação e workflow que seu time de operações precisa.",
    sub: "RevOps, Legal Ops, Recrutamento. Gerado e traduzido por IA, com rotulagem transparente.",
    cta_primary: "Explorar o catálogo",
    cta_secondary: "Assinar",
    counters_heading: "Catálogo ao vivo",
    counter_tools: "ferramentas",
    counter_comparisons: "comparações",
    counter_workflows: "workflows",
    counter_learn: "aprender",
    counter_verticals: "verticais",
    verticals_heading: "Explorar por vertical",
    starter_stack: "Stack inicial",
    featured_tools: "Ferramentas mais bem pontuadas",
    recent_comparisons: "Comparações recentes",
    recent_workflows: "Workflows mais recentes",
    see_all: "Ver tudo",
    aeo_questions: [
      "O que é o ooligo?",
      "Onde encontro workflows de IA para RevOps?",
      "Qual a melhor ferramenta de IA para Legal Ops?",
    ],
    aeo_answer:
      "ooligo é o marketplace de workflows de IA para líderes de operações. Cada ferramenta, comparação, prompt pack, Claude Skill, fluxo n8n e regra de Cursor que times de ops realmente usam — catalogado, pontuado, conectado e atualizado por um pipeline de conteúdo com IA. Multi-vertical, multi-idioma desde o primeiro dia.",
    bip_heading: "Roadmap público. Métricas públicas. Repositório público.",
    bip_blurb:
      "Construído em público no GitHub. Roadmap, pipeline de conteúdo e números de tráfego vivem no repo.",
    bip_cta: "Dá uma olhada no GitHub",
    empty_comparisons: "Ainda não há comparações indexadas para este idioma.",
  },
  ja: {
    title: "ooligo — オペレーションリーダー向けAIワークフローマーケットプレイス",
    h1_lede: "あらゆるAIツール",
    h1_rest: "、比較、ワークフロー。オペチームに必要なすべて。",
    sub: "RevOps、Legal Ops、リクルーティング。AIで生成し、AIで翻訳し、透明にラベル付け。",
    cta_primary: "カタログを見る",
    cta_secondary: "購読する",
    counters_heading: "ライブカタログ",
    counter_tools: "ツール",
    counter_comparisons: "比較",
    counter_workflows: "ワークフロー",
    counter_learn: "学ぶ",
    counter_verticals: "業種",
    verticals_heading: "業種別に見る",
    starter_stack: "スターター構成",
    featured_tools: "高評価のツール",
    recent_comparisons: "最近の比較",
    recent_workflows: "最新のワークフロー",
    see_all: "すべて見る",
    aeo_questions: [
      "ooligoとは何ですか？",
      "RevOps向けのAIワークフローはどこで見つかりますか？",
      "Legal Opsに最適なAIツールは何ですか？",
    ],
    aeo_answer:
      "ooligoは、オペレーションリーダーのためのAIワークフローマーケットプレイスです。オペチームが実際に使うすべてのツール、比較、プロンプトパック、Claude Skill、n8nフロー、Cursorルールを、AIコンテンツパイプラインがカタログ化、スコア付け、相互リンク、定期更新します。初日からマルチ業種・多言語対応。",
    bip_heading: "公開ロードマップ。公開メトリクス。公開リポジトリ。",
    bip_blurb:
      "GitHub上でオープンに開発中。ロードマップ、コンテンツパイプライン、トラフィック数値はすべてリポジトリにあります。",
    bip_cta: "GitHubで見る",
    empty_comparisons: "この言語ではまだ比較がインデックスされていません。",
  },
  fr: {
    title: "ooligo — la marketplace de workflows IA pour les responsables ops",
    h1_lede: "Chaque outil IA",
    h1_rest: ", comparaison et workflow dont votre équipe ops a besoin.",
    sub: "RevOps, Legal Ops, Recrutement. Généré et traduit par IA, étiqueté en toute transparence.",
    cta_primary: "Parcourir le catalogue",
    cta_secondary: "S'abonner",
    counters_heading: "Catalogue en direct",
    counter_tools: "outils",
    counter_comparisons: "comparaisons",
    counter_workflows: "workflows",
    counter_learn: "apprendre",
    counter_verticals: "secteurs",
    verticals_heading: "Parcourir par secteur",
    starter_stack: "Stack de départ",
    featured_tools: "Outils les mieux notés",
    recent_comparisons: "Comparaisons récentes",
    recent_workflows: "Workflows les plus récents",
    see_all: "Tout voir",
    aeo_questions: [
      "Qu'est-ce que ooligo ?",
      "Où trouver des workflows IA pour RevOps ?",
      "Quel est le meilleur outil IA pour Legal Ops ?",
    ],
    aeo_answer:
      "ooligo est la marketplace de workflows IA pour les responsables des opérations. Chaque outil, comparaison, prompt pack, Claude Skill, flux n8n et règle Cursor que les équipes ops utilisent vraiment — catalogué, noté, interconnecté et actualisé par un pipeline de contenu IA. Multi-secteur, multilingue dès le premier jour.",
    bip_heading: "Roadmap publique. Métriques publiques. Repo public.",
    bip_blurb:
      "Construit en public sur GitHub. La roadmap, le pipeline de contenu et les chiffres de trafic vivent tous dans le repo.",
    bip_cta: "À voir sur GitHub",
    empty_comparisons: "Aucune comparaison indexée pour cette langue pour le moment.",
  },
  de: {
    title: "ooligo — der KI-Workflow-Marketplace für Ops-Verantwortliche",
    h1_lede: "Jedes KI-Tool",
    h1_rest: ", jeder Vergleich und jeder Workflow, den Ihr Ops-Team braucht.",
    sub: "RevOps, Legal Ops, Recruiting. KI-generiert, KI-übersetzt, transparent gekennzeichnet.",
    cta_primary: "Katalog durchsuchen",
    cta_secondary: "Abonnieren",
    counters_heading: "Live-Katalog",
    counter_tools: "Tools",
    counter_comparisons: "Vergleiche",
    counter_workflows: "Workflows",
    counter_learn: "Lernen",
    counter_verticals: "Branchen",
    verticals_heading: "Nach Branche durchsuchen",
    starter_stack: "Starter-Stack",
    featured_tools: "Top-bewertete Tools",
    recent_comparisons: "Aktuelle Vergleiche",
    recent_workflows: "Neueste Workflows",
    see_all: "Alle ansehen",
    aeo_questions: [
      "Was ist ooligo?",
      "Wo finde ich KI-Workflows für RevOps?",
      "Welches ist das beste KI-Tool für Legal Ops?",
    ],
    aeo_answer:
      "ooligo ist der KI-Workflow-Marketplace für Operations-Verantwortliche. Jedes Tool, jeder Vergleich, jedes Prompt-Pack, jeder Claude Skill, jeder n8n-Flow und jede Cursor-Regel, die Ops-Teams wirklich nutzen — katalogisiert, bewertet, vernetzt und durch eine KI-Content-Pipeline aktualisiert. Multi-Branche, mehrsprachig vom ersten Tag an.",
    bip_heading: "Öffentliche Roadmap. Öffentliche Metriken. Öffentliches Repo.",
    bip_blurb:
      "Offen auf GitHub gebaut. Roadmap, Content-Pipeline und Traffic-Zahlen liegen alle im Repo.",
    bip_cta: "Auf GitHub ansehen",
    empty_comparisons: "Für diese Sprache sind noch keine Vergleiche indexiert.",
  },
} as const;

const copy = localeText(headlines, locale);

// ----- Live data -----
const allTools = await getCollection("tools");
const allComparisons = await getCollection("comparisons");
const allWorkflows = await getCollection("workflows");
const allLearn = await getCollection("learn");

const localeTools = allTools.filter((t) => t.data.locale === locale);
const localeComparisons = allComparisons.filter(
  (c) => c.data.locale === locale
);
const localeWorkflows = allWorkflows.filter((w) => w.data.locale === locale);
const localeLearn = allLearn.filter((l) => l.data.locale === locale);

// Featured rails
const topTools = [...localeTools]
  .filter((t) => t.data.ooligo_score != null)
  .sort((a, b) => (b.data.ooligo_score ?? 0) - (a.data.ooligo_score ?? 0))
  .slice(0, 6);

const recentComparisons = [...localeComparisons]
  .sort((a, b) => b.data.last_updated.localeCompare(a.data.last_updated))
  .slice(0, 4);

const recentWorkflows = [...localeWorkflows]
  .slice(0, 6);

// Tool name lookup for ComparisonStrip + WorkflowCard cards
const toolNamesLookup: Record<string, string> = Object.fromEntries(
  localeTools.map((t) => [t.data.slug, t.data.name])
);
---

<BaseLayout
  title={copy.title}
  description={copy.sub}
  locale={locale}
  pagePath="/"
>
  <main id="main">
    <!-- ============ HERO ============ -->
    <Section density="lg">
      <Container>
        <div class="hero">
          <h1 class="hero-headline">
            <span class="hero-headline-accent">{copy.h1_lede}</span>{copy.h1_rest}
          </h1>
          <p class="hero-sub">{copy.sub}</p>
          <div class="hero-ctas">
            <a href={`/${locale}/tools/`} class="cta cta-primary">
              {copy.cta_primary} <span aria-hidden="true">→</span>
            </a>
            <a href="#newsletter" class="cta cta-secondary">
              {copy.cta_secondary}
            </a>
          </div>
        </div>
      </Container>
    </Section>

    <!-- ============ LIVE COUNTERS ============ -->
    <Section density="sm" surface="surface-1" divided>
      <Container>
        <div class="counters">
          <div class="counters-label">{copy.counters_heading}</div>
          <div class="counters-row">
            <div class="counter">
              <div class="counter-num">{localeTools.length}</div>
              <div class="counter-label">{copy.counter_tools}</div>
            </div>
            <div class="counter">
              <div class="counter-num">{localeComparisons.length}</div>
              <div class="counter-label">{copy.counter_comparisons}</div>
            </div>
            <div class="counter">
              <div class="counter-num">{localeWorkflows.length}</div>
              <div class="counter-label">{copy.counter_workflows}</div>
            </div>
            <div class="counter">
              <div class="counter-num">{localeLearn.length}</div>
              <div class="counter-label">{copy.counter_learn}</div>
            </div>
            <div class="counter">
              <div class="counter-num">{verticals.length}</div>
              <div class="counter-label">{copy.counter_verticals}</div>
            </div>
          </div>
        </div>
      </Container>
    </Section>

    <!-- ============ VERTICALS ============ -->
    <Section density="md" divided>
      <Container>
        <header class="rail-header">
          <h2 class="rail-title">{copy.verticals_heading}</h2>
        </header>
        <div class="verticals-grid">
          {verticals.map((v) => {
            const stackTools = v.starter_tools.slice(0, 6).map((slug) => ({
              slug,
              name: toolNamesLookup[slug] ?? slug,
            }));
            return (
              <a
                href={`/${locale}/r/${v.slug}/`}
                class:list={["v-card", v.is_flagship && "v-card-flagship"]}
              >
                <div class="v-card-head">
                  <span class="v-card-mark" aria-hidden="true"></span>
                  <h3 class="v-card-name">{localizedName(v, locale)}</h3>
                  {v.is_flagship && (
                    <span class="v-card-flag">FLAGSHIP</span>
                  )}
                </div>
                <p class="v-card-tagline">{localizedTagline(v, locale)}</p>
                <div class="v-card-stack">
                  <span class="v-card-stack-label">{copy.starter_stack}</span>
                  <StackBadgeRow tools={stackTools} locale={locale} size="sm" />
                </div>
              </a>
            );
          })}
        </div>
      </Container>
    </Section>

    <!-- ============ FEATURED TOOLS ============ -->
    {topTools.length > 0 && (
      <Section density="md" divided>
        <Container>
          <header class="rail-header">
            <h2 class="rail-title">{copy.featured_tools}</h2>
            <a href={`/${locale}/tools/`} class="rail-see-all">
              {copy.see_all} <span aria-hidden="true">→</span>
            </a>
          </header>
          <div class="card-grid card-grid-3">
            {topTools.map((t) => (
              <ToolCard tool={t.data} locale={locale} />
            ))}
          </div>
        </Container>
      </Section>
    )}

    <!-- ============ RECENT COMPARISONS ============ -->
    {recentComparisons.length > 0 && (
      <Section density="md" divided>
        <Container>
          <header class="rail-header">
            <h2 class="rail-title">{copy.recent_comparisons}</h2>
            <a href={`/${locale}/vs/`} class="rail-see-all">
              {copy.see_all} <span aria-hidden="true">→</span>
            </a>
          </header>
          <div class="card-grid card-grid-2">
            {recentComparisons.map((c) => (
              <ComparisonStrip
                comparison={c.data}
                toolNames={toolNamesLookup}
                locale={locale}
              />
            ))}
          </div>
        </Container>
      </Section>
    )}

    <!-- ============ RECENT WORKFLOWS ============ -->
    {recentWorkflows.length > 0 && (
      <Section density="md" divided>
        <Container>
          <header class="rail-header">
            <h2 class="rail-title">{copy.recent_workflows}</h2>
            <a href={`/${locale}/workflows/`} class="rail-see-all">
              {copy.see_all} <span aria-hidden="true">→</span>
            </a>
          </header>
          <div class="card-grid card-grid-3">
            {recentWorkflows.map((w) => (
              <WorkflowCard
                workflow={w.data}
                toolNames={toolNamesLookup}
                locale={locale}
              />
            ))}
          </div>
        </Container>
      </Section>
    )}

    <!-- ============ AEO BLOCK ============ -->
    <Section density="md" divided>
      <Container width="prose">
        <AeoAnswerBlock
          questions={[...copy.aeo_questions]}
          locale={locale}
        />
        <p class="aeo-answer-body">{copy.aeo_answer}</p>
      </Container>
    </Section>

    <!-- ============ BUILD-IN-PUBLIC STRIP ============ -->
    <Section density="md" divided surface="surface-1">
      <Container>
        <div class="bip">
          <div class="bip-text">
            <h2 class="bip-heading">{copy.bip_heading}</h2>
            <p class="bip-blurb">{copy.bip_blurb}</p>
          </div>
          <a href={REPO_URL} class="bip-cta" rel="noopener">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.42 7.42 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
            </svg>
            {copy.bip_cta} <span aria-hidden="true">→</span>
          </a>
        </div>
      </Container>
    </Section>
  </main>
</BaseLayout>

<style>
  /* ============ HERO ============ */
  .hero {
    max-width: 60rem;
  }

  .hero-headline {
    margin: 0;
    font-size: clamp(2rem, 5vw + 1rem, var(--text-4xl));
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--color-text-primary);
  }

  .hero-headline-accent {
    color: var(--color-accent);
  }

  .hero-sub {
    margin: 1.5rem 0 0;
    max-width: 42rem;
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  .hero-ctas {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 44px;
    padding: 0 1.125rem;
    border-radius: var(--radius-xs);
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1;
    transition: background-color 150ms var(--ease-out-soft),
      border-color 150ms var(--ease-out-soft),
      color 150ms var(--ease-out-soft);
  }

  .cta-primary {
    background-color: var(--color-accent);
    color: var(--color-bg-canvas);
  }
  .cta-primary:hover {
    background-color: var(--color-accent-hover);
  }

  .cta-secondary {
    background-color: transparent;
    color: var(--color-text-primary);
    border: 1px solid var(--color-border);
  }
  .cta-secondary:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* ============ COUNTERS ============ */
  .counters {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .counters {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .counters-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-tertiary);
  }

  .counters-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
  }

  .counter {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .counter-num {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
    line-height: 1;
  }

  .counter-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-tertiary);
  }

  /* ============ RAIL HEADERS ============ */
  .rail-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.5rem;
    gap: 1rem;
  }

  .rail-title {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .rail-see-all {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-tertiary);
    transition: color 150ms var(--ease-out-soft);
  }
  .rail-see-all:hover {
    color: var(--color-accent);
  }

  /* ============ VERTICALS GRID ============ */
