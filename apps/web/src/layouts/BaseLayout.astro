---
import "~/styles/global.css";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import JsonLd from "~/components/JsonLd.astro";
import { chromeStrings } from "~/lib/strings";
import {
  locales,
  defaultLocale,
  getLocale,
  ADSENSE_CLIENT,
  REPO_URL,
  SITE_NAME,
  SITE_AUTHOR_NAME,
  SITE_LOGO_PATH,
  type LocaleCode,
} from "~/lib/config";

interface Props {
  title: string;
  description: string;
  locale: LocaleCode;
  /** path of this page WITHOUT locale prefix, e.g. "/tools/clay" */
  pagePath: string;
  /**
   * Locales for which this page actually exists. Defaults to all locales
   * (true for pages parameterized purely by locale). Pass a subset for
   * detail pages whose translations don't yet exist — prevents emitting
   * hreflang tags pointing at 404s.
   */
  availableLocales?: LocaleCode[];
  /**
   * Path (relative to site) of the OG image for this page. Defaults to
   * the default brand OG. Pages with rich entity data (tools / vs /
   * workflows / learn / r) override with their per-entity SVG.
   */
  ogImagePath?: string;
}

const {
  title,
  description,
  locale,
  pagePath,
  availableLocales,
  ogImagePath = "/og.svg",
} = Astro.props;
const localesForHreflang = availableLocales
  ? locales.filter((l) => availableLocales.includes(l.code))
  : locales;
const site = Astro.site?.toString().replace(/\/$/, "") ?? "https://ooligo.com";
const t = chromeStrings(locale);

// Always emit trailing-slash URLs so canonical/hreflang match the served URL
// (Cloudflare Pages serves directory-format builds with trailing slash).
function withTrailingSlash(p: string): string {
  if (p === "" || p === "/") return "/";
  return p.endsWith("/") ? p : `${p}/`;
}

const canonicalPath = `/${locale}${withTrailingSlash(pagePath)}`;
const canonicalUrl = `${site}${canonicalPath}`;
const ogImageUrl = ogImagePath.startsWith("http")
  ? ogImagePath
  : `${site}${ogImagePath}`;

// Site-wide Organization schema. Emitted on every page so Google and AI
// crawlers see a consistent publisher identity for E-E-A-T signals.
// Page-level JSON-LD (DefinedTerm, SoftwareApplication, etc.) references
// the same name via `publisher: { @type: "Organization", name: SITE_NAME }`.
const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: SITE_NAME,
  url: site,
  logo: `${site}${SITE_LOGO_PATH}`,
  sameAs: [REPO_URL],
  founder: {
    "@type": "Person",
    name: SITE_AUTHOR_NAME,
  },
};
---
<!DOCTYPE html>
<html lang={locale} dir={getLocale(locale)?.rtl ? "rtl" : "ltr"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {localesForHreflang.map((l) => (
      <link
        rel="alternate"
        hreflang={l.hreflang}
        href={`${site}/${l.code}${withTrailingSlash(pagePath)}`}
      />
    ))}
    {localesForHreflang.some((l) => l.code === defaultLocale) && (
      <link
        rel="alternate"
        hreflang="x-default"
        href={`${site}/${defaultLocale}${withTrailingSlash(pagePath)}`}
      />
    )}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <JsonLd data={organizationJsonLd} />
    <slot name="head" />
    {import.meta.env.PROD && (
      <>
        <script
          is:inline
          async
          src="https://www.googletagmanager.com/gtag/js?id=G-W6BZJ1Q021"
        ></script>
        <script is:inline define:vars={{ gaId: "G-W6BZJ1Q021" }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
    {import.meta.env.PROD && ADSENSE_CLIENT && (
      <>
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
          crossorigin="anonymous"
        ></script>
        <script is:inline>
          (function () {
            var CSS = ".ipr-container{background-color:#111114!important;color:#7a7a82!important;border-top-color:#27272f!important;border-bottom-color:#27272f!important}.ipr-button{color:#f0a500!important}.ipr-button:hover{color:#ffb733!important}";
            var STYLED = 'ooligoConsentStyled';
            function inject(host, root) {
              if (!host || !root || host.dataset[STYLED]) return false;
              if (!root.querySelector || !root.querySelector('.ipr-container')) return false;
              var s = document.createElement('style');
              s.textContent = CSS;
              root.appendChild(s);
              host.dataset[STYLED] = '1';
              return true;
            }
            function watch(host, root) {
              if (inject(host, root)) return;
              var mo = new MutationObserver(function () {
                if (inject(host, root)) mo.disconnect();
              });
              mo.observe(root, { childList: true, subtree: true });
            }
            var orig = Element.prototype.attachShadow;
            Element.prototype.attachShadow = function () {
              var sr = orig.apply(this, arguments);
              watch(this, sr);
              return sr;
            };
            function scanExisting() {
              var divs = document.querySelectorAll('div');
              for (var i = 0; i < divs.length; i++) {
                var sr = divs[i].shadowRoot;
                if (sr) watch(divs[i], sr);
              }
            }
            if (document.readyState === 'loading') {
              document.addEventListener('DOMContentLoaded', scanExisting);
            } else {
              scanExisting();
            }
          })();
        </script>
      </>
    )}
  </head>
  <body class="bg-bg-canvas text-text-primary font-sans antialiased">
    <a href="#main" class="skip-link">{t.meta.skip_to_content}</a>
    <Header
      locale={locale}
      pagePath={pagePath}
      availableLocales={availableLocales}
    />
    <slot />
    <Footer locale={locale} />
  </body>
</html>

<style is:global>
  /* Skip link — visible only on keyboard focus */
  .skip-link {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    padding: 0.5rem 0.75rem;
    background: var(--color-bg-surface-2);
    color: var(--color-text-primary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    transform: translateY(-200%);
    transition: transform 150ms var(--ease-out-soft);
    z-index: 100;
  }
  .skip-link:focus-visible {
    transform: translateY(0);
  }
</style>
