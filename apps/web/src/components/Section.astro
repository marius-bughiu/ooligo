---
/**
 * Section — vertical rhythm primitive.
 *
 * Owns top/bottom padding and (optionally) a top border for the
 * "stacked horizontal bands" pattern that anchors the layout. Composes
 * with <Container> when an inner max-width is needed.
 *
 * Density tiers:
 *   - "sm" = 32px  (chrome rows, alerts)
 *   - "md" = 48px  (default content sections)
 *   - "lg" = 96px  (hero, vertical landings)
 */

interface Props {
  density?: "sm" | "md" | "lg";
  divided?: boolean;
  surface?: "canvas" | "surface-1" | "surface-2";
  as?: "section" | "div" | "header" | "footer" | "article";
  class?: string;
}

const {
  density = "md",
  divided = false,
  surface = "canvas",
  as: Tag = "section",
  class: className = "",
} = Astro.props;
---

<Tag
  class:list={[
    "section",
    `section-${density}`,
    `section-bg-${surface}`,
    divided && "section-divided",
    className,
  ]}
>
  <slot />
</Tag>

<style>
  .section {
    width: 100%;
  }
  .section-sm {
    padding-block: 2rem;
  }
  .section-md {
    padding-block: 3rem;
  }
  .section-lg {
    padding-block: 4rem;
  }

  @media (min-width: 768px) {
    .section-md {
      padding-block: 4rem;
    }
    .section-lg {
      padding-block: 6rem;
    }
  }

  .section-bg-canvas {
    background-color: var(--color-bg-canvas);
  }
  .section-bg-surface-1 {
    background-color: var(--color-bg-surface-1);
  }
  .section-bg-surface-2 {
    background-color: var(--color-bg-surface-2);
  }

  .section-divided {
    border-top: 1px solid var(--color-border-subtle);
  }
</style>
