---
/**
 * AdSlot — directly-sold image placement.
 *
 * Renders either a booked creative (a static image we host, linked with
 * rel="sponsored") or, when the placement is unsold, an "available" card
 * pointing at the advertising page. It never collapses: an empty slot holds
 * the same space a filled one would, so selling a slot changes no layout.
 *
 * This is NOT the AdSense unit — see SponsoredAdSlot.astro for that. No
 * third-party script, no cookie, no pixel: the image is ours and the click
 * is a plain link.
 *
 * Inventory and targeting live in ~/lib/ads.ts. Call sites pass the context
 * needed to resolve a creative — `tool` for tool-sidebar, `vertical` for
 * vertical-banner.
 */

import {
  AD_PLACEMENTS,
  ADS_CONTACT_EMAIL,
  resolveCreative,
  type AdPlacementId,
} from "~/lib/ads";
import { localeText, type LocaleCode } from "~/lib/config";

interface Props {
  placement: AdPlacementId;
  locale: LocaleCode;
  /** Tool slug — required for tool-sidebar targeting. */
  tool?: string;
  /** Vertical slug — required for vertical-banner targeting. */
  vertical?: string;
  class?: string;
}

const { placement, locale, tool, vertical, class: className = "" } = Astro.props;

const spec = AD_PLACEMENTS[placement];
const creative = resolveCreative({ placement, locale, tool, vertical });

// 728x90 is too short for a stacked placeholder; it gets a single-row layout.
const layout = spec.height < 150 ? "banner" : "box";

interface AdSlotStrings {
  sponsored: string;
  available: string;
  headline: string;
  blurb_box: string;
  blurb_banner: string;
  contact: string;
  details: string;
}

// Annotated rather than `as const`: localeText() takes a widened table, and
// const-asserting narrows every locale to its own literal type.
const strings: Partial<Record<LocaleCode, AdSlotStrings>> & {
  en: AdSlotStrings;
} = {
  en: {
    sponsored: "Sponsored",
    available: "Ad slot · available",
    headline: "Your ad here",
    blurb_box: "Reach the ops leaders evaluating this tool.",
    blurb_banner: "Reach the ops leaders following this track.",
    contact: "Enquire",
    details: "Placements & targeting",
  },
  es: {
    sponsored: "Patrocinado",
    available: "Espacio publicitario · disponible",
    headline: "Tu anuncio aquí",
    blurb_box: "Llega a los líderes de ops que están evaluando esta herramienta.",
    blurb_banner: "Llega a los líderes de ops que siguen esta vertical.",
    contact: "Consultar",
    details: "Formatos y segmentación",
  },
  "pt-BR": {
    sponsored: "Patrocinado",
    available: "Espaço publicitário · disponível",
    headline: "Seu anúncio aqui",
    blurb_box: "Alcance os líderes de ops que estão avaliando esta ferramenta.",
    blurb_banner: "Alcance os líderes de ops que acompanham esta vertical.",
    contact: "Consultar",
    details: "Formatos e segmentação",
  },
  ja: {
    sponsored: "広告",
    available: "広告枠 · 空き",
    headline: "この枠に広告を掲載できます",
    blurb_box: "このツールを検討している運用リーダーにリーチできます。",
    blurb_banner: "この分野をフォローしている運用リーダーにリーチできます。",
    contact: "問い合わせる",
    details: "掲載枠とターゲティング",
  },
  fr: {
    sponsored: "Sponsorisé",
    available: "Emplacement publicitaire · disponible",
    headline: "Votre annonce ici",
    blurb_box: "Touchez les responsables ops qui évaluent cet outil.",
    blurb_banner: "Touchez les responsables ops qui suivent cette verticale.",
    contact: "Nous contacter",
    details: "Emplacements et ciblage",
  },
  de: {
    sponsored: "Gesponsert",
    available: "Werbeplatz · verfügbar",
    headline: "Ihre Anzeige hier",
    blurb_box: "Erreichen Sie die Ops-Verantwortlichen, die dieses Tool prüfen.",
    blurb_banner: "Erreichen Sie die Ops-Verantwortlichen, die diesen Bereich verfolgen.",
    contact: "Anfragen",
    details: "Platzierungen & Targeting",
  },
};

const t = localeText(strings, locale);
const blurb = layout === "banner" ? t.blurb_banner : t.blurb_box;

// Subject line pre-fills which slot the enquiry is about, so an inbound mail
// arrives already qualified by placement + target.
const target = tool ?? vertical ?? "run-of-site";
const mailto = `mailto:${ADS_CONTACT_EMAIL}?subject=${encodeURIComponent(
  `Ad placement — ${spec.id} (${target})`,
)}`;

const advertiseHref = `/${locale}/advertise/`;
const label = creative ? `${t.sponsored} · ${creative.advertiser}` : t.available;
---

<aside
  class:list={["ad-slot", `ad-slot-${layout}`, className]}
  aria-label={label}
  data-placement={spec.id}
>
  <div class="ad-slot-label">
    <span class="ad-slot-dot" aria-hidden="true"></span>
    <span class="ad-slot-label-text">{label}</span>
  </div>

  {creative ? (
    <a
      class="ad-slot-creative"
      href={creative.href}
      rel="sponsored noopener"
      style={`aspect-ratio: ${spec.width} / ${spec.height}; max-width: ${spec.width}px;`}
    >
      <img
        src={creative.src}
        alt={creative.alt}
        width={spec.width}
        height={spec.height}
        loading="lazy"
        decoding="async"
      />
    </a>
  ) : (
    <div class="ad-slot-empty" style={`--slot-height: ${spec.height}px;`}>
      <p class="ad-slot-headline">{t.headline}</p>
      <p class="ad-slot-blurb">{blurb}</p>
      <p class="ad-slot-actions">
        <a class="ad-slot-action" href={mailto}>{t.contact} ↗</a>
        <span class="ad-slot-action-sep" aria-hidden="true">·</span>
        <a class="ad-slot-action" href={advertiseHref}>{t.details} →</a>
      </p>
    </div>
  )}
</aside>

<style>
  .ad-slot {
    display: block;
    background-color: var(--color-bg-surface-1);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    padding: 1rem;
  }

  /* ---- Disclosure label: identical chrome to the AdSense slot, so both
     kinds of paid placement read the same to a reader. ---- */
  .ad-slot-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-block-end: 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    line-height: 1;
  }

  .ad-slot-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-pill);
    background-color: var(--color-accent);
    flex-shrink: 0;
  }

  /* ---- Booked creative ---- */
  /* aspect-ratio and max-width come inline from the placement spec: the box
     is reserved before the image loads, and the creative is never upscaled
     past its intrinsic size when the column is wider than the unit. */
  .ad-slot-creative {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-xs);
    margin-inline: auto;
  }

  .ad-slot-creative img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* ---- Unsold placeholder ----
     Dashed border distinguishes "nothing sold here" from a live creative at
     a glance, without borrowing CTA styling from the affiliate button. */
  .ad-slot-empty {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0.375rem;
    text-align: center;
    padding: 1.25rem 1rem;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-xs);
    background-color: var(--color-bg-canvas);
  }

  .ad-slot-headline {
    margin: 0;
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
  }

  .ad-slot-blurb {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.45;
    max-width: 34ch;
  }

  .ad-slot-actions {
    margin: 0.25rem 0 0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .ad-slot-action {
    color: var(--color-accent);
    transition: color 150ms var(--ease-out-soft);
  }
  .ad-slot-action:hover {
    color: var(--color-text-primary);
  }
  .ad-slot-action-sep {
    color: var(--color-border);
  }

  /* ---- Box (300x250, sidebar) ----
     Match the creative's height so an unsold slot occupies exactly the space
     a booked one will. */
  .ad-slot-box .ad-slot-empty {
    min-height: var(--slot-height);
  }

  /* ---- Banner (728x90, vertical hub) ----
     90px is too short to stack; collapse to a single row once there's room.
     Below that the placeholder is allowed to grow — it is static content, so
     the extra height costs no layout shift. */
  @media (min-width: 768px) {
    .ad-slot-banner .ad-slot-empty {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.75rem;
      min-height: var(--slot-height);
      padding-block: 0.75rem;
      text-align: start;
    }
    .ad-slot-banner .ad-slot-blurb {
      max-width: none;
    }
    .ad-slot-banner .ad-slot-actions {
      margin-block-start: 0;
    }
  }
</style>
