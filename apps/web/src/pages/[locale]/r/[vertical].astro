---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import Container from "~/components/Container.astro";
import Section from "~/components/Section.astro";
import ToolCard from "~/components/ToolCard.astro";
import WorkflowCard from "~/components/WorkflowCard.astro";
import LearnCard from "~/components/LearnCard.astro";
import ComparisonStrip from "~/components/ComparisonStrip.astro";
import StackBadgeRow from "~/components/StackBadgeRow.astro";
import EmptyState from "~/components/EmptyState.astro";
import {
  locales,
  verticals,
  localizedName,
  localizedTagline,
  type LocaleCode,
} from "~/lib/config";
import { chromeStrings } from "~/lib/strings";

export function getStaticPaths() {
  const paths: Array<{ params: { locale: string; vertical: string } }> = [];
  for (const l of locales) {
    for (const v of verticals) {
      paths.push({ params: { locale: l.code, vertical: v.slug } });
    }
  }
  return paths;
}

const { locale, vertical: verticalSlug } = Astro.params as {
  locale: LocaleCode;
  vertical: string;
};

const vertical = verticals.find((v) => v.slug === verticalSlug);
if (!vertical) {
  return Astro.redirect(`/${locale}/`, 302);
}

const name = localizedName(vertical, locale);
const tagline = localizedTagline(vertical, locale);
const chrome = chromeStrings(locale);

// ----- Localized strings -----
const labels = {
  en: {
    icp_label: "Built for",
    section_starter_stack: "Starter stack",
    section_top_tools: "Top tools",
    section_top_workflows: "Top workflows",
    section_recent_comparisons: "Recent comparisons",
    section_glossary: "Glossary essentials",
    see_all: "See all",
    newsletter_heading: "Briefings for {name}",
    newsletter_blurb:
      "New tools, comparisons, and workflows for this track. Free, weekly, locale-tagged.",
    newsletter_cta: "Subscribe",
    newsletter_topic: "Topic",
    counter_tools: "tools",
    counter_workflows: "workflows",
    counter_learn: "learn entries",
    flagship_label: "FLAGSHIP",
    pre_launch:
      "This vertical is online but the catalog is still being seeded for this locale. Browse the global catalog while we build it out.",
    pre_launch_cta: "Browse catalog",
  },
  es: {
    icp_label: "Construido para",
    section_starter_stack: "Stack inicial",
    section_top_tools: "Herramientas destacadas",
    section_top_workflows: "Workflows destacados",
    section_recent_comparisons: "Comparaciones recientes",
    section_glossary: "Esenciales del glosario",
    see_all: "Ver todo",
    newsletter_heading: "Briefings para {name}",
    newsletter_blurb:
      "Nuevas herramientas, comparaciones y workflows para este track. Gratis, semanal, con tag por idioma.",
    newsletter_cta: "Suscribirse",
    newsletter_topic: "Tema",
    counter_tools: "herramientas",
    counter_workflows: "workflows",
    counter_learn: "entradas",
    flagship_label: "FLAGSHIP",
    pre_launch:
      "Este vertical está activo pero el catálogo aún se está poblando para este idioma. Explora el catálogo global mientras lo construimos.",
    pre_launch_cta: "Explorar catálogo",
  },
  "pt-BR": {
    icp_label: "Feito para",
    section_starter_stack: "Stack inicial",
    section_top_tools: "Ferramentas em destaque",
    section_top_workflows: "Workflows em destaque",
    section_recent_comparisons: "Comparações recentes",
    section_glossary: "Essenciais do glossário",
    see_all: "Ver tudo",
    newsletter_heading: "Briefings para {name}",
    newsletter_blurb:
      "Novas ferramentas, comparações e workflows desse track. Grátis, semanal, com tag por idioma.",
    newsletter_cta: "Assinar",
    newsletter_topic: "Tópico",
    counter_tools: "ferramentas",
    counter_workflows: "workflows",
    counter_learn: "entradas",
    flagship_label: "FLAGSHIP",
    pre_launch:
      "Esse vertical está no ar mas o catálogo ainda está sendo populado para este idioma. Explore o catálogo global enquanto construímos.",
    pre_launch_cta: "Explorar catálogo",
  },
} as const;

const t = labels[locale];

// ----- Live data, filtered to this locale + vertical -----
const allTools = await getCollection("tools");
const allWorkflows = await getCollection("workflows");
const allLearn = await getCollection("learn");
const allComparisons = await getCollection("comparisons");

const localeTools = allTools.filter((tt) => tt.data.locale === locale);
const localeWorkflows = allWorkflows.filter((w) => w.data.locale === locale);
const localeLearn = allLearn.filter((l) => l.data.locale === locale);
const localeComparisons = allComparisons.filter((c) => c.data.locale === locale);

const verticalTools = localeTools.filter((tt) =>
  tt.data.verticals.includes(vertical.slug)
);
const verticalWorkflows = localeWorkflows.filter((w) =>
  w.data.verticals.includes(vertical.slug)
);
const verticalLearn = localeLearn.filter((l) =>
  (l.data.verticals ?? []).includes(vertical.slug)
);
const verticalComparisons = localeComparisons.filter((c) =>
  c.data.verticals.includes(vertical.slug)
);

// ----- Tool name lookup (for cards that need it) -----
const toolNamesLookup: Record<string, string> = Object.fromEntries(
  localeTools.map((tt) => [tt.data.slug, tt.data.name])
);

// ----- Starter stack (resolved to entries when available) -----
const starterStackTools = vertical.starter_tools.map((slug) => {
  const entry = localeTools.find((tt) => tt.data.slug === slug);
  return {
    slug,
    name: toolNamesLookup[slug] ?? slug,
    entry,
  };
});

// ----- Featured rails -----
const topTools = [...verticalTools]
  .filter((tt) => tt.data.ooligo_score != null)
  .sort((a, b) => (b.data.ooligo_score ?? 0) - (a.data.ooligo_score ?? 0))
  .slice(0, 6);

const topWorkflows = verticalWorkflows.slice(0, 6);

const recentComparisons = [...verticalComparisons]
  .sort((a, b) => b.data.last_updated.localeCompare(a.data.last_updated))
  .slice(0, 4);

const glossaryEssentials = [...verticalLearn]
  .filter((l) => l.data.type === "definition" || l.data.type === "framework")
  .slice(0, 4);

// Total content for this vertical/locale
const totalForLocaleVertical =
  verticalTools.length +
  verticalWorkflows.length +
  verticalLearn.length +
  verticalComparisons.length;

const newsletterHeading = t.newsletter_heading.replace("{name}", name);
---

<BaseLayout
  title={`${name} — ooligo`}
  description={tagline}
  locale={locale}
  pagePath={`/r/${vertical.slug}`}
>
  <main id="main">
    <Section density="md">
      <Container>
        <Breadcrumbs
          items={[
            { label: "ooligo", href: `/${locale}/` },
            { label: chrome.nav.verticals },
            { label: name },
          ]}
        />
      </Container>
    </Section>

    <!-- ============ HERO ============ -->
    <Section density="lg">
      <Container>
        <div class="v-hero">
          <div class="v-hero-meta">
            <span class="v-hero-mark" aria-hidden="true"></span>
            <span class="v-hero-label">VERTICAL</span>
            {vertical.is_flagship && (
              <span class="v-hero-flag">{t.flagship_label}</span>
            )}
          </div>
          <h1 class="v-hero-name">{name}</h1>
          <p class="v-hero-tagline">{tagline}</p>
          <div class="v-hero-icp">
            <span class="v-hero-icp-label">{t.icp_label}</span>
            <span class="v-hero-icp-text">{vertical.icp}</span>
          </div>
          {totalForLocaleVertical > 0 && (
            <div class="v-hero-counters">
              {verticalTools.length > 0 && (
                <a href={`/${locale}/tools/`} class="v-counter">
                  <span class="v-counter-num">{verticalTools.length}</span>
                  <span class="v-counter-label">{t.counter_tools}</span>
                </a>
              )}
              {verticalWorkflows.length > 0 && (
                <a href={`/${locale}/workflows/`} class="v-counter">
                  <span class="v-counter-num">{verticalWorkflows.length}</span>
                  <span class="v-counter-label">{t.counter_workflows}</span>
                </a>
              )}
              {verticalLearn.length > 0 && (
                <a href={`/${locale}/learn/`} class="v-counter">
                  <span class="v-counter-num">{verticalLearn.length}</span>
                  <span class="v-counter-label">{t.counter_learn}</span>
                </a>
              )}
            </div>
          )}
        </div>
      </Container>
    </Section>

    <!-- ============ EMPTY STATE FOR PRE-LAUNCH LOCALES ============ -->
    {totalForLocaleVertical === 0 && (
      <Section density="md" divided>
        <Container>
          <EmptyState
            title={name}
            message={t.pre_launch}
            action={{ label: t.pre_launch_cta, href: `/${locale}/tools/` }}
          />
        </Container>
      </Section>
    )}

    <!-- ============ STARTER STACK ============ -->
    <Section density="md" divided>
      <Container>
        <header class="rail-header">
          <h2 class="rail-title">{t.section_starter_stack}</h2>
        </header>
        <div class="starter-stack">
          <StackBadgeRow
            tools={starterStackTools.map((s) => ({
              slug: s.slug,
              name: s.name,
            }))}
            locale={locale}
            size="md"
          />
        </div>
      </Container>
    </Section>

    <!-- ============ TOP TOOLS ============ -->
    {topTools.length > 0 && (
      <Section density="md" divided>
        <Container>
          <header class="rail-header">
            <h2 class="rail-title">{t.section_top_tools}</h2>
            <a href={`/${locale}/tools/`} class="rail-see-all">
              {t.see_all} <span aria-hidden="true">→</span>
            </a>
          </header>
          <div class="card-grid card-grid-3">
            {topTools.map((tt) => (
              <ToolCard tool={tt.data} locale={locale} />
            ))}
          </div>
        </Container>
      </Section>
    )}

    <!-- ============ TOP WORKFLOWS ============ -->
    {topWorkflows.length > 0 && (
      <Section density="md" divided>
        <Container>
          <header class="rail-header">
            <h2 class="rail-title">{t.section_top_workflows}</h2>
            <a href={`/${locale}/workflows/`} class="rail-see-all">
              {t.see_all} <span aria-hidden="true">→</span>
            </a>
          </header>
          <div class="card-grid card-grid-3">
            {topWorkflows.map((w) => (
              <WorkflowCard
                workflow={w.data}
                toolNames={toolNamesLookup}
                locale={locale}
              />
            ))}
          </div>
        </Container>
      </Section>
    )}

    <!-- ============ RECENT COMPARISONS ============ -->
    {recentComparisons.length > 0 && (
      <Section density="md" divided>
        <Container>
          <header class="rail-header">
            <h2 class="rail-title">{t.section_recent_comparisons}</h2>
            <a href={`/${locale}/vs/`} class="rail-see-all">
              {t.see_all} <span aria-hidden="true">→</span>
            </a>
          </header>
          <div class="card-grid card-grid-2">
            {recentComparisons.map((c) => (
              <ComparisonStrip
                comparison={c.data}
                toolNames={toolNamesLookup}
                locale={locale}
              />
            ))}
          </div>
        </Container>
      </Section>
    )}

    <!-- ============ GLOSSARY ESSENTIALS ============ -->
    {glossaryEssentials.length > 0 && (
      <Section density="md" divided>
        <Container>
          <header class="rail-header">
            <h2 class="rail-title">{t.section_glossary}</h2>
            <a href={`/${locale}/learn/`} class="rail-see-all">
              {t.see_all} <span aria-hidden="true">→</span>
            </a>
          </header>
          <div class="card-grid card-grid-3">
            {glossaryEssentials.map((l) => (
              <LearnCard entry={l.data} locale={locale} />
            ))}
          </div>
        </Container>
      </Section>
    )}

    <!-- ============ NEWSLETTER CTA ============ -->
    <Section density="md" divided surface="surface-1">
      <Container>
        <div class="v-newsletter" id="newsletter">
          <div class="v-newsletter-text">
            <div class="v-newsletter-topic">
              <span class="v-newsletter-topic-mark" aria-hidden="true"></span>
              {t.newsletter_topic} · {name}
            </div>
            <h2 class="v-newsletter-heading">{newsletterHeading}</h2>
            <p class="v-newsletter-blurb">{t.newsletter_blurb}</p>
          </div>
          <form
            class="v-newsletter-form"
            method="post"
            data-beehiiv-pending
            data-newsletter-id={vertical.newsletter_id}
          >
            <label class="visually-hidden" for="vertical-email">
              you@company.com
            </label>
            <input
              id="vertical-email"
              type="email"
              name="email"
              class="v-newsletter-input"
              placeholder="you@company.com"
              autocomplete="email"
              required
            />
            <button type="submit" class="v-newsletter-submit">
              {t.newsletter_cta}
            </button>
          </form>
        </div>
      </Container>
    </Section>
  </main>
</BaseLayout>

<style>
  /* ============ HERO ============ */
  .v-hero {
    max-width: 64rem;
  }

  .v-hero-meta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-tertiary);
    margin-bottom: 1.25rem;
  }
  .v-hero-mark {
    width: 8px;
    height: 8px;
    background-color: var(--color-accent);
    border-radius: 1px;
    flex-shrink: 0;
  }
  .v-hero-label {
    font-weight: 600;
  }
  .v-hero-flag {
    margin-left: 0.5rem;
    padding: 0.2rem 0.45rem;
    color: var(--color-accent);
    background-color: color-mix(
      in oklab,
      var(--color-accent) 10%,
      transparent
    );
    border: 1px solid
      color-mix(in oklab, var(--color-accent) 30%, var(--color-border-subtle));
    border-radius: var(--radius-xs);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .v-hero-name {
    margin: 0;
    font-size: clamp(2.25rem, 5vw + 1rem, var(--text-4xl));
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .v-hero-tagline {
    margin: 1.25rem 0 0;
    max-width: 50rem;
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  .v-hero-icp {
    margin-top: 1.5rem;
    padding: 0.75rem 1rem;
    border-left: 2px solid var(--color-border);
    background-color: var(--color-bg-surface-1);
    border-radius: 0 var(--radius-xs) var(--radius-xs) 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  @media (min-width: 768px) {
    .v-hero-icp {
      flex-direction: row;
      align-items: baseline;
      gap: 0.75rem;
    }
  }
  .v-hero-icp-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-tertiary);
    flex-shrink: 0;
  }
  .v-hero-icp-text {
    color: var(--color-text-primary);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .v-hero-counters {
    margin-top: 2rem;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .v-counter {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.5rem 0.75rem;
    background-color: var(--color-bg-surface-1);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xs);
    color: var(--color-text-primary);
    transition: border-color 150ms var(--ease-out-soft),
      background-color 150ms var(--ease-out-soft);
  }
  .v-counter:hover {
    border-color: var(--color-accent);
    background-color: var(--color-bg-surface-2);
  }
  .v-counter-num {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text-primary);
  }
  .v-counter-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-tertiary);
  }

  /* ============ STARTER STACK ============ */
  .starter-stack {
    /* StackBadgeRow handles its own layout */
  }

  /* ============ RAIL HEADERS ============ */
  .rail-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.5rem;
    gap: 1rem;
  }
  .rail-title {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .rail-see-all {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-tertiary);
    transition: color 150ms var(--ease-out-soft);
  }
  .rail-see-all:hover {
    color: var(--color-accent);
  }

  /* ============ CARD GRIDS ============ */
  .card-grid {
    display: grid;
    gap: 1rem;
  }
  .card-grid-2 {
    grid-template-columns: 1fr;
  }
  .card-grid-3 {
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .card-grid-2 {
      grid-template-columns: repeat(2, 1fr);
    }
    .card-grid-3 {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .card-grid-3 {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ============ NEWSLETTER ============ */
  .v-newsletter {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: center;
  }
  @media (min-width: 768px) {
    .v-newsletter {
      grid-template-columns: 1.4fr 1fr;
      gap: 3rem;
    }
  }

  .v-newsletter-topic {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-tertiary);
    margin-bottom: 0.875rem;
  }
  .v-newsletter-topic-mark {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-pill);
    background-color: var(--color-accent);
  }

  .v-newsletter-heading {
    margin: 0;
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
  }

  .v-newsletter-blurb {
    margin: 0.75rem 0 0;
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.5;
    max-width: 48ch;
  }

  .v-newsletter-form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  @media (min-width: 480px) {
    .v-newsletter-form {
      flex-direction: row;
    }
  }

  .v-newsletter-input {
    flex: 1;
    height: 44px;
    padding: 0 0.875rem;
    background-color: var(--color-bg-surface-2);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xs);
    color: var(--color-text-primary);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    transition: border-color 150ms var(--ease-out-soft);
  }
  .v-newsletter-input::placeholder {
    color: var(--color-text-tertiary);
  }
  .v-newsletter-input:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 1px var(--color-accent);
  }

  .v-newsletter-submit {
    height: 44px;
    padding: 0 1rem;
    background-color: var(--color-accent);
    color: var(--color-bg-canvas);
    border: 0;
    border-radius: var(--radius-xs);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    transition: background-color 150ms var(--ease-out-soft);
  }
  .v-newsletter-submit:hover {
    background-color: var(--color-accent-hover);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
