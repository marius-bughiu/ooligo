---
/**
 * SpecRow — single row inside a <SpecTable>.
 *
 * Used when row values are richer than plain strings/numbers. Pair
 * with <SpecTable> in slot mode:
 *
 *   <SpecTable>
 *     <SpecRow label="Pricing">
 *       <PricingLabel model="usage-based" startsAt={149} />
 *     </SpecRow>
 *     <SpecRow label="Score" mono>
 *       <ScorePill score={9.2} />
 *     </SpecRow>
 *   </SpecTable>
 *
 * Styles live globally on .spec-table .spec-row in SpecTable.astro
 * so this component owns no CSS — only structure.
 */

interface Props {
  label: string;
  mono?: boolean;
  class?: string;
}

const { label, mono = false, class: className = "" } = Astro.props;
---

<div class:list={["spec-row", className]}>
  <dt class="spec-label">{label}</dt>
  <dd class:list={["spec-value", mono && "spec-value-mono"]}>
    <slot />
  </dd>
</div>
