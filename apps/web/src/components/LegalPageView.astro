---
/**
 * LegalPageView — chrome for the four trust pages (about / privacy /
 * contact / terms). Renders the localized prose blocks from
 * `lib/legalStrings.ts` inside the standard Prose typography shell,
 * with a "last updated" line and an optional lead paragraph above the
 * first section.
 *
 * Pages compose this with their own `<BaseLayout>` and any extra
 * surfaces (e.g. the contact form on /contact/).
 */

import Container from "~/components/Container.astro";
import Section from "~/components/Section.astro";
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import Prose from "~/components/Prose.astro";
import { chromeStrings } from "~/lib/strings";
import type { LegalPage } from "~/lib/legalStrings";
import type { LocaleCode } from "~/lib/config";

interface Props {
  page: LegalPage;
  locale: LocaleCode;
  /** Footer chrome key for the breadcrumb label (e.g. "about", "privacy"). */
  breadcrumbKey: "about" | "privacy" | "contact" | "terms";
  /** Localized "Last updated" label. */
  lastUpdatedLabel: string;
}

const { page, locale, breadcrumbKey, lastUpdatedLabel } = Astro.props;
const chrome = chromeStrings(locale);
---

<Section density="md">
  <Container>
    <Breadcrumbs
      items={[
        { label: "ooligo", href: `/${locale}/` },
        { label: chrome.footer[breadcrumbKey] },
      ]}
    />

    <header class="legal-header">
      <h1 class="legal-title">{page.heading}</h1>
      <p class="legal-last-updated">
        <span class="legal-last-updated-label">{lastUpdatedLabel}</span>
        <span class="legal-last-updated-date">{page.lastUpdated}</span>
      </p>
    </header>

    <Prose width="prose">
      {page.lead && <p class="legal-lead">{page.lead}</p>}
      {page.sections.map((section) => (
        <section>
          <h2>{section.heading}</h2>
          {section.body.map((paragraph) => <p>{paragraph}</p>)}
        </section>
      ))}
      <slot />
    </Prose>
  </Container>
</Section>

<style>
  .legal-header {
    margin-bottom: 2rem;
  }
  .legal-title {
    margin: 0;
    font-size: var(--text-3xl);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .legal-last-updated {
    margin: 0.75rem 0 0;
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-tertiary);
  }
  .legal-last-updated-date {
    color: var(--color-text-secondary);
  }
  .legal-lead {
    font-size: var(--text-lg);
    color: var(--color-text-primary);
    line-height: 1.5;
    margin: 0 0 2rem;
  }
</style>
