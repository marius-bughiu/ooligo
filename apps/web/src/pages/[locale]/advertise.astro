---
/**
 * /[locale]/advertise/ — the rate sheet behind every AdSlot placeholder.
 *
 * The inventory table is generated from AD_PLACEMENTS + AD_RATE_CARD in
 * ~/lib/ads.ts, so the sizes and targeting documented here are the same
 * constants the slots render from. Prose lives in ~/lib/advertiseStrings.ts.
 *
 * The rate column only appears when AD_RATE_CARD is populated — pricing is
 * quote-on-request until then, and the table shape adapts on its own.
 */

import BaseLayout from "~/layouts/BaseLayout.astro";
import JsonLd from "~/components/JsonLd.astro";
import Breadcrumbs from "~/components/Breadcrumbs.astro";
import Container from "~/components/Container.astro";
import Section from "~/components/Section.astro";
import Prose from "~/components/Prose.astro";
import AdSlot from "~/components/AdSlot.astro";
import {
  AD_PLACEMENTS,
  AD_RATE_CARD,
  ADS_CONTACT_EMAIL,
  type AdPlacementId,
} from "~/lib/ads";
import { locales, SITE_NAME, type LocaleCode } from "~/lib/config";
import { chromeStrings } from "~/lib/strings";
import { advertisePage } from "~/lib/advertiseStrings";
import { lastUpdatedLabel } from "~/lib/legalStrings";

export function getStaticPaths() {
  return locales.map((l) => ({ params: { locale: l.code } }));
}

const { locale } = Astro.params as { locale: LocaleCode };
const page = advertisePage(locale);
const chrome = chromeStrings(locale);

const placementIds = Object.keys(AD_PLACEMENTS) as AdPlacementId[];
const rows = placementIds.map((id) => {
  const spec = AD_PLACEMENTS[id];
  const copy = page.placements[id];
  return {
    id,
    name: copy.name,
    format: `${spec.width} × ${spec.height}`,
    where: copy.where,
    targeting: copy.targeting,
    rate: AD_RATE_CARD?.[id] ?? page.rateOnRequest,
  };
});

const mailto = `mailto:${ADS_CONTACT_EMAIL}?subject=${encodeURIComponent(
  "Ad placement enquiry",
)}`;

// FAQPage schema — same AEO treatment the learn entries get, so the
// advertising terms are machine-readable alongside everything else.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: page.faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: f.a.join(" "),
    },
  })),
  dateModified: page.lastUpdated,
  publisher: {
    "@type": "Organization",
    name: SITE_NAME,
  },
};
---

<BaseLayout
  title={page.title}
  description={page.description}
  locale={locale}
  pagePath="/advertise"
>
  <JsonLd slot="head" data={jsonLd} />
  <main id="main">
    <Section density="md">
      <Container>
        <Breadcrumbs
          items={[
            { label: "ooligo", href: `/${locale}/` },
            { label: chrome.footer.advertise },
          ]}
        />

        <header class="adv-header">
          <h1 class="adv-title">{page.heading}</h1>
          <p class="adv-last-updated">
            <span>{lastUpdatedLabel(locale)}</span>
            <span class="adv-last-updated-date">{page.lastUpdated}</span>
          </p>
        </header>

        <p class="adv-lead">{page.lead}</p>
      </Container>
    </Section>

    <!-- ============ INVENTORY TABLE ============ -->
    <Section density="md" divided surface="surface-1">
      <Container>
        <h2 class="adv-section-title">{page.inventoryHeading}</h2>
        <p class="adv-section-intro">{page.inventoryIntro}</p>

        <div class="adv-table-scroll">
          <table class="adv-table">
            <thead>
              <tr>
                <th scope="col">{page.colPlacement}</th>
                <th scope="col">{page.colFormat}</th>
                <th scope="col">{page.colWhere}</th>
                <th scope="col">{page.colTargeting}</th>
                <th scope="col">{page.colRate}</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((row) => (
                <tr>
                  <th scope="row" class="adv-cell-name">{row.name}</th>
                  <td class="adv-cell-mono">{row.format}</td>
                  <td>{row.where}</td>
                  <td class="adv-cell-mono">{row.targeting}</td>
                  <td class="adv-cell-mono adv-cell-rate">{row.rate}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="adv-spec">
          <div class="adv-spec-label">{page.specHeading}</div>
          <p class="adv-spec-note">{page.specNote}</p>
        </div>
      </Container>
    </Section>

    <!-- ============ LIVE PREVIEW ============ -->
    <!-- The actual components, unsold, at their real sizes. An advertiser
         evaluating the page sees exactly what they'd be buying. -->
    <Section density="md" divided>
      <Container>
        <div class="adv-preview">
          <div class="adv-preview-col adv-preview-box">
            <AdSlot placement="tool-sidebar" locale={locale} />
          </div>
          <div class="adv-preview-col">
            <AdSlot placement="vertical-banner" locale={locale} />
          </div>
        </div>
      </Container>
    </Section>

    <!-- ============ PROSE ============ -->
    <Section density="md" divided>
      <Container>
        <Prose width="prose">
          {page.sections.map((section) => (
            <section>
              <h2>{section.heading}</h2>
              {section.body.map((paragraph) => <p>{paragraph}</p>)}
            </section>
          ))}

          <section>
            <h2>{page.faqHeading}</h2>
            {page.faqs.map((faq) => (
              <>
                <h3>{faq.q}</h3>
                {faq.a.map((paragraph) => <p>{paragraph}</p>)}
              </>
            ))}
          </section>
        </Prose>
      </Container>
    </Section>

    <!-- ============ CTA ============ -->
    <Section density="md" divided surface="surface-1">
      <Container>
        <div class="adv-cta">
          <h2 class="adv-cta-title">{page.ctaHeading}</h2>
          <p class="adv-cta-body">{page.ctaBody}</p>
          <a class="adv-cta-link" href={mailto}>{ADS_CONTACT_EMAIL} ↗</a>
        </div>
      </Container>
    </Section>
  </main>
</BaseLayout>

<style>
  /* ============ HEADER ============ */
  .adv-header {
    margin-bottom: 1.5rem;
  }
  .adv-title {
    margin: 0;
    font-size: var(--text-3xl);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .adv-last-updated {
    margin: 0.75rem 0 0;
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-tertiary);
  }
  .adv-last-updated-date {
    color: var(--color-text-secondary);
  }
  .adv-lead {
    margin: 0;
    max-width: var(--container-prose);
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--color-text-primary);
  }

  /* ============ SECTION HEADS ============ */
  .adv-section-title {
    margin: 0 0 0.75rem;
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .adv-section-intro {
    margin: 0 0 2rem;
    max-width: var(--container-prose);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  /* ============ INVENTORY TABLE ============ */
  /* Horizontal scroll container so five columns survive a 375px viewport
     without the page body scrolling sideways. */
  .adv-table-scroll {
    overflow-x: auto;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    background-color: var(--color-bg-canvas);
  }

  .adv-table {
    width: 100%;
    min-width: 46rem;
    border-collapse: collapse;
    font-size: var(--text-sm);
    text-align: start;
  }

  .adv-table th,
  .adv-table td {
    padding: 0.875rem 1rem;
    text-align: start;
    vertical-align: top;
  }

  .adv-table thead th {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-tertiary);
    border-bottom: 1px solid var(--color-border-subtle);
    white-space: nowrap;
  }

  .adv-table tbody tr + tr th,
  .adv-table tbody tr + tr td {
    border-top: 1px solid var(--color-border-subtle);
  }

  .adv-table tbody td {
    color: var(--color-text-secondary);
  }

  .adv-cell-name {
    font-weight: 600;
    color: var(--color-text-primary);
    white-space: nowrap;
  }

  .adv-cell-mono {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  .adv-cell-rate {
    color: var(--color-accent);
  }

  /* ============ CREATIVE SPEC ============ */
  .adv-spec {
    margin-top: 1.5rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    background-color: var(--color-bg-surface-2);
    max-width: var(--container-prose);
  }
  .adv-spec-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-tertiary);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  .adv-spec-note {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  /* ============ LIVE PREVIEW ============ */
  .adv-preview {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .adv-preview {
      grid-template-columns: 22rem minmax(0, 1fr);
      gap: 2rem;
    }
  }
  /* Constrain the sidebar unit to the width it actually gets on a tool page. */
  .adv-preview-box {
    max-width: 22rem;
  }

  /* ============ CTA ============ */
  .adv-cta {
    max-width: var(--container-prose);
  }
  .adv-cta-title {
    margin: 0 0 0.75rem;
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .adv-cta-body {
    margin: 0 0 1.25rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }
  .adv-cta-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-accent);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    padding: 0.625rem 1rem;
    transition:
      border-color 150ms var(--ease-out-soft),
      color 150ms var(--ease-out-soft);
  }
  .adv-cta-link:hover {
    border-color: var(--color-accent);
    color: var(--color-text-primary);
  }
</style>
