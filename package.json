{
  "name": "ooligo",
  "version": "0.0.1",
  "private": true,
  "description": "The AI workflow marketplace for ops leaders.",
  "homepage": "https://ooligo.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/marius-bughiu/ooligo.git"
  },
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "preview": "npm run preview --workspace=apps/web",
    "validate:config": "npm run validate:config --workspace=packages/pipeline",
    "validate": "npm run validate:config",
    "queue:translations": "npm run queue:translations --workspace=packages/pipeline",
    "queue:backfill-hashes": "npm run queue:backfill-hashes --workspace=packages/pipeline",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
