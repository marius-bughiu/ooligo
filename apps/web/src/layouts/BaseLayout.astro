---
import { locales, defaultLocale, type LocaleCode } from "~/lib/config";

interface Props {
  title: string;
  description: string;
  locale: LocaleCode;
  /** path of this page WITHOUT locale prefix, e.g. "/tools/clay" */
  pagePath: string;
}

const { title, description, locale, pagePath } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, "") ?? "https://ooligo.com";

// Always emit trailing-slash URLs so canonical/hreflang match the served URL
// (Cloudflare Pages serves directory-format builds with trailing slash).
function withTrailingSlash(p: string): string {
  if (p === "" || p === "/") return "/";
  return p.endsWith("/") ? p : `${p}/`;
}

const canonicalPath = `/${locale}${withTrailingSlash(pagePath)}`;
const canonicalUrl = `${site}${canonicalPath}`;
---
<!DOCTYPE html>
<html lang={locale} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {locales.map((l) => (
      <link
        rel="alternate"
        hreflang={l.hreflang}
        href={`${site}/${l.code}${withTrailingSlash(pagePath)}`}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={`${site}/${defaultLocale}${withTrailingSlash(pagePath)}`}
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
