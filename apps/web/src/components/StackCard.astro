---
/**
 * StackCard — curated stack grid/list cell.
 *
 * Mirrors WorkflowCard's information density: shows the constituent
 * tools (the stack itself), use case, difficulty, and tool count.
 * Caller passes resolved tool name lookup so the card doesn't
 * re-resolve per render.
 */

import type { CollectionEntry } from "astro:content";
import ToolMonogram from "./ToolMonogram.astro";
import type { LocaleCode } from "~/lib/config";
import { chromeStrings } from "~/lib/strings";

type StackData = CollectionEntry<"stacks">["data"];

interface Props {
  stack: StackData;
  /** Resolved tool name lookup keyed by slug. Missing slugs render the slug as fallback. */
  toolNames: Record<string, string>;
  locale: LocaleCode;
  class?: string;
}

const { stack, toolNames, locale, class: className = "" } = Astro.props;

const visibleTools = stack.tools.slice(0, 6);
const overflow = Math.max(0, stack.tools.length - visibleTools.length);

const difficultyLabel = chromeStrings(locale).difficulty[stack.difficulty];
---

<a
  href={`/${locale}/stacks/${stack.slug}/`}
  class:list={["stack-card", className]}
>
  <div class="stack-card-head">
    <span class="stack-card-mark" aria-hidden="true"></span>
    <span class="stack-card-label">STACK</span>
  </div>

  <h3 class="stack-card-title">{stack.title}</h3>

  {stack.use_case && (
    <p class="stack-card-use">{stack.use_case}</p>
  )}

  <div class="stack-card-tools">
    {visibleTools.map((slug) => (
      <ToolMonogram name={toolNames[slug] ?? slug} size={22} outlined />
    ))}
    {overflow > 0 && (
      <span class="stack-card-overflow">+{overflow}</span>
    )}
  </div>

  <div class="stack-card-meta">
    <span class="stack-card-difficulty">{difficultyLabel}</span>
    <span class="stack-card-sep" aria-hidden="true">·</span>
    <span class="stack-card-count">{stack.tools.length} tools</span>
  </div>
</a>

<style>
  .stack-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1rem;
    background-color: var(--color-bg-surface-1);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    color: var(--color-text-primary);
    transition: border-color 150ms var(--ease-out-soft),
      background-color 150ms var(--ease-out-soft);
  }
  .stack-card:hover {
    border-color: var(--color-border);
    background-color: var(--color-bg-surface-2);
  }

  .stack-card-head {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-tertiary);
  }
  .stack-card-mark {
    width: 8px;
    height: 8px;
    background-color: var(--color-accent);
    border-radius: 1px;
    flex-shrink: 0;
  }
  .stack-card-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
  }

  .stack-card-title {
    margin: 0;
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--color-text-primary);
  }

  .stack-card-use {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.4;
  }

  .stack-card-tools {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    flex-wrap: wrap;
  }

  .stack-card-overflow {
    display: inline-flex;
    align-items: center;
    height: 22px;
    padding: 0 0.45rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    border: 1px dashed var(--color-border-subtle);
    border-radius: var(--radius-xs);
  }

  .stack-card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    margin-top: auto;
  }

  .stack-card-difficulty {
    text-transform: lowercase;
  }
  .stack-card-sep {
    color: var(--color-border);
  }
  .stack-card-count {
    color: var(--color-text-tertiary);
  }
</style>
