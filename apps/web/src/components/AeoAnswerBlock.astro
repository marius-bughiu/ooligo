---
/**
 * AeoAnswerBlock — "this page answers" panel.
 *
 * For /learn detail pages (and selectively for tool / comparison
 * pages that have AEO target queries). Surfaces the target_questions
 * frontmatter as a panel at the top of long-form bodies, signaling
 * to both the reader AND the LLM crawler exactly which queries this
 * page is the canonical answer to.
 *
 * Treated as a brand asset per DESIGN.md — the AEO panel is one of
 * the visual signatures of the site.
 */

import { chromeStrings } from "~/lib/strings";
import { localeText, type LocaleCode } from "~/lib/config";

interface Props {
  questions: string[];
  locale: LocaleCode;
  /** Override the heading. Defaults to a localized "This page answers". */
  heading?: string;
  class?: string;
}

const {
  questions,
  locale,
  heading,
  class: className = "",
} = Astro.props;

const headings = {
  en: "This page answers",
  es: "Esta página responde",
  "pt-BR": "Esta página responde",
};

const resolvedHeading = heading ?? localeText(headings, locale);
---

{questions.length > 0 && (
  <aside class:list={["aeo-block", className]} aria-label={resolvedHeading}>
    <div class="aeo-heading">
      <span class="aeo-heading-mark" aria-hidden="true"></span>
      <span class="aeo-heading-label">{resolvedHeading}</span>
    </div>
    <ul class="aeo-list">
      {questions.map((q) => (
        <li class="aeo-question">{q}</li>
      ))}
    </ul>
  </aside>
)}

<style>
  .aeo-block {
    border: 1px solid var(--color-border-subtle);
    border-left: 2px solid var(--color-accent);
    border-radius: var(--radius-sm);
    background-color: var(--color-bg-surface-1);
    padding: 1.25rem 1.5rem;
  }

  .aeo-heading {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-tertiary);
    margin-bottom: 0.75rem;
  }

  .aeo-heading-mark {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-pill);
    background-color: var(--color-accent);
  }

  .aeo-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .aeo-question {
    color: var(--color-text-primary);
    font-size: var(--text-base);
    line-height: 1.45;
    padding-left: 1.25rem;
    position: relative;
  }
  .aeo-question::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.625em;
    width: 0.6rem;
    height: 1px;
    background-color: var(--color-border);
  }
</style>
