---
/**
 * WorkflowCard — workflow library grid/list cell.
 *
 * Composes ArtifactTypeIcon + tool monograms (the stack) + difficulty
 * + time. The stack row is information-dense — at glance the reader
 * knows what artifact_type, which tools, how hard, how long.
 *
 * Caller passes resolved tool entries (or names) so the card doesn't
 * re-resolve them per render — the page template hits getCollection
 * once and reuses.
 */

import type { CollectionEntry } from "astro:content";
import ArtifactTypeIcon from "./ArtifactTypeIcon.astro";
import ToolMonogram from "./ToolMonogram.astro";
import type { LocaleCode } from "~/lib/config";
import { chromeStrings } from "~/lib/strings";

type WorkflowData = CollectionEntry<"workflows">["data"];

interface Props {
  workflow: WorkflowData;
  /** Resolved tool name lookup keyed by slug. Missing slugs render the slug as fallback. */
  toolNames: Record<string, string>;
  locale: LocaleCode;
  class?: string;
}

const { workflow, toolNames, locale, class: className = "" } = Astro.props;

const stack = workflow.tools_used.slice(0, 5);
const overflow = Math.max(0, workflow.tools_used.length - stack.length);

const difficultyLabel = chromeStrings(locale).difficulty[workflow.difficulty];
---

<a
  href={`/${locale}/workflows/${workflow.slug}/`}
  class:list={["workflow-card", className]}
>
  <div class="workflow-card-head">
    <ArtifactTypeIcon type={workflow.artifact_type} size={18} />
    <div class="workflow-card-type">{workflow.artifact_type}</div>
  </div>

  <h3 class="workflow-card-title">{workflow.title}</h3>

  <div class="workflow-card-stack">
    {stack.map((slug) => (
      <ToolMonogram name={toolNames[slug] ?? slug} size={22} outlined />
    ))}
    {overflow > 0 && (
      <span class="workflow-card-overflow">+{overflow}</span>
    )}
  </div>

  <div class="workflow-card-meta">
    <span class="workflow-card-difficulty">{difficultyLabel}</span>
    {workflow.time_to_setup && (
      <>
        <span class="workflow-card-sep" aria-hidden="true">·</span>
        <span class="workflow-card-time">{workflow.time_to_setup}</span>
      </>
    )}
  </div>
</a>

<style>
  .workflow-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1rem;
    background-color: var(--color-bg-surface-1);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    color: var(--color-text-primary);
    transition: border-color 150ms var(--ease-out-soft),
      background-color 150ms var(--ease-out-soft);
  }
  .workflow-card:hover {
    border-color: var(--color-border);
    background-color: var(--color-bg-surface-2);
  }

  .workflow-card-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-tertiary);
  }

  .workflow-card-type {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .workflow-card-title {
    margin: 0;
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--color-text-primary);
  }

  .workflow-card-stack {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    flex-wrap: wrap;
  }

  .workflow-card-overflow {
    display: inline-flex;
    align-items: center;
    height: 22px;
    padding: 0 0.45rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    border: 1px dashed var(--color-border-subtle);
    border-radius: var(--radius-xs);
  }

  .workflow-card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    margin-top: auto;
  }

  .workflow-card-difficulty {
    text-transform: lowercase;
  }
  .workflow-card-sep {
    color: var(--color-border);
  }
</style>
