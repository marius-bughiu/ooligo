---
const attributes = Astro.props;
---
<div class="prose-table-scroll">
  <table {...attributes}><slot /></table>
</div>

<style>
  .prose-table-scroll {
    max-width: 100%;
    overflow-x: auto;
    margin-bottom: 1.5rem;
  }

  .prose-table-scroll > table {
    margin-bottom: 0;
  }

  @media (max-width: 40rem) {
    .prose-table-scroll :global(th),
    .prose-table-scroll :global(td) {
      padding-inline: 0.5rem;
    }
  }
</style>
