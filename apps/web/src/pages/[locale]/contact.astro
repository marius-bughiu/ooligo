---
import BaseLayout from "~/layouts/BaseLayout.astro";
import LegalPageView from "~/components/LegalPageView.astro";
import { locales, REPO_URL, type LocaleCode } from "~/lib/config";
import { contactPage, lastUpdatedLabel } from "~/lib/legalStrings";

export function getStaticPaths() {
  return locales.map((l) => ({ params: { locale: l.code } }));
}

const { locale } = Astro.params as { locale: LocaleCode };
const page = contactPage(locale);
const f = page.form;
const issuesUrl = `${REPO_URL}/issues`;
---

<BaseLayout
  title={page.title}
  description={page.description}
  locale={locale}
  pagePath="/contact"
>
  <main id="main">
    <LegalPageView
      page={page}
      locale={locale}
      breadcrumbKey="contact"
      lastUpdatedLabel={lastUpdatedLabel(locale)}
    >
      <section class="contact-form-wrap">
        <form
          class="contact-form"
          method="post"
          action="/api/contact"
          data-contact-form
        >
          <label class="contact-field">
            <span class="contact-label">{f.name_label}</span>
            <input
              type="text"
              name="name"
              class="contact-input"
              autocomplete="name"
              required
              maxlength="100"
            />
          </label>

          <label class="contact-field">
            <span class="contact-label">{f.email_label}</span>
            <input
              type="email"
              name="email"
              class="contact-input"
              autocomplete="email"
              required
              maxlength="254"
            />
          </label>

          <label class="contact-field">
            <span class="contact-label">{f.message_label}</span>
            <textarea
              name="message"
              class="contact-textarea"
              rows="6"
              required
              maxlength="4000"
            ></textarea>
          </label>

          <button
            type="submit"
            class="contact-submit"
            data-label-default={f.submit}
            data-label-loading={f.submitting}
          >
            {f.submit}
          </button>

          <p
            class="contact-status"
            role="status"
            aria-live="polite"
            data-contact-status
            data-msg-success={f.success}
            data-msg-error={f.error}
            data-msg-invalid-email={f.invalid_email}
            hidden
          ></p>
        </form>

        <p class="contact-github">
          <span class="contact-github-intro">{f.github_intro}</span>
          {" "}
          <a class="contact-github-link" href={issuesUrl} rel="noopener">
            {f.github_link_label}
          </a>
        </p>
      </section>
    </LegalPageView>
  </main>
</BaseLayout>

<script is:inline>
  (() => {
    const form = document.querySelector("form[data-contact-form]");
    if (!(form instanceof HTMLFormElement)) return;
    const button = form.querySelector("[data-label-default]");
    const status = form.querySelector("[data-contact-status]");
    if (!button || !status) return;

    const labelDefault = button.getAttribute("data-label-default") || "";
    const labelLoading = button.getAttribute("data-label-loading") || labelDefault;
    const msgSuccess = status.getAttribute("data-msg-success") || "";
    const msgError = status.getAttribute("data-msg-error") || "";
    const msgInvalid = status.getAttribute("data-msg-invalid-email") || msgError;

    function showStatus(text, kind) {
      status.textContent = text;
      status.classList.remove("is-error", "is-success");
      status.classList.add(kind === "error" ? "is-error" : "is-success");
      status.hidden = false;
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const name = String(data.get("name") || "").trim();
      const email = String(data.get("email") || "").trim();
      const message = String(data.get("message") || "").trim();

      button.disabled = true;
      button.textContent = labelLoading;
      status.hidden = true;

      try {
        const res = await fetch(form.action, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ name, email, message }),
        });
        const json = await res.json().catch(() => ({}));

        if (res.ok && json && json.ok) {
          form.hidden = true;
          showStatus(msgSuccess, "success");
          return;
        }

        showStatus(json && json.error === "invalid_email" ? msgInvalid : msgError, "error");
      } catch {
        showStatus(msgError, "error");
      } finally {
        button.disabled = false;
        button.textContent = labelDefault;
      }
    });
  })();
</script>

<style>
  .contact-form-wrap {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 32rem;
  }

  .contact-field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .contact-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-tertiary);
  }

  .contact-input,
  .contact-textarea {
    width: 100%;
    padding: 0.625rem 0.75rem;
    background-color: var(--color-bg-surface-2);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xs);
    color: var(--color-text-primary);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: 1.5;
    transition: border-color 150ms var(--ease-out-soft);
  }
  .contact-input:focus,
  .contact-textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 1px var(--color-accent);
  }

  .contact-textarea {
    resize: vertical;
    min-height: 8rem;
  }

  .contact-submit {
    align-self: flex-start;
    height: 38px;
    padding: 0 1rem;
    background-color: var(--color-accent);
    color: var(--color-bg-canvas);
    border: 0;
    border-radius: var(--radius-xs);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    transition: background-color 150ms var(--ease-out-soft);
  }
  .contact-submit:hover {
    background-color: var(--color-accent-hover);
  }
  .contact-submit:disabled {
    cursor: not-allowed;
    opacity: 0.7;
  }

  .contact-status {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.5;
  }
  .contact-status.is-success {
    color: var(--color-accent);
  }
  .contact-status.is-error {
    color: var(--color-text-secondary);
  }

  .contact-github {
    margin: 1.5rem 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    max-width: 32rem;
  }
  .contact-github-link {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: color-mix(
      in oklab,
      var(--color-accent) 35%,
      transparent
    );
    text-underline-offset: 3px;
  }
  .contact-github-link:hover {
    text-decoration-color: var(--color-accent);
  }
</style>
