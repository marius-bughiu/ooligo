---
/**
 * ToolMonogram — typographic logo fallback.
 *
 * Renders the first letter of a tool name in a mono character box,
 * sized by `size`. Used everywhere a real vendor logo would normally
 * sit but isn't available, AND as the dense default for catalog grids
 * where loading 50+ vendor SVGs would inflate page weight.
 *
 * Color treatment is inverted from the rest of the surface ladder:
 * accent fill, canvas-color glyph. This makes monogram rows POP at
 * glance density, which is half the point of the catalog grid.
 */

interface Props {
  name: string;
  size?: number;
  /** When true, uses outlined treatment (transparent bg, accent border). */
  outlined?: boolean;
  class?: string;
}

const { name, size = 32, outlined = false, class: className = "" } = Astro.props;
const initial = (name.trim().charAt(0) || "·").toUpperCase();
const fontSize = `${Math.round(size * 0.5)}px`;
---

<span
  class:list={["monogram", outlined && "monogram-outlined", className]}
  style={`width:${size}px;height:${size}px;font-size:${fontSize}`}
  aria-label={name}
  role="img"
>
  {initial}
</span>

<style>
  .monogram {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background-color: var(--color-accent);
    color: var(--color-bg-canvas);
    font-family: var(--font-mono);
    font-weight: 600;
    border-radius: var(--radius-xs);
    line-height: 1;
    user-select: none;
  }

  .monogram-outlined {
    background-color: transparent;
    color: var(--color-accent);
    border: 1px solid color-mix(in oklab, var(--color-accent) 40%, var(--color-border-subtle));
  }
</style>
