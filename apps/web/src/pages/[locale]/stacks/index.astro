---
import { getCollection } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Container from "~/components/Container.astro";
import Section from "~/components/Section.astro";
import StackCard from "~/components/StackCard.astro";
import EmptyState from "~/components/EmptyState.astro";
import EditOnGitHub from "~/components/EditOnGitHub.astro";
import {
  locales,
  verticals,
  localizedName,
  localeText,
  REPO_URL,
  type LocaleCode,
} from "~/lib/config";
import { chromeStrings } from "~/lib/strings";

export function getStaticPaths() {
  return locales.map((l) => ({ params: { locale: l.code } }));
}

const { locale } = Astro.params as { locale: LocaleCode };
const chrome = chromeStrings(locale);

const labels = {
  en: {
    title: "Stacks",
    sub: "Curated tool combinations for ops leaders — what to deploy together, in what order, for which use case.",
    count_one: "stack indexed",
    count_many: "stacks indexed",
    filter_heading: "Filter",
    filter_vertical: "Vertical",
    filter_difficulty: "Difficulty",
    filter_reset: "Reset",
    diff_beginner: "Beginner",
    diff_intermediate: "Intermediate",
    diff_advanced: "Advanced",
    empty_title: "No stacks match",
    empty_message: "Try removing a filter or two.",
    pre_launch_title: "Stacks library being assembled",
    pre_launch_message:
      "Curated stacks are tested before publishing — first entries land as the team pushes them. Watch the repo to follow.",
    pre_launch_action: "Watch on GitHub",
  },
  es: {
    title: "Stacks",
    sub: "Combinaciones curadas de herramientas para líderes de operaciones — qué desplegar junto, en qué orden, para cada caso de uso.",
    count_one: "stack indexado",
    count_many: "stacks indexados",
    filter_heading: "Filtrar",
    filter_vertical: "Vertical",
    filter_difficulty: "Dificultad",
    filter_reset: "Restablecer",
    diff_beginner: "Principiante",
    diff_intermediate: "Intermedio",
    diff_advanced: "Avanzado",
    empty_title: "Ningún stack coincide",
    empty_message: "Prueba a quitar un filtro o dos.",
    pre_launch_title: "Biblioteca de stacks en construcción",
    pre_launch_message:
      "Los stacks curados se prueban antes de publicarse. Las primeras entradas llegan a medida que el equipo las sube.",
    pre_launch_action: "Seguir en GitHub",
  },
  "pt-BR": {
    title: "Stacks",
    sub: "Combinações curadas de ferramentas para líderes de operações — o que implantar junto, em que ordem, para cada caso de uso.",
    count_one: "stack indexada",
    count_many: "stacks indexadas",
    filter_heading: "Filtrar",
    filter_vertical: "Vertical",
    filter_difficulty: "Dificuldade",
    filter_reset: "Redefinir",
    diff_beginner: "Iniciante",
    diff_intermediate: "Intermediário",
    diff_advanced: "Avançado",
    empty_title: "Nenhuma stack encontrada",
    empty_message: "Tente remover um filtro ou dois.",
    pre_launch_title: "Biblioteca de stacks em construção",
    pre_launch_message:
      "Stacks curadas são testadas antes de publicar. As primeiras entradas chegam conforme o time publica.",
    pre_launch_action: "Acompanhar no GitHub",
  },
} as const;

const t = localeText(labels, locale);

const allStacks = await getCollection("stacks");
const allTools = await getCollection("tools");

const stacks = allStacks
  .filter((s) => s.data.locale === locale)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const toolNamesLookup: Record<string, string> = Object.fromEntries(
  allTools
    .filter((tool) => tool.data.locale === locale)
    .map((tool) => [tool.data.slug, tool.data.name])
);

const difficulties = [
  { value: "beginner", label: t.diff_beginner },
  { value: "intermediate", label: t.diff_intermediate },
  { value: "advanced", label: t.diff_advanced },
] as const;
---

<BaseLayout
  title={`${t.title} — ooligo`}
  description={t.sub}
  locale={locale}
  pagePath="/stacks"
>
  <main id="main">
    <Section density="md">
      <Container>
        <header class="page-header">
          <div class="page-header-text">
            <h1 class="page-title">{t.title}</h1>
            <p class="page-sub">
              <span id="result-count" class="page-count" data-singular={t.count_one} data-plural={t.count_many}>
                {stacks.length}
              </span>
              {" "}
              <span id="result-count-label">
                {stacks.length === 1 ? t.count_one : t.count_many}
              </span>
              {" · "}
              {t.sub}
            </p>
          </div>
          <div class="page-header-cta">
            <EditOnGitHub
              mode="new"
              collection="stacks"
              label={chrome.contribute.add_stack}
            />
          </div>
        </header>

        {stacks.length === 0 ? (
          <EmptyState
            title={t.pre_launch_title}
            message={t.pre_launch_message}
            action={{ label: t.pre_launch_action, href: REPO_URL }}
          />
        ) : (
          <div class="index-layout">
            <aside class="filter-rail" aria-label={t.filter_heading}>
              <details class="filter-details" open>
                <summary class="filter-rail-heading">
                  <span>{t.filter_heading}</span>
                  <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
                    <path d="M2 4l3 3 3-3" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </summary>

                <form id="filter-form" class="filter-form">
                  <fieldset class="filter-group">
                    <legend class="filter-legend">{t.filter_vertical}</legend>
                    {verticals.map((v) => (
                      <label class="filter-check">
                        <input type="checkbox" name="vertical" value={v.slug} />
                        <span class="filter-check-mark" aria-hidden="true"></span>
                        <span class="filter-check-label">{localizedName(v, locale)}</span>
                      </label>
                    ))}
                  </fieldset>

                  <fieldset class="filter-group">
                    <legend class="filter-legend">{t.filter_difficulty}</legend>
                    {difficulties.map((d) => (
                      <label class="filter-check">
                        <input type="checkbox" name="difficulty" value={d.value} />
                        <span class="filter-check-mark" aria-hidden="true"></span>
                        <span class="filter-check-label">{d.label}</span>
                      </label>
                    ))}
                  </fieldset>

                  <button type="reset" class="filter-reset">{t.filter_reset}</button>
                </form>
              </details>
            </aside>

            <div class="results-area">
              <div id="results" class="card-grid card-grid-3">
                {stacks.map((s) => (
                  <article
                    class="result-item"
                    data-verticals={s.data.verticals.join(",")}
                    data-difficulty={s.data.difficulty}
                  >
                    <StackCard
                      stack={s.data}
                      toolNames={toolNamesLookup}
                      locale={locale}
                    />
                  </article>
                ))}
              </div>

              <div id="empty-results" class="empty-results" hidden>
                <EmptyState
                  title={t.empty_title}
                  message={t.empty_message}
                />
              </div>
            </div>
          </div>
        )}
      </Container>
    </Section>
  </main>
</BaseLayout>

<script is:inline>
  (() => {
    const form = document.getElementById("filter-form");
    if (!form) return;

    const items = document.querySelectorAll(".result-item");
    const empty = document.getElementById("empty-results");
    const count = document.getElementById("result-count");
    const countLabel = document.getElementById("result-count-label");

    function readMulti(name) {
      return [...form.querySelectorAll(`input[name="${name}"]:checked`)].map(
        (i) => i.value
      );
    }

    function apply() {
      const fv = readMulti("vertical");
      const fdiff = readMulti("difficulty");

      let visible = 0;
      items.forEach((item) => {
        const verts = (item.dataset.verticals ?? "").split(",").filter(Boolean);
        const matchVertical = fv.length === 0 || fv.some((v) => verts.includes(v));
        const matchDiff = fdiff.length === 0 || fdiff.includes(item.dataset.difficulty);
        const show = matchVertical && matchDiff;
        item.hidden = !show;
        if (show) visible++;
      });

      if (empty) empty.hidden = visible > 0;
      if (count) count.textContent = String(visible);
      if (countLabel && count) {
        const sing = count.dataset.singular ?? "";
        const plur = count.dataset.plural ?? "";
        countLabel.textContent = visible === 1 ? sing : plur;
      }
    }

    form.addEventListener("change", apply);
    form.addEventListener("reset", () => requestAnimationFrame(apply));
    apply();
  })();
</script>

<style>
  /* Mirrors /workflows index layout — same filter rail + grid pattern. */
  .page-header {
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }
  @media (min-width: 768px) {
    .page-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
      gap: 1.5rem;
    }
  }

  .page-header-text {
    min-width: 0;
    flex: 1;
  }

  .page-header-cta {
    flex-shrink: 0;
  }
  .page-title {
    margin: 0;
    font-size: var(--text-3xl);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .page-sub {
    margin: 0.875rem 0 0;
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    line-height: 1.5;
    max-width: 60ch;
  }
  .page-count {
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--color-text-primary);
  }

  .index-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 1024px) {
    .index-layout {
      grid-template-columns: 14rem 1fr;
      gap: 2.5rem;
    }
  }

  .filter-rail {
    min-width: 0;
  }
  @media (min-width: 1024px) {
    .filter-rail {
      position: sticky;
      top: calc(64px + 1.5rem);
      align-self: start;
      max-height: calc(100vh - 96px);
      overflow-y: auto;
    }
  }

  .filter-details > summary {
    list-style: none;
    cursor: pointer;
    user-select: none;
  }
  .filter-details > summary::-webkit-details-marker {
    display: none;
  }
  @media (min-width: 1024px) {
    .filter-details > summary {
      cursor: default;
    }
  }

  .filter-rail-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    background-color: var(--color-bg-surface-1);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-tertiary);
  }
  .filter-details[open] > .filter-rail-heading svg {
    transform: rotate(180deg);
  }
  .filter-rail-heading svg {
    transition: transform 150ms var(--ease-out-soft);
  }
  @media (min-width: 1024px) {
    .filter-rail-heading {
      border: 0;
      background: transparent;
      padding: 0 0 1rem 0;
    }
    .filter-rail-heading svg {
      display: none;
    }
  }

  .filter-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 1rem;
    padding: 0 0.25rem;
  }
  @media (min-width: 1024px) {
    .filter-form {
      margin-top: 0;
      padding: 0;
    }
  }

  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .filter-legend {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-tertiary);
    margin-bottom: 0.25rem;
    padding: 0;
  }

  .filter-check {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    transition: color 150ms var(--ease-out-soft);
  }
  .filter-check:hover {
    color: var(--color-text-primary);
  }
  .filter-check input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .filter-check-mark {
    width: 14px;
    height: 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    background-color: var(--color-bg-surface-1);
    flex-shrink: 0;
    position: relative;
    transition: background-color 150ms var(--ease-out-soft),
      border-color 150ms var(--ease-out-soft);
  }
  .filter-check input:checked + .filter-check-mark {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .filter-check input:checked + .filter-check-mark::after {
    content: "";
    position: absolute;
    inset: 2px;
    background-color: var(--color-bg-canvas);
    clip-path: polygon(20% 50%, 0 70%, 40% 100%, 100% 30%, 80% 10%, 40% 70%);
  }
  .filter-check input:focus-visible + .filter-check-mark {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .filter-reset {
    align-self: flex-start;
    padding: 0.5rem 0.75rem;
    background: transparent;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xs);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-tertiary);
    cursor: pointer;
    transition: color 150ms var(--ease-out-soft),
      border-color 150ms var(--ease-out-soft);
  }
  .filter-reset:hover {
    color: var(--color-text-primary);
    border-color: var(--color-border);
  }

  .results-area {
    min-width: 0;
  }

  .card-grid {
    display: grid;
    gap: 0.875rem;
  }
  .card-grid-3 {
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .card-grid-3 {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1280px) {
    .card-grid-3 {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .empty-results {
    margin-top: 1rem;
  }
</style>
